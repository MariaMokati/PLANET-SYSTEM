//@version=6
// =============================================================================
// BASIC MARKET STRUCTURE — Sessions · Structure · Trendlines · Bias Dashboards
// -----------------------------------------------------------------------------
// Companion to "Basic CRT". Every block is independently switchable.
//
//   SESSIONS    Asia / London / NY AM / NY PM
//   STRUCTURE   Three tiers, each its own pivot length:
//                 EXTERNAL  HH / HL / LH / LL   (CAPITALS)
//                 internal  hh / hl / lh / ll   (lowercase)
//                 Fractal   F HH / F HL / …     (prefixed)
//               Small dash on every turning point, clean text-only labels,
//               BOS / CHoCH where the trend breaks or flips.
//   TF TAGS     A turning point that is ALSO a confirmed swing on a higher
//               timeframe gets that timeframe stamped on its label:
//               "HH ·1H ·4H" = the same point is a 1H swing and a 4H swing.
//   TRENDLINES  Last two confirmed swings — CURRENT WEEK ONLY.
//   DASHBOARDS  Two independent panels:
//                 1. Structure bias per timeframe, 1m → W
//                 2. Session / Daily / Weekly bias + overall trend
//               Both read CONFIRMED bars by default (no intra-bar repaint),
//               matching the Basic CRT trend filter exactly.
//
// All labels use style_none: text only, no bubbles, no background boxes.
// Non-repainting: swings are CONFIRMED pivots, placed `length` bars back.
// =============================================================================
indicator("Basic Market Structure", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ===================== SESSIONS ==============================================
gSes = "Sessions"
sesOn    = input.bool(true,  "Show sessions", group=gSes)
sesBox   = input.bool(true,  "Draw session box", group=gSes)
sesHL    = input.bool(false, "Keep session high / low lines after close", group=gSes)
sesLbl   = input.bool(true,  "Label sessions", group=gSes)
sesLblSz = input.string("Tiny", "Session label size", options=["Tiny","Small","Normal"], group=gSes)
sesKeep  = input.int(10, "Keep last N of each session", minval=1, maxval=60, group=gSes)
sesTz    = input.string("America/New_York", "Session timezone", group=gSes)
s1On  = input.bool(true, "Asia",   inline="s1", group=gSes)
s1Txt = input.session("2000-0000", "", inline="s1", group=gSes)
s1Col = input.color(color.new(#787B86, 90), "", inline="s1", group=gSes)
s2On  = input.bool(true, "London", inline="s2", group=gSes)
s2Txt = input.session("0200-0500", "", inline="s2", group=gSes)
s2Col = input.color(color.new(#2962FF, 90), "", inline="s2", group=gSes)
s3On  = input.bool(true, "NY AM",  inline="s3", group=gSes)
s3Txt = input.session("0700-1000", "", inline="s3", group=gSes)
s3Col = input.color(color.new(#089981, 90), "", inline="s3", group=gSes)
s4On  = input.bool(true, "NY PM",  inline="s4", group=gSes)
s4Txt = input.session("1300-1600", "", inline="s4", group=gSes)
s4Col = input.color(color.new(#FF6D00, 90), "", inline="s4", group=gSes)

// ===================== STRUCTURE — SHARED ====================================
gStr = "Structure — shared"
stPrice = input.bool(false, "Include price in labels", group=gStr)
stMark  = input.bool(true,  "Show turning-point dash", group=gStr)
stKeep  = input.int(30, "Keep last N swings per tier", minval=4, maxval=100, group=gStr)

// ---- EXTERNAL (CAPITALS) ----------------------------------------------------
gExt = "Structure — EXTERNAL (CAPITALS)"
extOn    = input.bool(true, "Show external structure", group=gExt)
extLen   = input.int(20, "Pivot length", minval=1, group=gExt, tooltip="Bars either side of the swing. Higher = only major turning points.")
extLblOn = input.bool(true, "Labels (HH / HL / LH / LL)", group=gExt)
extLeg   = input.bool(true, "Connecting legs", group=gExt)
extBos   = input.bool(true, "BOS / CHoCH", group=gExt, tooltip="BOS = trend continues. CHoCH = trend flipped — the turn.")
extUpC   = input.color(color.new(#089981, 0), "Bullish", inline="ec", group=gExt)
extDnC   = input.color(color.new(#F23645, 0), "Bearish", inline="ec", group=gExt)
extLblSz = input.string("Small", "Label size", options=["Tiny","Small","Normal"], group=gExt)
extW     = input.int(1, "Leg width", minval=1, maxval=4, group=gExt)
extStyle = input.string("Solid", "Leg style", options=["Solid","Dashed","Dotted"], group=gExt)
extFade  = input.int(55, "Leg transparency", minval=0, maxval=95, group=gExt)

// ---- INTERNAL (lowercase) ---------------------------------------------------
gInt = "Structure — internal (lowercase)"
intOn    = input.bool(true, "Show internal structure", group=gInt)
intLen   = input.int(5, "Pivot length", minval=1, group=gInt)
intLblOn = input.bool(true, "Labels (hh / hl / lh / ll)", group=gInt)
intLeg   = input.bool(false, "Connecting legs", group=gInt)
intBos   = input.bool(false, "bos / choch", group=gInt)
intUpC   = input.color(color.new(#5B9CF6, 0), "Bullish", inline="ic", group=gInt)
intDnC   = input.color(color.new(#E091AE, 0), "Bearish", inline="ic", group=gInt)
intLblSz = input.string("Tiny", "Label size", options=["Tiny","Small","Normal"], group=gInt)
intW     = input.int(1, "Leg width", minval=1, maxval=4, group=gInt)
intStyle = input.string("Dotted", "Leg style", options=["Solid","Dashed","Dotted"], group=gInt)
intFade  = input.int(65, "Leg transparency", minval=0, maxval=95, group=gInt)

// ---- FRACTAL (F prefix) -----------------------------------------------------
gFrc = "Structure — Fractal (F prefix)"
frcOn    = input.bool(false, "Show fractal structure", group=gFrc)
frcLen   = input.int(2, "Pivot length", minval=1, group=gFrc)
frcLblOn = input.bool(true, "Labels (F HH / F HL / …)", group=gFrc)
frcLeg   = input.bool(false, "Connecting legs", group=gFrc)
frcBos   = input.bool(false, "F BOS / F CHoCH", group=gFrc)
frcUpC   = input.color(color.new(#9C27B0, 0), "Bullish", inline="fc", group=gFrc)
frcDnC   = input.color(color.new(#FF9800, 0), "Bearish", inline="fc", group=gFrc)
frcLblSz = input.string("Tiny", "Label size", options=["Tiny","Small","Normal"], group=gFrc)
frcW     = input.int(1, "Leg width", minval=1, maxval=4, group=gFrc)
frcStyle = input.string("Dotted", "Leg style", options=["Solid","Dashed","Dotted"], group=gFrc)
frcFade  = input.int(70, "Leg transparency", minval=0, maxval=95, group=gFrc)

// ---- TIMEFRAME TAGS ---------------------------------------------------------
// Stamps every swing label whose turning point is ALSO a confirmed swing on a
// higher timeframe. "hh ·1H" = this internal swing is a 1H swing too.
// "HH ·1H ·4H" = the point is a swing on both. Works on all three tiers.
// Higher-timeframe pivots confirm LATER than chart-tier ones (tagLen bars of
// THAT timeframe later), so stamps are applied retroactively to the label the
// moment the higher timeframe confirms — the label text simply grows.
gTag = "Structure — timeframe tags"
tagOn   = input.bool(true, "Tag turning points with their timeframes", group=gTag, tooltip="Appends the timeframe to a swing label when the same point is a confirmed swing there. Tags attach to the swing labels, so the tier's labels must be on. Use timeframes AT or ABOVE your chart.")
tag15On = input.bool(false, "15m", inline="tg1", group=gTag)
tag30On = input.bool(false, "30m", inline="tg1", group=gTag)
tag1On  = input.bool(true,  "1H",  inline="tg1", group=gTag)
tag4On  = input.bool(true,  "4H",  inline="tg2", group=gTag)
tagDOn  = input.bool(false, "D",   inline="tg2", group=gTag)
tagWOn  = input.bool(false, "W",   inline="tg2", group=gTag)
tagLen  = input.int(3, "Higher-timeframe pivot length", minval=1, group=gTag, tooltip="Bars either side of the swing on each tagged timeframe. 1H with length 3 = the point is the extreme of a 7-hour window. Raise for stricter tags.")
tagTol  = input.int(2, "Price match tolerance (ticks)", minval=0, maxval=50, group=gTag, tooltip="How close in price the chart swing and the higher-timeframe swing must be to count as the same turning point.")

// ===================== TRENDLINES ============================================
gTl = "Trendlines"
tlOn   = input.bool(true, "Show trendlines", group=gTl)
tlWeek = input.bool(true, "Current week only", group=gTl, tooltip="Only draws when BOTH anchor swings formed this week. No historical lines — clears when the new week opens.")
tlSrc  = input.string("External", "Built from", options=["External","Internal","Fractal"], group=gTl)
tlExt  = input.int(20, "Extend right (bars)", minval=0, maxval=500, group=gTl)
tlUpC  = input.color(color.new(#089981, 0), "Support (rising lows)", group=gTl)
tlDnC  = input.color(color.new(#F23645, 0), "Resistance (falling highs)", group=gTl)
tlW    = input.int(1, "Width", minval=1, maxval=4, group=gTl)
tlStyle= input.string("Solid", "Style", options=["Solid","Dashed","Dotted"], group=gTl)
tlOnly = input.bool(true, "Only draw when sloping the right way", group=gTl, tooltip="Support needs RISING lows, resistance FALLING highs. Anything else is skipped.")

// ===================== DASHBOARD 1 — STRUCTURE BIAS ==========================
gDash = "Structure bias dashboard (top)"
dashOn   = input.bool(true, "Show structure dashboard", group=gDash)
dashPos  = input.string("Top right", "Position", options=["Top right","Top left","Bottom right","Bottom left","Middle right"], group=gDash)
dashSz   = input.string("Small", "Text size", options=["Tiny","Small","Normal"], group=gDash)
dashLen  = input.int(5, "Structure pivot length used per timeframe", minval=1, group=gDash)
dashConf = input.bool(true, "Confirmed bars only (no repaint)", group=gDash, tooltip="Read each timeframe's bias from its last CLOSED bar — the same reading the Basic CRT trend filter uses, so the two tools always agree. Off = include the forming bar, which can flip mid-candle.")
d1On  = input.bool(true,  "1m",  inline="d1", group=gDash)
d5On  = input.bool(true,  "5m",  inline="d1", group=gDash)
d15On = input.bool(true,  "15m", inline="d1", group=gDash)
d30On = input.bool(true,  "30m", inline="d2", group=gDash)
d60On = input.bool(true,  "1H",  inline="d2", group=gDash)
d240On= input.bool(true,  "4H",  inline="d2", group=gDash)
dDOn  = input.bool(true,  "D",   inline="d3", group=gDash)
dWOn  = input.bool(true,  "W",   inline="d3", group=gDash)
dBull = input.color(color.new(#089981, 0), "Bullish", inline="dc", group=gDash)
dBear = input.color(color.new(#F23645, 0), "Bearish", inline="dc", group=gDash)
dFlat = input.color(color.new(#787B86, 0), "Range",   inline="dc", group=gDash)

// ===================== DASHBOARD 2 — SESSION / DAILY / WEEKLY ================
// Its own panel so it can sit at the bottom while the structure table sits at
// the top. Every row individually switchable.
gDash2 = "Bias dashboard (bottom)"
dash2On  = input.bool(true, "Show bias dashboard", group=gDash2)
dash2Pos = input.string("Bottom right", "Position", options=["Top right","Top left","Bottom right","Bottom left","Middle right"], group=gDash2)
dash2Sz  = input.string("Small", "Text size", options=["Tiny","Small","Normal"], group=gDash2)
d2Ses    = input.bool(true, "Session row", group=gDash2, tooltip="Price vs the open of the session currently running. Shows — when no session is active.")
d2Day    = input.bool(true, "Daily row", group=gDash2, tooltip="Price vs today's open.")
d2Wk     = input.bool(true, "Weekly row", group=gDash2, tooltip="Price vs this week's open.")
d2Trd    = input.bool(true, "Overall trend row", group=gDash2, tooltip="Majority vote across every timeframe enabled in the structure dashboard: more bullish than bearish = BULLISH. Bias and trend are the same reading here — structure making higher highs and higher lows IS a bullish trend.")
d2Chart  = input.bool(true, "Chart structure row", group=gDash2, tooltip="The external tier's trend on THIS chart. Shows — when external structure is switched off.")

// ===================== HELPERS ===============================================
f_sz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small
f_ls(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
f_pos(string s) =>
    s == "Top left" ? position.top_left : s == "Bottom right" ? position.bottom_right : s == "Bottom left" ? position.bottom_left : s == "Middle right" ? position.middle_right : position.top_right
TRANSP = color.new(color.gray, 100)
sym = syminfo.tickerid
// small vertical offset so text sits just clear of the wick
off = ta.atr(14) * 0.30
wkStart = time("W")

// ===================== STRUCTURE ENGINE ======================================
// Per-tier state, slot 0 = fractal, 1 = internal, 2 = external.
var array<float> stPrevH = array.new<float>(3, na)
var array<float> stPrevL = array.new<float>(3, na)
var array<float> stPH    = array.new<float>(3, na)
var array<float> stPL    = array.new<float>(3, na)
var array<int>   stPHbar = array.new<int>(3, na)
var array<int>   stPLbar = array.new<int>(3, na)
var array<float> stPvY   = array.new<float>(3, na)
var array<int>   stPvX   = array.new<int>(3, na)
var array<int>   stTrend = array.new<int>(3, 0)
var array<bool>  stBrkH  = array.new<bool>(3, false)
var array<bool>  stBrkL  = array.new<bool>(3, false)
// trendline anchors: last two highs / lows per tier, with formation time
var array<float> tlH1  = array.new<float>(3, na)
var array<float> tlH2  = array.new<float>(3, na)
var array<int>   tlH1x = array.new<int>(3, na)
var array<int>   tlH2x = array.new<int>(3, na)
var array<int>   tlH1t = array.new<int>(3, na)
var array<int>   tlH2t = array.new<int>(3, na)
var array<float> tlL1  = array.new<float>(3, na)
var array<float> tlL2  = array.new<float>(3, na)
var array<int>   tlL1x = array.new<int>(3, na)
var array<int>   tlL2x = array.new<int>(3, na)
var array<int>   tlL1t = array.new<int>(3, na)
var array<int>   tlL2t = array.new<int>(3, na)

var array<label> dLbl0 = array.new<label>()
var array<label> dLbl1 = array.new<label>()
var array<label> dLbl2 = array.new<label>()
var array<line>  dLeg0 = array.new<line>()
var array<line>  dLeg1 = array.new<line>()
var array<line>  dLeg2 = array.new<line>()

f_pushLbl(int tier, label lb) =>
    a = tier == 0 ? dLbl0 : tier == 1 ? dLbl1 : dLbl2
    array.push(a, lb)
    while array.size(a) > stKeep * 2
        label.delete(array.shift(a))
f_pushLeg(int tier, line ln) =>
    a = tier == 0 ? dLeg0 : tier == 1 ? dLeg1 : dLeg2
    array.push(a, ln)
    while array.size(a) > stKeep * 2
        line.delete(array.shift(a))

// ---- timeframe-tag machinery ------------------------------------------------
// Registry of every labelled swing, so a higher-timeframe pivot that confirms
// LATER can still stamp it. regMk is a bitmask of which timeframes already
// stamped that swing, so no label is ever stamped twice by the same timeframe.
var array<label> regLb = array.new<label>()
var array<float> regY  = array.new<float>()
var array<int>   regT  = array.new<int>()
var array<bool>  regHi = array.new<bool>()
var array<int>   regMk = array.new<int>()
// recent higher-timeframe pivots: price, candle open time, side, slot, duration
var array<float> hpP  = array.new<float>()
var array<int>   hpT  = array.new<int>()
var array<bool>  hpHi = array.new<bool>()
var array<int>   hpTf = array.new<int>()
var array<int>   hpMs = array.new<int>()
// dedupe: last processed pivot-candle time per (timeframe slot x side)
var array<int> lastTagT = array.new<int>(12, 0)

f_tagName(int s) =>
    s == 0 ? "15m" : s == 1 ? "30m" : s == 2 ? "1H" : s == 3 ? "4H" : s == 4 ? "D" : "W"

// One swing vs one higher-timeframe pivot: same side, same price within
// tolerance, and the swing bar sits inside the pivot candle's time span.
f_stamp(int ri, int pi) =>
    if array.get(regHi, ri) == array.get(hpHi, pi)
        pt = array.get(hpT, pi)
        okT = array.get(regT, ri) >= pt and array.get(regT, ri) < pt + array.get(hpMs, pi)
        if okT and math.abs(array.get(regY, ri) - array.get(hpP, pi)) <= tagTol * syminfo.mintick
            slot = array.get(hpTf, pi)
            bit = slot == 0 ? 1 : slot == 1 ? 2 : slot == 2 ? 4 : slot == 3 ? 8 : slot == 4 ? 16 : 32
            mk = array.get(regMk, ri)
            // Pine has no bitwise ops: int(mk / bit) % 2 tests the bit
            if int(mk / bit) % 2 == 0
                array.set(regMk, ri, mk + bit)
                lb = array.get(regLb, ri)
                if not na(lb)
                    label.set_text(lb, label.get_text(lb) + " ·" + f_tagName(slot))

// A higher-timeframe pivot (high and/or low) just confirmed: store it, then try
// to stamp every registered swing. pivothigh through request.security repeats
// its value for every chart bar inside the HTF bar, so arrivals are deduped on
// the pivot candle's own open time.
f_tagPivot(int slot, float hp, float lp, float pt0, int ms) =>
    if not na(pt0)
        pt = int(pt0)
        if not na(hp) and pt != array.get(lastTagT, slot * 2)
            array.set(lastTagT, slot * 2, pt)
            array.push(hpP, hp)
            array.push(hpT, pt)
            array.push(hpHi, true)
            array.push(hpTf, slot)
            array.push(hpMs, ms)
            if array.size(regLb) > 0
                pi = array.size(hpP) - 1
                for ri = 0 to array.size(regLb) - 1
                    f_stamp(ri, pi)
        if not na(lp) and pt != array.get(lastTagT, slot * 2 + 1)
            array.set(lastTagT, slot * 2 + 1, pt)
            array.push(hpP, lp)
            array.push(hpT, pt)
            array.push(hpHi, false)
            array.push(hpTf, slot)
            array.push(hpMs, ms)
            if array.size(regLb) > 0
                pi = array.size(hpP) - 1
                for ri = 0 to array.size(regLb) - 1
                    f_stamp(ri, pi)
        while array.size(hpP) > 60
            array.shift(hpP)
            array.shift(hpT)
            array.shift(hpHi)
            array.shift(hpTf)
            array.shift(hpMs)

// One confirmed swing: dash marker + text-only label + optional leg, then roll
// state forward so the NEXT swing classifies against this one.
f_swing(int tier, bool isHigh, float y, int x, int t, bool lblOn, bool legOn, color cUp, color cDn, string lblSz, int wid, string sty, int fade) =>
    float prev = isHigh ? array.get(stPrevH, tier) : array.get(stPrevL, tier)
    // 0 = first swing of the tier (nothing to compare), 1 = higher, -1 = lower
    int cls = na(prev) ? 0 : y > prev ? 1 : -1
    // higher high / higher low are bullish; lower high / lower low bearish
    color col = cls == 0 ? color.new(color.gray, 30) : cls == 1 ? cUp : cDn
    if legOn and not na(array.get(stPvX, tier))
        ln = line.new(array.get(stPvX, tier), array.get(stPvY, tier), x, y, color=color.new(col, fade), width=wid, style=f_ls(sty))
        f_pushLeg(tier, ln)
    if stMark
        mk = label.new(x, y, "–", style=label.style_none, textcolor=col, size=size.tiny)
        f_pushLbl(tier, mk)
    if lblOn and cls != 0
        string core = isHigh ? (cls == 1 ? "HH" : "LH") : (cls == 1 ? "HL" : "LL")
        string txt = tier == 0 ? "F " + core : tier == 1 ? str.lower(core) : core
        if stPrice
            txt := txt + " " + str.tostring(y, format.mintick)
        lb = label.new(x, isHigh ? y + off : y - off, txt, style=label.style_none, textcolor=col, size=f_sz(lblSz))
        f_pushLbl(tier, lb)
        // register for timeframe tagging: stamp now from higher-timeframe pivots
        // that already confirmed, stay registered for ones that confirm later
        if tagOn
            array.push(regLb, lb)
            array.push(regY, y)
            array.push(regT, t)
            array.push(regHi, isHigh)
            array.push(regMk, 0)
            if array.size(hpP) > 0
                ri = array.size(regLb) - 1
                for pi = 0 to array.size(hpP) - 1
                    f_stamp(ri, pi)
            while array.size(regLb) > stKeep * 3
                array.shift(regLb)
                array.shift(regY)
                array.shift(regT)
                array.shift(regHi)
                array.shift(regMk)
    if isHigh
        array.set(stPrevH, tier, y)
        array.set(stPH, tier, y)
        array.set(stPHbar, tier, x)
        array.set(stBrkH, tier, false)
        array.set(tlH2, tier, array.get(tlH1, tier))
        array.set(tlH2x, tier, array.get(tlH1x, tier))
        array.set(tlH2t, tier, array.get(tlH1t, tier))
        array.set(tlH1, tier, y)
        array.set(tlH1x, tier, x)
        array.set(tlH1t, tier, t)
    else
        array.set(stPrevL, tier, y)
        array.set(stPL, tier, y)
        array.set(stPLbar, tier, x)
        array.set(stBrkL, tier, false)
        array.set(tlL2, tier, array.get(tlL1, tier))
        array.set(tlL2x, tier, array.get(tlL1x, tier))
        array.set(tlL2t, tier, array.get(tlL1t, tier))
        array.set(tlL1, tier, y)
        array.set(tlL1x, tier, x)
        array.set(tlL1t, tier, t)
    array.set(stPvY, tier, y)
    array.set(stPvX, tier, x)

// BOS = close beyond the last swing WITH the trend. CHoCH = against it (flip).
f_break(int tier, bool en, color cUp, color cDn, string lblSz) =>
    lvlH = array.get(stPH, tier)
    lvlL = array.get(stPL, tier)
    if not na(lvlH) and close > lvlH and not array.get(stBrkH, tier)
        array.set(stBrkH, tier, true)
        was = array.get(stTrend, tier)
        array.set(stTrend, tier, 1)
        if en
            string tg = was == -1 ? "CHoCH" : "BOS"
            tg := tier == 0 ? "F " + tg : tier == 1 ? str.lower(tg) : tg
            ln = line.new(array.get(stPHbar, tier), lvlH, bar_index, lvlH, color=color.new(cUp, 40), width=1, style=line.style_dashed)
            f_pushLeg(tier, ln)
            lb = label.new(bar_index, lvlH + off, tg, style=label.style_none, textcolor=cUp, size=f_sz(lblSz))
            f_pushLbl(tier, lb)
    if not na(lvlL) and close < lvlL and not array.get(stBrkL, tier)
        array.set(stBrkL, tier, true)
        was = array.get(stTrend, tier)
        array.set(stTrend, tier, -1)
        if en
            string tg = was == 1 ? "CHoCH" : "BOS"
            tg := tier == 0 ? "F " + tg : tier == 1 ? str.lower(tg) : tg
            ln = line.new(array.get(stPLbar, tier), lvlL, bar_index, lvlL, color=color.new(cDn, 40), width=1, style=line.style_dashed)
            f_pushLeg(tier, ln)
            lb = label.new(bar_index, lvlL - off, tg, style=label.style_none, textcolor=cDn, size=f_sz(lblSz))
            f_pushLbl(tier, lb)

phF = ta.pivothigh(frcLen, frcLen)
plF = ta.pivotlow(frcLen, frcLen)
phI = ta.pivothigh(intLen, intLen)
plI = ta.pivotlow(intLen, intLen)
phE = ta.pivothigh(extLen, extLen)
plE = ta.pivotlow(extLen, extLen)

if frcOn and not na(phF)
    f_swing(0, true,  phF, bar_index - frcLen, time[frcLen], frcLblOn, frcLeg, frcUpC, frcDnC, frcLblSz, frcW, frcStyle, frcFade)
if frcOn and not na(plF)
    f_swing(0, false, plF, bar_index - frcLen, time[frcLen], frcLblOn, frcLeg, frcUpC, frcDnC, frcLblSz, frcW, frcStyle, frcFade)
if intOn and not na(phI)
    f_swing(1, true,  phI, bar_index - intLen, time[intLen], intLblOn, intLeg, intUpC, intDnC, intLblSz, intW, intStyle, intFade)
if intOn and not na(plI)
    f_swing(1, false, plI, bar_index - intLen, time[intLen], intLblOn, intLeg, intUpC, intDnC, intLblSz, intW, intStyle, intFade)
if extOn and not na(phE)
    f_swing(2, true,  phE, bar_index - extLen, time[extLen], extLblOn, extLeg, extUpC, extDnC, extLblSz, extW, extStyle, extFade)
if extOn and not na(plE)
    f_swing(2, false, plE, bar_index - extLen, time[extLen], extLblOn, extLeg, extUpC, extDnC, extLblSz, extW, extStyle, extFade)

if frcOn
    f_break(0, frcBos, frcUpC, frcDnC, frcLblSz)
if intOn
    f_break(1, intBos, intUpC, intDnC, intLblSz)
if extOn
    f_break(2, extBos, extUpC, extDnC, extLblSz)

// ---- higher-timeframe pivot feeds for the tags ------------------------------
// One request per enabled timeframe, gated so disabled ones cost nothing.
if tagOn and tag15On
    [hp, lp, pt] = request.security(sym, "15",  [ta.pivothigh(tagLen, tagLen), ta.pivotlow(tagLen, tagLen), time[tagLen]], lookahead=barmerge.lookahead_off)
    f_tagPivot(0, hp, lp, pt, 900000)
if tagOn and tag30On
    [hp, lp, pt] = request.security(sym, "30",  [ta.pivothigh(tagLen, tagLen), ta.pivotlow(tagLen, tagLen), time[tagLen]], lookahead=barmerge.lookahead_off)
    f_tagPivot(1, hp, lp, pt, 1800000)
if tagOn and tag1On
    [hp, lp, pt] = request.security(sym, "60",  [ta.pivothigh(tagLen, tagLen), ta.pivotlow(tagLen, tagLen), time[tagLen]], lookahead=barmerge.lookahead_off)
    f_tagPivot(2, hp, lp, pt, 3600000)
if tagOn and tag4On
    [hp, lp, pt] = request.security(sym, "240", [ta.pivothigh(tagLen, tagLen), ta.pivotlow(tagLen, tagLen), time[tagLen]], lookahead=barmerge.lookahead_off)
    f_tagPivot(3, hp, lp, pt, 14400000)
if tagOn and tagDOn
    [hp, lp, pt] = request.security(sym, "1D",  [ta.pivothigh(tagLen, tagLen), ta.pivotlow(tagLen, tagLen), time[tagLen]], lookahead=barmerge.lookahead_off)
    f_tagPivot(4, hp, lp, pt, 86400000)
if tagOn and tagWOn
    [hp, lp, pt] = request.security(sym, "1W",  [ta.pivothigh(tagLen, tagLen), ta.pivotlow(tagLen, tagLen), time[tagLen]], lookahead=barmerge.lookahead_off)
    f_tagPivot(5, hp, lp, pt, 604800000)

// ===================== TRENDLINES — current week only ========================
tlTier = tlSrc == "Internal" ? 1 : tlSrc == "Fractal" ? 0 : 2
var line tlUp = na
var line tlDn = na
h1 = array.get(tlH1, tlTier)
h2 = array.get(tlH2, tlTier)
h1x = array.get(tlH1x, tlTier)
h2x = array.get(tlH2x, tlTier)
h1t = array.get(tlH1t, tlTier)
h2t = array.get(tlH2t, tlTier)
thisWkH = not na(h1t) and not na(h2t) and h1t >= wkStart and h2t >= wkStart
okDn = tlOn and not na(h1) and not na(h2) and h1x != h2x and (not tlWeek or thisWkH) and (not tlOnly or h1 < h2)
if not na(tlDn)
    line.delete(tlDn)
    tlDn := na
if okDn
    sH = (h1 - h2) / (h1x - h2x)
    tlDn := line.new(h2x, h2, bar_index + tlExt, h1 + sH * (bar_index + tlExt - h1x), color=tlDnC, width=tlW, style=f_ls(tlStyle))
l1 = array.get(tlL1, tlTier)
l2 = array.get(tlL2, tlTier)
l1x = array.get(tlL1x, tlTier)
l2x = array.get(tlL2x, tlTier)
l1t = array.get(tlL1t, tlTier)
l2t = array.get(tlL2t, tlTier)
thisWkL = not na(l1t) and not na(l2t) and l1t >= wkStart and l2t >= wkStart
okUp = tlOn and not na(l1) and not na(l2) and l1x != l2x and (not tlWeek or thisWkL) and (not tlOnly or l1 > l2)
if not na(tlUp)
    line.delete(tlUp)
    tlUp := na
if okUp
    sL = (l1 - l2) / (l1x - l2x)
    tlUp := line.new(l2x, l2, bar_index + tlExt, l1 + sL * (bar_index + tlExt - l1x), color=tlUpC, width=tlW, style=f_ls(tlStyle))

// ===================== SESSIONS ==============================================
var array<box>   sBoxA = array.new<box>()
var array<label> sLabA = array.new<label>()
var array<line>  sLinA = array.new<line>()
var array<bool>  sIn  = array.new<bool>(4, false)
var array<float> sHi  = array.new<float>(4, na)
var array<float> sLo  = array.new<float>(4, na)
var array<int>   sSt  = array.new<int>(4, na)
var array<box>   sCur = array.new<box>(4, na)

// evaluated at global scope so time() runs on every bar
in1 = sesOn and s1On and not na(time(timeframe.period, s1Txt, sesTz))
in2 = sesOn and s2On and not na(time(timeframe.period, s2Txt, sesTz))
in3 = sesOn and s3On and not na(time(timeframe.period, s3Txt, sesTz))
in4 = sesOn and s4On and not na(time(timeframe.period, s4Txt, sesTz))

f_ses(int i, bool inSes, color col, string name) =>
    wasIn = array.get(sIn, i)
    if inSes and not wasIn
        array.set(sHi, i, high)
        array.set(sLo, i, low)
        array.set(sSt, i, bar_index)
        b = sesBox ? box.new(bar_index, high, bar_index, low, border_color=TRANSP, bgcolor=col) : na
        array.set(sCur, i, b)
        if not na(b)
            array.push(sBoxA, b)
        if sesLbl
            lb = label.new(bar_index, high, name, style=label.style_none, textcolor=color.new(col, 0), size=f_sz(sesLblSz))
            array.push(sLabA, lb)
    else if inSes
        array.set(sHi, i, math.max(nz(array.get(sHi, i), high), high))
        array.set(sLo, i, math.min(nz(array.get(sLo, i), low), low))
    if inSes
        bx = array.get(sCur, i)
        if not na(bx)
            box.set_top(bx, array.get(sHi, i))
            box.set_bottom(bx, array.get(sLo, i))
            box.set_right(bx, bar_index)
    if not inSes and wasIn
        if sesHL
            hv = array.get(sHi, i)
            lv = array.get(sLo, i)
            st = array.get(sSt, i)
            if not na(hv) and not na(lv) and not na(st)
                array.push(sLinA, line.new(st, hv, bar_index, hv, color=color.new(col, 20), width=1, style=line.style_dotted))
                array.push(sLinA, line.new(st, lv, bar_index, lv, color=color.new(col, 20), width=1, style=line.style_dotted))
        array.set(sCur, i, na)
    array.set(sIn, i, inSes)
    while array.size(sBoxA) > sesKeep * 4
        box.delete(array.shift(sBoxA))
    while array.size(sLabA) > sesKeep * 4
        label.delete(array.shift(sLabA))
    while array.size(sLinA) > sesKeep * 8
        line.delete(array.shift(sLinA))

f_ses(0, in1, s1Col, "Asia")
f_ses(1, in2, s2Col, "London")
f_ses(2, in3, s3Col, "NY AM")
f_ses(3, in4, s4Col, "NY PM")

// ===================== DASHBOARDS ============================================
f_tfBias(int L) =>
    ph = ta.pivothigh(L, L)
    pl = ta.pivotlow(L, L)
    var float lph = na
    var float lpl = na
    var int t = 0
    if not na(ph)
        lph := ph
    if not na(pl)
        lpl := pl
    if not na(lph) and close > lph
        t := 1
    if not na(lpl) and close < lpl
        t := -1
    t

// Confirmed-bars wrapper: with dashConf on, every timeframe's bias is read from
// its last CLOSED bar — the identical reading the Basic CRT trend filter uses,
// so the dashboard and the filter can never disagree mid-candle.
f_tfBiasC(int L) =>
    t = f_tfBias(L)
    dashConf ? t[1] : t

// the bias fetches feed BOTH dashboards (structure rows + overall-trend row)
biasNeed = dashOn or (dash2On and d2Trd)
int b1 = 0
int b5 = 0
int b15 = 0
int b30 = 0
int b60 = 0
int b240 = 0
int bD = 0
int bW = 0
if biasNeed and d1On
    b1 := request.security(sym, "1", f_tfBiasC(dashLen), lookahead=barmerge.lookahead_off)
if biasNeed and d5On
    b5 := request.security(sym, "5", f_tfBiasC(dashLen), lookahead=barmerge.lookahead_off)
if biasNeed and d15On
    b15 := request.security(sym, "15", f_tfBiasC(dashLen), lookahead=barmerge.lookahead_off)
if biasNeed and d30On
    b30 := request.security(sym, "30", f_tfBiasC(dashLen), lookahead=barmerge.lookahead_off)
if biasNeed and d60On
    b60 := request.security(sym, "60", f_tfBiasC(dashLen), lookahead=barmerge.lookahead_off)
if biasNeed and d240On
    b240 := request.security(sym, "240", f_tfBiasC(dashLen), lookahead=barmerge.lookahead_off)
if biasNeed and dDOn
    bD := request.security(sym, "1D", f_tfBiasC(dashLen), lookahead=barmerge.lookahead_off)
if biasNeed and dWOn
    bW := request.security(sym, "1W", f_tfBiasC(dashLen), lookahead=barmerge.lookahead_off)

dOpen = request.security(sym, "1D", open, lookahead=barmerge.lookahead_off)
wOpen = request.security(sym, "1W", open, lookahead=barmerge.lookahead_off)
var float sesOpen = na
anySes = in1 or in2 or in3 or in4
if anySes and not anySes[1]
    sesOpen := open
if not anySes
    sesOpen := na

f_word(int b) =>
    b == 1 ? "BULLISH" : b == -1 ? "BEARISH" : "RANGE"
f_col(int b) =>
    b == 1 ? dBull : b == -1 ? dBear : dFlat

// ---- Dashboard 1: structure bias per timeframe ------------------------------
var table dash = na
if dashOn and barstate.islast
    if na(dash)
        dash := table.new(f_pos(dashPos), 2, 9, border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))
    table.clear(dash, 0, 0, 1, 8)
    bgh = color.new(color.gray, 85)
    bgc = color.new(color.gray, 92)
    table.cell(dash, 0, 0, "BIAS", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgh)
    table.cell(dash, 1, 0, "STRUCTURE", text_size=f_sz(dashSz), text_halign=text.align_right, text_color=color.gray, bgcolor=bgh)
    r = 1
    if dWOn
        table.cell(dash, 0, r, "W", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgc)
        table.cell(dash, 1, r, f_word(bW), text_size=f_sz(dashSz), text_halign=text.align_right, text_color=f_col(bW), bgcolor=bgc)
        r += 1
    if dDOn
        table.cell(dash, 0, r, "D", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgc)
        table.cell(dash, 1, r, f_word(bD), text_size=f_sz(dashSz), text_halign=text.align_right, text_color=f_col(bD), bgcolor=bgc)
        r += 1
    if d240On
        table.cell(dash, 0, r, "4H", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgc)
        table.cell(dash, 1, r, f_word(b240), text_size=f_sz(dashSz), text_halign=text.align_right, text_color=f_col(b240), bgcolor=bgc)
        r += 1
    if d60On
        table.cell(dash, 0, r, "1H", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgc)
        table.cell(dash, 1, r, f_word(b60), text_size=f_sz(dashSz), text_halign=text.align_right, text_color=f_col(b60), bgcolor=bgc)
        r += 1
    if d30On
        table.cell(dash, 0, r, "30m", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgc)
        table.cell(dash, 1, r, f_word(b30), text_size=f_sz(dashSz), text_halign=text.align_right, text_color=f_col(b30), bgcolor=bgc)
        r += 1
    if d15On
        table.cell(dash, 0, r, "15m", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgc)
        table.cell(dash, 1, r, f_word(b15), text_size=f_sz(dashSz), text_halign=text.align_right, text_color=f_col(b15), bgcolor=bgc)
        r += 1
    if d5On
        table.cell(dash, 0, r, "5m", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgc)
        table.cell(dash, 1, r, f_word(b5), text_size=f_sz(dashSz), text_halign=text.align_right, text_color=f_col(b5), bgcolor=bgc)
        r += 1
    if d1On
        table.cell(dash, 0, r, "1m", text_size=f_sz(dashSz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgc)
        table.cell(dash, 1, r, f_word(b1), text_size=f_sz(dashSz), text_halign=text.align_right, text_color=f_col(b1), bgcolor=bgc)
        r += 1

// ---- Dashboard 2: session / daily / weekly + overall trend ------------------
var table dash2 = na
if dash2On and barstate.islast
    if na(dash2)
        dash2 := table.new(f_pos(dash2Pos), 2, 6, border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))
    table.clear(dash2, 0, 0, 1, 5)
    bgh2 = color.new(color.gray, 85)
    table.cell(dash2, 0, 0, "BIAS", text_size=f_sz(dash2Sz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgh2)
    table.cell(dash2, 1, 0, "STATE", text_size=f_sz(dash2Sz), text_halign=text.align_right, text_color=color.gray, bgcolor=bgh2)
    r2 = 1
    if d2Ses
        sB = na(sesOpen) ? 0 : close > sesOpen ? 1 : close < sesOpen ? -1 : 0
        table.cell(dash2, 0, r2, "Session", text_size=f_sz(dash2Sz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgh2)
        table.cell(dash2, 1, r2, na(sesOpen) ? "—" : f_word(sB), text_size=f_sz(dash2Sz), text_halign=text.align_right, text_color=na(sesOpen) ? dFlat : f_col(sB), bgcolor=bgh2)
        r2 += 1
    if d2Day
        dB = na(dOpen) ? 0 : close > dOpen ? 1 : close < dOpen ? -1 : 0
        table.cell(dash2, 0, r2, "Daily", text_size=f_sz(dash2Sz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgh2)
        table.cell(dash2, 1, r2, f_word(dB), text_size=f_sz(dash2Sz), text_halign=text.align_right, text_color=f_col(dB), bgcolor=bgh2)
        r2 += 1
    if d2Wk
        wB = na(wOpen) ? 0 : close > wOpen ? 1 : close < wOpen ? -1 : 0
        table.cell(dash2, 0, r2, "Weekly", text_size=f_sz(dash2Sz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgh2)
        table.cell(dash2, 1, r2, f_word(wB), text_size=f_sz(dash2Sz), text_halign=text.align_right, text_color=f_col(wB), bgcolor=bgh2)
        r2 += 1
    if d2Trd
        // majority vote across every timeframe enabled in the structure table
        tBu = (d1On and b1 == 1 ? 1 : 0) + (d5On and b5 == 1 ? 1 : 0) + (d15On and b15 == 1 ? 1 : 0) + (d30On and b30 == 1 ? 1 : 0) + (d60On and b60 == 1 ? 1 : 0) + (d240On and b240 == 1 ? 1 : 0) + (dDOn and bD == 1 ? 1 : 0) + (dWOn and bW == 1 ? 1 : 0)
        tBe = (d1On and b1 == -1 ? 1 : 0) + (d5On and b5 == -1 ? 1 : 0) + (d15On and b15 == -1 ? 1 : 0) + (d30On and b30 == -1 ? 1 : 0) + (d60On and b60 == -1 ? 1 : 0) + (d240On and b240 == -1 ? 1 : 0) + (dDOn and bD == -1 ? 1 : 0) + (dWOn and bW == -1 ? 1 : 0)
        oT = tBu > tBe ? 1 : tBe > tBu ? -1 : 0
        table.cell(dash2, 0, r2, "Overall trend", text_size=f_sz(dash2Sz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgh2)
        table.cell(dash2, 1, r2, f_word(oT), text_size=f_sz(dash2Sz), text_halign=text.align_right, text_color=f_col(oT), bgcolor=bgh2)
        r2 += 1
    if d2Chart
        eB = array.get(stTrend, 2)
        table.cell(dash2, 0, r2, "Chart structure", text_size=f_sz(dash2Sz), text_halign=text.align_left, text_color=color.gray, bgcolor=bgh2)
        table.cell(dash2, 1, r2, extOn ? f_word(eB) : "—", text_size=f_sz(dash2Sz), text_halign=text.align_right, text_color=extOn ? f_col(eB) : dFlat, bgcolor=bgh2)
