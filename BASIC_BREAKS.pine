//@version=6
// =============================================================================
// BASIC BREAKS  —  1st / 2nd / 3rd break of the impulse's structure
// -----------------------------------------------------------------------------
// THE MODEL
//   EVERY turning point is a level. A confirmed pivot low goes on the HL stack
//   (the "history hl for sell set ups"), a confirmed pivot high on the LH stack.
//
//   When the move comes back, it takes them in REVERSE ORDER OF CREATION:
//
//       the LAST turning point made        →  1st Break
//       the SECOND-LAST one made           →  2nd Break
//       the THIRD-LAST one made            →  3rd Break
//
//   A level leaves the stack for exactly one reason: PRICE BROKE IT. Nothing
//   else deletes it and nothing else skips it. Skipping a turning point is what
//   put gaps in the sequence — a level price later broke was never in the
//   stack, so every number after it shifted down one and a genuine 2nd printed
//   as a 3rd.
//
//   A SEQUENCE numbers the turning points of the leg IMMEDIATELY BEFORE the
//   move — a rally numbers what the decline left behind. Because levels are
//   eaten newest-first, that has an exact form: every level in a sequence must
//   be OLDER than the one before it. The moment a break takes a level NEWER
//   than the last one numbered, the move is taking out structure it built
//   itself, which is a different leg, so the count restarts at 1st.
//
//   The count is uncapped: 4th, 5th, 8th are all legitimate if the leg really
//   left that many levels behind.
//
// Non-repainting: pivots are CONFIRMED (placed `length` bars back) and a break
// is judged once at bar close. A wick through that closes back inside is a
// fake-out and breaks nothing.
//
// HONESTY: an annotation tool. It marks what happened, nothing more.
// =============================================================================
indicator("Basic Breaks", "BREAKS", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ===================== STRUCTURE =============================================
gSt = "Structure"
pvLen = input.int(1, "Swing length  —  1 = EVERY turning point, no matter how small", minval = 1, group = gSt, tooltip = "Bars that must be clear either side of a turning point.\n\n1 (default) — every turning point counts, however small. A two-bar bounce inside a decline is a level.\n\nAnything higher THROWS SMALL TURNING POINTS AWAY. At 5, a bounce needs five bars clear on each side to exist at all, so small ones are never levels and never get numbered — which is why they were missing from the chart entirely.")
allTurns = input.bool(true, "Mark EVERY turning point", group = gSt, tooltip = "On (default): every confirmed pivot becomes a level, so nothing price can break is missing from the sequence.\n\nOff: only pivots that extend the structure (a higher low, a lower high) become levels. That is what left gaps — a turning point price later broke was never a level, so every number after it shifted down one.")
minLv = input.int(2, "A stack counts once it has N levels", minval = 1, maxval = 10, group = gSt, tooltip = "A single stray pivot is not a sequence. Requiring 2 means at least two levels must exist before breaks are numbered. Set to 1 to number everything.")
sellOn = input.bool(true, "Track LOWS  (broken downward → sell setups)", group = gSt)
buyOn = input.bool(true, "Track HIGHS  (broken upward → buy setups)", group = gSt)

// ===================== BREAK CONFIRMATION ====================================
gCf = "Break confirmation"
confMode = input.string("Close beyond", "What breaks a level", options = ["Wick beyond", "Close beyond", "Full body beyond"], group = gCf, tooltip = "Close beyond (default) — the candle must FINISH past the level. A wick through that closes back inside is a fake-out and breaks nothing.\nFull body beyond — open AND close both clear. Stricter.\nWick beyond — any touch counts, fake-outs included.")
waitClose = input.bool(true, "Only judge closed bars", group = gCf, tooltip = "On (default): a break is decided at the close of the candle and never redrawn. This is what makes the entry signal fire in real time on that close.")

// ===================== THE LIVE STACK ========================================
gLs = "The live stack"
stackShow = input.bool(false, "Show the levels still standing", group = gLs, tooltip = "OFF by default. Draws a dotted line for every turning point nothing has broken yet, numbered outward from price — 1 is the next one that breaks, and it is the one that will be labelled 1st Break.\n\nAt swing length 1 there can be fifty of these standing at once, which is unreadable. It is a preview of the numbering, not part of it: turning it off changes nothing about the break marks or the dashboard.")
stackHLC = input.color(color.new(#089981, 40), "Lows", inline = "sc", group = gLs)
stackLHC = input.color(color.new(#F23645, 40), "Highs", inline = "sc", group = gLs)
stackTag = input.bool(false, "Number them from the top", group = gLs, tooltip = "Labels the standing levels 1 · 2 · 3 from the top down, so you can see in advance which will be the 1st, 2nd and 3rd break.")
stackMax = input.int(50, "Track at most N levels per stack", minval = 2, maxval = 300, group = gLs, tooltip = "When the stack is full the OLDEST level is dropped — and in a decline the oldest is the HIGHEST, the one furthest from price. Set this too low and the level a big move eventually reaches has already been thrown away. 50 by default; raise it if a deep move stops being numbered part-way.")

// ===================== VISUALS ===============================================
gVs = "Visuals"
hidePast = input.bool(true, "Only draw the first N breaks", group = gVs, tooltip = "ON by default: only the 1st, 2nd and 3rd are drawn.\n\nThe count always keeps running underneath — a 4th, 5th or 6th break still happens, still fires the alert and still shows in the dashboard. This only stops them being DRAWN, so the chart stays on the three that matter.\n\nTurn it off to put every break in the sequence on the chart.")
hidePastN = input.int(3, "…how many", minval = 1, maxval = 20, group = gVs)
histBars = input.int(300, "Only show breaks from the last N bars  (0 = all history)", minval = 0, maxval = 5000, group = gVs, tooltip = "THIS is the control for clutter. Everything inside the window is numbered and drawn; everything older is cleared off the chart.\n\n300 by default. Raise it to annotate further back, lower it to keep the chart to what you are actually looking at. 0 keeps the whole history, which at swing length 1 will hit TradingView's 500-drawing ceiling and start losing the oldest marks.")
cN1 = input.color(color.new(#5B9CF6, 0), "1st", inline = "cn", group = gVs)
cN2 = input.color(color.new(#2962FF, 0), "2nd", inline = "cn", group = gVs)
cN3 = input.color(color.new(#089981, 0), "3rd", inline = "cn", group = gVs)
cNx = input.color(color.new(#787B86, 0), "4th+", inline = "cn", group = gVs)
lineOn = input.bool(true, "Draw the broken level as a line", group = gVs, tooltip = "From where the turning point formed across to the candle that broke it.")
lineW = input.int(1, "Line width", minval = 1, maxval = 4, group = gVs)
lineStyleIn = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = gVs)
lblOn = input.bool(true, "Label the break", group = gVs)
lblFmt = input.string("1st Break", "Label text", options = ["1st Break", "1st", "1st Break + price", "1"], group = gVs)
lblPos = input.string("Centre", "Label sits", options = ["Left", "Centre", "Right"], group = gVs)
lblOff = input.float(0.25, "Label offset (× ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = gVs)
lblSzIn = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal", "Large"], group = gVs)

// ===================== ENTRY =================================================
gEn = "Entry"
entOn = input.bool(false, "Mark an entry on the Nth break", group = gEn, tooltip = "A marker on the candle you enter plus an \"E: Long\" / \"E: Short\" label. Fires the moment the candle that makes the Nth break CLOSES.")
entAt = input.int(2, "…on which break", minval = 1, maxval = 20, group = gEn, tooltip = "2 by default: the entry is on the second break.")
entShift = input.int(1, "Marker sits N candles after the break candle", minval = 0, maxval = 10, group = gEn, tooltip = "The signal is generated when the break candle closes; the entry is the candle after it. 1 by default, so the arrow points at the candle you actually enter on.")
entTxtBuy = input.string("E: Long", "Buy label", inline = "et", group = gEn)
entTxtSell = input.string("E: Short", "Sell label", inline = "et", group = gEn)
entShape = input.string("Triangle", "Marker", options = ["Triangle", "Circle", "Arrow", "Diamond"], group = gEn, tooltip = "Triangle (default) — a small solid triangle on the candle, pointing the way of the trade.\nCircle — a dot, the least intrusive.\nArrow — a long thin arrow. Reads clearly from far out but takes up a lot of vertical space.\nDiamond — a solid marker that stands out without pointing.")
entSzIn = input.string("Normal", "Marker size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = gEn)
entTxtSz = input.string("Normal", "Label text size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = gEn)
entBuyC = input.color(#00BF71, "Buy", inline = "ec", group = gEn)
entSellC = input.color(#FF4F87, "Sell", inline = "ec", group = gEn)
entPad = input.float(0.35, "Marker gap from the candle (× ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = gEn)

// ===================== RESULTS ===============================================
// Not a Strategy. These are indicator-side numbers: no spread, no slippage, no
// commission, no partial fills, one position at a time. They tell you how the
// SIGNAL behaved on this timeframe's bars, nothing more.
gRs = "Results  (dashboard stats)"
resOn = input.bool(true, "Track wins / losses on this timeframe", group = gRs, tooltip = "Follows the same signal the entry arrows use — the Nth break — whether or not the arrows are switched on. Switching timeframe recalculates from that timeframe's bars.")
stopMode = input.string("Structure (the turning point behind it)", "Stop", options = ["Structure (the turning point behind it)", "Fixed × ATR"], group = gRs, tooltip = "Structure: the newest turning point still standing behind the entry — the low the move came off for a long, the high for a short. That is where the idea is wrong.\nFixed: a flat multiple of ATR.")
stopAtr = input.float(1.0, "…ATR multiple (also the fallback)", minval = 0.1, maxval = 10.0, step = 0.1, group = gRs)
tgtMode = input.string("Opposite extreme (draw on liquidity)", "Target", options = ["Opposite extreme (draw on liquidity)", "R multiple"], group = gRs, tooltip = "Opposite extreme: the furthest level still standing the other side — the draw on liquidity. Falls back to the R multiple when there is nothing standing there.\nR multiple: a fixed multiple of the risk.")
tgtR = input.float(2.0, "…R multiple (also the fallback)", minval = 0.1, maxval = 20.0, step = 0.1, group = gRs)

// ===================== DASHBOARD =============================================
gDb = "Dashboard"
dbOn = input.bool(true, "Show dashboard", group = gDb)
dbPos = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = gDb)
dbSzIn = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal"], group = gDb)

// ===================== HELPERS ===============================================
f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Huge" ? size.huge : size.large

f_lstyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_tpos(string s) =>
    switch s
        "Top left" => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left" => position.bottom_left
        "Middle right" => position.middle_right
        => position.top_right

f_ord(int n) =>
    int r100 = n % 100
    int r10 = n % 10
    string sfx = r100 >= 11 and r100 <= 13 ? "th" : r10 == 1 ? "st" : r10 == 2 ? "nd" : r10 == 3 ? "rd" : "th"
    str.tostring(n) + sfx

f_txt(int n, float px) =>
    switch lblFmt
        "1st Break" => f_ord(n) + " Break"
        "1st" => f_ord(n)
        "1st Break + price" => f_ord(n) + " Break " + str.tostring(math.round_to_mintick(px))
        => str.tostring(n)

f_eshape(string sh, bool up) =>
    sh == "Circle" ? label.style_circle : sh == "Diamond" ? label.style_diamond : sh == "Arrow" ? (up ? label.style_arrowup : label.style_arrowdown) : (up ? label.style_triangleup : label.style_triangledown)

f_tf() =>
    timeframe.isseconds ? timeframe.period + "s" : timeframe.isminutes ? timeframe.period + "m" : timeframe.period

f_r(float v) =>
    (v >= 0 ? "+" : "") + str.tostring(v, "#.##")

f_col(int n) =>
    n == 1 ? cN1 : n == 2 ? cN2 : n == 3 ? cN3 : cNx

f_brkDn(float lvl) =>
    na(lvl) ? false : confMode == "Wick beyond" ? low < lvl : confMode == "Close beyond" ? close < lvl : close < lvl and open < lvl

f_brkUp(float lvl) =>
    na(lvl) ? false : confMode == "Wick beyond" ? high > lvl : confMode == "Close beyond" ? close > lvl : close > lvl and open > lvl

// A level can stand longer than TradingView allows a drawing coordinate to sit
// behind the current bar (~10,000). Only the DRAWING is clamped.
f_xc(int x) =>
    na(x) ? bar_index : math.max(x, bar_index - 4000)

// Hard ceiling on drawings, not a setting. TradingView itself cannot draw more
// than 500 lines or labels, so there is no useful choice here — and when this
// WAS a setting, a low value silently deleted marks that had been drawn
// correctly, which read as the indicator failing to mark them at all.
int keepN = 500

atr14 = ta.atr(14)

// ===================== THE TWO STACKS ========================================
// hl* — turning-point LOWS, taken downward.  lh* — turning-point HIGHS, taken
// upward. Newest is the LAST element: that is the one the move takes first.
var array<float> hlP = array.new<float>()
var array<int> hlB = array.new<int>()
var array<float> lhP = array.new<float>()
var array<int> lhB = array.new<int>()
var bool hlOk = false
var bool lhOk = false
var int nHL = 0
var int nLH = 0
// Creation bar of the last level numbered in the running sequence. A sequence
// eats levels newest-first, so each one must be OLDER than the last. The moment
// a break takes a level NEWER than that, the move has started on structure it
// built itself — a different leg — and the count restarts at 1st.
var int lastBhl = -1
var int lastBlh = -1

var array<line> brkLn = array.new<line>()
var array<label> brkLb = array.new<label>()
var array<line> stkLn = array.new<line>()
var array<label> stkLb = array.new<label>()
var array<label> enLb = array.new<label>()

// ---- results state ---------------------------------------------------------
var int trTot = 0
var int trWin = 0
var int trLoss = 0
var float rSum = 0.0
var float rWin = 0.0
var float rLoss = 0.0
var bool inTrade = false
var bool trLong = false
var float trEntry = na
var float trStop = na
var float trTgt = na
var float trR = na

f_prune(array<line> la, array<label> lb, int k) =>
    while array.size(la) > k
        line.delete(array.shift(la))
    while array.size(lb) > k
        label.delete(array.shift(lb))
    array.size(la)

// pivots read unconditionally so their history stays consistent
float rawPl = ta.pivotlow(pvLen, pvLen)
float rawPh = ta.pivothigh(pvLen, pvLen)

// ---- build the stacks ------------------------------------------------------
// EVERY confirmed turning point becomes a level. Nothing is skipped, nothing is
// wiped. A level leaves for exactly one reason: price broke it.
if not na(rawPl)
    int b = bar_index - pvLen
    if allTurns or array.size(hlP) == 0 or rawPl > array.get(hlP, array.size(hlP) - 1)
        array.push(hlP, rawPl)
        array.push(hlB, b)
        if array.size(hlP) >= minLv
            hlOk := true
    while array.size(hlP) > stackMax
        array.shift(hlP)
        array.shift(hlB)

if not na(rawPh)
    int b = bar_index - pvLen
    if allTurns or array.size(lhP) == 0 or rawPh < array.get(lhP, array.size(lhP) - 1)
        array.push(lhP, rawPh)
        array.push(lhB, b)
        if array.size(lhP) >= minLv
            lhOk := true
    while array.size(lhP) > stackMax
        array.shift(lhP)
        array.shift(lhB)

// A sequence that ate its whole stack is finished. Checked at the START of the
// bar, so the bar that empties the stack keeps its own numbering intact.
if array.size(hlP) == 0
    nHL := 0
if array.size(lhP) == 0
    nLH := 0

// ---- which level does this bar take, and in what order ----------------------
// NEWEST FIRST. Levels are no longer guaranteed to be in price order, so the
// top of the stack is not necessarily the one this bar reaches — scan down from
// the newest for the first one that is actually broken.
f_nextDn() =>
    int k = -1
    int n = array.size(hlP)
    if n > 0
        for j = 0 to n - 1
            int i = n - 1 - j
            if k == -1 and f_brkDn(array.get(hlP, i))
                k := i
    k

f_nextUp() =>
    int k = -1
    int n = array.size(lhP)
    if n > 0
        for j = 0 to n - 1
            int i = n - 1 - j
            if k == -1 and f_brkUp(array.get(lhP, i))
                k := i
    k

bool evalOk = not waitClose or barstate.isconfirmed
bool firedAny = false
int lastNo = 0
float lastLvl = na
bool lastWasHL = false
bool entBuy = false
bool entSell = false

f_mark(int n, float p, int b, bool isHL) =>
    if not hidePast or n <= hidePastN
        color c = f_col(n)
        int xStart = f_xc(b)
        if lineOn
            array.push(brkLn, line.new(xStart, p, bar_index, p, xloc = xloc.bar_index, color = c, style = f_lstyle(lineStyleIn), width = lineW))
        if lblOn
            float off = atr14 * lblOff
            float yL = isHL ? p - off : p + off
            int xL = lblPos == "Left" ? xStart : lblPos == "Right" ? bar_index : int(math.avg(xStart, bar_index))
            array.push(brkLb, label.new(xL, yL, f_txt(n, p), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = c, size = f_size(lblSzIn)))
        f_prune(brkLn, brkLb, keepN)
    array.size(brkLn)

// A marker on the candle you enter, plus its own text. Two separate labels so
// the text is plain coloured type rather than a chunky filled box. The signal
// is made when the BREAK candle closes; both sit `entShift` candles later,
// which is the candle you actually take.
f_entry(bool isBuy) =>
    float pad = atr14 * entPad
    color c = isBuy ? entBuyC : entSellC
    int x = bar_index + entShift
    array.push(enLb, label.new(x, isBuy ? low - pad : high + pad, "", xloc = xloc.bar_index, yloc = yloc.price, style = f_eshape(entShape, isBuy), color = c, textcolor = c, size = f_size(entSzIn)))
    array.push(enLb, label.new(x, isBuy ? low - pad * 2.4 : high + pad * 2.4, isBuy ? entTxtBuy : entTxtSell, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = c, size = f_size(entTxtSz)))
    while array.size(enLb) > keepN * 2
        label.delete(array.shift(enLb))
    array.size(enLb)

// ---- the move eats the stack, newest first ---------------------------------
if evalOk and sellOn and hlOk
    int gi = f_nextDn()
    while gi >= 0
        float p = array.get(hlP, gi)
        int b = array.get(hlB, gi)
        array.remove(hlP, gi)
        array.remove(hlB, gi)
        if nHL > 0 and b >= lastBhl
            nHL := 0
        nHL := nHL + 1
        lastBhl := b
        firedAny := true
        lastNo := nHL
        lastLvl := p
        lastWasHL := true
        f_mark(nHL, p, b, true)
        if nHL == entAt
            entSell := true
            if entOn
                f_entry(false)
        gi := f_nextDn()

if evalOk and buyOn and lhOk
    int gj = f_nextUp()
    while gj >= 0
        float p = array.get(lhP, gj)
        int b = array.get(lhB, gj)
        array.remove(lhP, gj)
        array.remove(lhB, gj)
        if nLH > 0 and b >= lastBlh
            nLH := 0
        nLH := nLH + 1
        lastBlh := b
        firedAny := true
        lastNo := nLH
        lastLvl := p
        lastWasHL := false
        f_mark(nLH, p, b, false)
        if nLH == entAt
            entBuy := true
            if entOn
                f_entry(true)
        gj := f_nextUp()

// ===================== RESULTS TRACKER =======================================
// Resolve the OPEN trade first, so the entry bar itself is never used to close
// the trade it just opened. One position at a time; a signal that arrives while
// a trade is open is ignored rather than stacked.
if resOn and evalOk
    if inTrade
        bool hitStop = trLong ? low <= trStop : high >= trStop
        bool hitTgt = trLong ? high >= trTgt : low <= trTgt
        if hitStop
            trTot := trTot + 1
            trLoss := trLoss + 1
            rSum := rSum - 1.0
            rLoss := rLoss + 1.0
            inTrade := false
        else if hitTgt
            trTot := trTot + 1
            trWin := trWin + 1
            rSum := rSum + trR
            rWin := rWin + trR
            inTrade := false

    if not inTrade and (entBuy or entSell)
        bool isLong = entBuy
        float e = close
        float st = stopMode == "Fixed × ATR" ? (isLong ? e - atr14 * stopAtr : e + atr14 * stopAtr) : isLong ? (array.size(hlP) > 0 ? array.get(hlP, array.size(hlP) - 1) : e - atr14 * stopAtr) : (array.size(lhP) > 0 ? array.get(lhP, array.size(lhP) - 1) : e + atr14 * stopAtr)
        // a stop on the wrong side of entry is no stop at all
        if isLong and st >= e
            st := e - atr14 * stopAtr
        if not isLong and st <= e
            st := e + atr14 * stopAtr
        float risk = math.abs(e - st)
        float tg = na
        if tgtMode == "Opposite extreme (draw on liquidity)"
            tg := isLong ? (array.size(lhP) > 0 ? array.max(lhP) : na) : (array.size(hlP) > 0 ? array.min(hlP) : na)
        if na(tg) or (isLong and tg <= e) or (not isLong and tg >= e)
            tg := isLong ? e + risk * tgtR : e - risk * tgtR
        if risk > 0
            inTrade := true
            trLong := isLong
            trEntry := e
            trStop := st
            trTgt := tg
            trR := math.abs(tg - e) / risk

// ---- keep the chart to the price action being looked at --------------------
if barstate.islast and histBars > 0
    while array.size(brkLn) > 0 and line.get_x2(array.get(brkLn, 0)) < bar_index - histBars
        line.delete(array.shift(brkLn))
    while array.size(brkLb) > 0 and label.get_x(array.get(brkLb, 0)) < bar_index - histBars
        label.delete(array.shift(brkLb))
    while array.size(enLb) > 0 and label.get_x(array.get(enLb, 0)) < bar_index - histBars
        label.delete(array.shift(enLb))

// ===================== WHAT IS STILL STANDING ================================
// Redrawn on the last bar only. The TOP of each stack is what breaks first, so
// these are numbered 1 · 2 · 3 downward from the top.
if barstate.islast
    while array.size(stkLn) > 0
        line.delete(array.shift(stkLn))
    while array.size(stkLb) > 0
        label.delete(array.shift(stkLb))
    if stackShow
        if sellOn and array.size(hlP) > 0
            for i = 0 to array.size(hlP) - 1
                float p = array.get(hlP, i)
                int rank = array.size(hlP) - i
                array.push(stkLn, line.new(f_xc(array.get(hlB, i)), p, bar_index + 4, p, xloc = xloc.bar_index, color = stackHLC, style = line.style_dotted, width = 1))
                if stackTag
                    array.push(stkLb, label.new(bar_index + 5, p, str.tostring(rank), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = stackHLC, size = size.tiny))
        if buyOn and array.size(lhP) > 0
            for i = 0 to array.size(lhP) - 1
                float p = array.get(lhP, i)
                int rank = array.size(lhP) - i
                array.push(stkLn, line.new(f_xc(array.get(lhB, i)), p, bar_index + 4, p, xloc = xloc.bar_index, color = stackLHC, style = line.style_dotted, width = 1))
                if stackTag
                    array.push(stkLb, label.new(bar_index + 5, p, str.tostring(rank), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = stackLHC, size = size.tiny))

// ===================== ALERTS ================================================
alertcondition(firedAny, "Any break", "Basic Breaks — a level was broken")
alertcondition(entBuy, "BUY entry", "Basic Breaks — BUY: the break candle has closed, enter on the next candle")
alertcondition(entSell, "SELL entry", "Basic Breaks — SELL: the break candle has closed, enter on the next candle")
if firedAny
    alert(f_ord(lastNo) + " Break — " + (lastWasHL ? "low" : "high") + " @ " + str.tostring(math.round_to_mintick(lastLvl)), alert.freq_once_per_bar_close)
if entBuy or entSell
    alert((entBuy ? "BUY" : "SELL") + " — " + f_ord(entAt) + " break has closed, enter on the next candle", alert.freq_once_per_bar_close)

// ===================== DASHBOARD =============================================
var table db = table.new(f_tpos(dbPos), 3, 11, border_width = 1)
f_cell(int col, int row, string txt, color c) =>
    table.cell(db, col, row, txt, text_color = c, text_size = f_size(dbSzIn), bgcolor = color.new(color.black, 85))

if dbOn and barstate.islast
    table.clear(db, 0, 0, 2, 10)
    color gry = color.new(color.gray, 0)
    f_cell(0, 0, "BREAKS  " + f_tf(), color.new(color.white, 0))
    f_cell(1, 0, "standing", gry)
    f_cell(2, 0, "broken", gry)
    f_cell(0, 1, "lows  (sells)", color.new(stackHLC, 0))
    f_cell(1, 1, sellOn ? (hlOk ? str.tostring(array.size(hlP)) : str.tostring(array.size(hlP)) + "!") : "—", color.new(stackHLC, sellOn ? 0 : 60))
    f_cell(2, 1, sellOn and nHL > 0 ? f_ord(nHL) : "·", f_col(nHL == 0 ? 4 : nHL))
    f_cell(0, 2, "highs  (buys)", color.new(stackLHC, 0))
    f_cell(1, 2, buyOn ? (lhOk ? str.tostring(array.size(lhP)) : str.tostring(array.size(lhP)) + "!") : "—", color.new(stackLHC, buyOn ? 0 : 60))
    f_cell(2, 2, buyOn and nLH > 0 ? f_ord(nLH) : "·", f_col(nLH == 0 ? 4 : nLH))

    if resOn
        float wr = trTot > 0 ? 100.0 * trWin / trTot : na
        float avgR = trTot > 0 ? rSum / trTot : na
        float pf = rLoss > 0 ? rWin / rLoss : na
        color pnlC = rSum > 0 ? entBuyC : rSum < 0 ? entSellC : gry
        f_cell(0, 3, f_ord(entAt) + "-break results  ·  " + f_tf(), color.new(color.white, 0))
        f_cell(1, 3, "", gry)
        f_cell(2, 3, "", gry)
        f_cell(0, 4, "trades", gry)
        f_cell(1, 4, str.tostring(trTot), color.new(color.white, 0))
        f_cell(2, 4, inTrade ? (trLong ? "1 open L" : "1 open S") : "", inTrade ? (trLong ? entBuyC : entSellC) : gry)
        f_cell(0, 5, "wins", gry)
        f_cell(1, 5, str.tostring(trWin), entBuyC)
        f_cell(2, 5, na(wr) ? "—" : str.tostring(wr, "#.#") + "%", entBuyC)
        f_cell(0, 6, "losses", gry)
        f_cell(1, 6, str.tostring(trLoss), entSellC)
        f_cell(2, 6, na(wr) ? "—" : str.tostring(100.0 - wr, "#.#") + "%", entSellC)
        f_cell(0, 7, "avg R / trade", gry)
        f_cell(1, 7, na(avgR) ? "—" : f_r(avgR), na(avgR) ? gry : avgR >= 0 ? entBuyC : entSellC)
        f_cell(2, 7, "", gry)
        f_cell(0, 8, "total R", gry)
        f_cell(1, 8, f_r(rSum), pnlC)
        f_cell(2, 8, "", gry)
        f_cell(0, 9, "profit factor", gry)
        f_cell(1, 9, na(pf) ? "—" : str.tostring(pf, "#.##"), na(pf) ? gry : pf >= 1 ? entBuyC : entSellC)
        f_cell(2, 9, "", gry)
        f_cell(0, 10, "R:R on the open trade", gry)
        f_cell(1, 10, inTrade and not na(trR) ? "1 : " + str.tostring(trR, "#.##") : "—", inTrade ? (trLong ? entBuyC : entSellC) : gry)
        f_cell(2, 10, inTrade ? str.tostring(math.round_to_mintick(trStop)) + " → " + str.tostring(math.round_to_mintick(trTgt)) : "", gry)
