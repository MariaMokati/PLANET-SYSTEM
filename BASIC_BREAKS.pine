//@version=6
// =============================================================================
// BASIC BREAKS  —  1st / 2nd / 3rd break of the impulse's structure
// -----------------------------------------------------------------------------
// THE MODEL
//   An impulse UP makes higher highs and HIGHER LOWS. Those HLs are the levels
//   — the "history HL for sell set ups". When the pullback comes, it breaks
//   them in REVERSE ORDER OF CREATION:
//
//       the LAST HL made          →  1st Break
//       the SECOND-LAST HL made   →  2nd Break
//       the THIRD-LAST HL made    →  3rd Break
//
//   Mirror for an impulse DOWN: it makes LOWER HIGHS, and the pullback up takes
//   them newest-first. Those are the buy setups.
//
//   So the levels are a STACK, eaten from the top, not a list of whatever
//   happens to be nearest. A pullback often stops after the 1st or 2nd — that
//   is not a failure of the indicator, it is the market failing to break the
//   3rd, and it is worth seeing.
//
//   A stack only counts once it is a real SEQUENCE (2+ levels by default).
//   Without that, a single stray pivot sits in the stack and every move the
//   other way prints a spurious "1st Break".
//
//   The count restarts whenever the impulse resumes — a new HL (or LH) is made.
//
// Non-repainting: pivots are CONFIRMED (placed `length` bars back) and a break
// is judged once at bar close. A wick through that closes back inside is a
// fake-out and breaks nothing.
//
// HONESTY: an annotation tool. It marks what happened, nothing more.
// =============================================================================
indicator("Basic Breaks", "BREAKS", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ===================== STRUCTURE =============================================
gSt = "Structure"
pvLen = input.int(10, "Swing length", minval = 1, group = gSt, tooltip = "Bars either side of a swing. THIS IS THE DIAL. It decides which highs and lows count as structure, and therefore which levels get numbered. Turn on the structure zigzag below, compare it to the structure you would draw by hand, and change this number until the two match.")
zzOn = input.bool(true, "Show the structure it is using", group = gSt, tooltip = "Draws the exact swing sequence the numbering is built from, as a zigzag. If this line does not trace the same swings you would draw by hand, the swing length is wrong and nothing downstream can be right. This is the fastest way to tune it.")
zzCol = input.color(color.new(#2962FF, 0), "Zigzag", inline = "zz", group = gSt)
zzW = input.int(2, "width", minval = 1, maxval = 4, inline = "zz", group = gSt)
zzLbl = input.bool(true, "Label HH / HL / LH / LL", group = gSt)
capOn = input.bool(true, "Stop after the Nth break", group = gSt, tooltip = "On (default): a sequence runs 1st, 2nd, 3rd and then stops. Anything the pullback takes beyond that is not drawn — the sequence is finished. Off: it keeps counting 4th, 5th, …")
capN = input.int(3, "…the Nth", minval = 1, maxval = 20, group = gSt)
minLv = input.int(2, "A stack counts once it has N levels", minval = 1, maxval = 10, group = gSt, tooltip = "A single stray pivot is not a sequence. Requiring 2 means an impulse must have made at least two higher lows (or two lower highs) before its breaks are numbered. Set to 1 to number everything.")
sellOn = input.bool(true, "Track HIGHER LOWS  (up impulse → sell setups)", group = gSt, tooltip = "The HLs an up impulse leaves behind, broken downward by the pullback.")
buyOn = input.bool(true, "Track LOWER HIGHS  (down impulse → buy setups)", group = gSt, tooltip = "The LHs a down impulse leaves behind, broken upward by the pullback.")

// ===================== BREAK CONFIRMATION ====================================
gCf = "Break confirmation"
confMode = input.string("Close beyond", "What breaks a level", options = ["Wick beyond", "Close beyond", "Full body beyond"], group = gCf, tooltip = "Close beyond (default) — the candle must FINISH past the level. A wick through that closes back inside is a fake-out and breaks nothing.\nFull body beyond — open AND close both clear. Stricter.\nWick beyond — any touch counts, fake-outs included.")
waitClose = input.bool(true, "Only judge closed bars", group = gCf)

// ===================== THE LIVE STACK ========================================
gLs = "The live stack"
stackShow = input.bool(true, "Show the levels still standing", group = gLs, tooltip = "Dotted lines for every HL / LH the impulse has left that nothing has broken yet. The TOP one is what the next pullback breaks first — this is the fastest way to see whether the structure being tracked is the right one.")
stackHLC = input.color(color.new(#089981, 40), "Higher lows", inline = "sc", group = gLs)
stackLHC = input.color(color.new(#F23645, 40), "Lower highs", inline = "sc", group = gLs)
stackTag = input.bool(true, "Number them from the top", group = gLs, tooltip = "Labels the standing levels 1 · 2 · 3 from the top down, so you can see in advance which will be the 1st, 2nd and 3rd break.")
stackMax = input.int(12, "Track at most N levels per stack", minval = 2, maxval = 50, group = gLs)

// ===================== VISUALS ===============================================
gVs = "Visuals"
cN1 = input.color(color.new(#5B9CF6, 0), "1st", inline = "cn", group = gVs)
cN2 = input.color(color.new(#2962FF, 0), "2nd", inline = "cn", group = gVs)
cN3 = input.color(color.new(#089981, 0), "3rd", inline = "cn", group = gVs)
cNx = input.color(color.new(#787B86, 0), "4th+", inline = "cn", group = gVs)
lineOn = input.bool(true, "Draw the broken level as a line", group = gVs, tooltip = "From where the HL / LH formed across to the candle that broke it.")
lineW = input.int(1, "Line width", minval = 1, maxval = 4, group = gVs)
lineStyleIn = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = gVs)
lblOn = input.bool(true, "Label the break", group = gVs)
lblFmt = input.string("1st Break", "Label text", options = ["1st Break", "1st", "1st Break + price", "1"], group = gVs)
lblPos = input.string("Centre", "Label sits", options = ["Left", "Centre", "Right"], group = gVs)
lblOff = input.float(0.25, "Label offset (× ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = gVs)
lblSzIn = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal", "Large"], group = gVs)
keepN = input.int(24, "Keep last N break marks", minval = 1, maxval = 200, group = gVs)

// ===================== NOT YET ASKED FOR — OFF BY DEFAULT ====================
gLater = "Entry and zone  (off — breaks first)"
entOn = input.bool(false, "Mark an entry on the Nth break", group = gLater, tooltip = "Off. Turn on once the breaks are marking correctly.")
entAt = input.int(2, "…on which break", minval = 1, maxval = 20, group = gLater)
entTxt = input.string("ENTRY", "Entry label", group = gLater)
zoneOn = input.bool(false, "Draw a zone on the 1st break", group = gLater, tooltip = "Off. The zone spans from the level broken to the next one still standing under it.")
zFade = input.int(88, "Zone transparency", minval = 0, maxval = 100, group = gLater)

// ===================== DASHBOARD =============================================
gDb = "Dashboard"
dbOn = input.bool(true, "Show dashboard", group = gDb)
dbPos = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = gDb)
dbSzIn = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal"], group = gDb)

// ===================== HELPERS ===============================================
f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : size.large

f_lstyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_tpos(string s) =>
    switch s
        "Top left" => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left" => position.bottom_left
        "Middle right" => position.middle_right
        => position.top_right

f_ord(int n) =>
    int r100 = n % 100
    int r10 = n % 10
    string sfx = r100 >= 11 and r100 <= 13 ? "th" : r10 == 1 ? "st" : r10 == 2 ? "nd" : r10 == 3 ? "rd" : "th"
    str.tostring(n) + sfx

f_txt(int n, float px) =>
    switch lblFmt
        "1st Break" => f_ord(n) + " Break"
        "1st" => f_ord(n)
        "1st Break + price" => f_ord(n) + " Break " + str.tostring(math.round_to_mintick(px))
        => str.tostring(n)

f_col(int n) =>
    n == 1 ? cN1 : n == 2 ? cN2 : n == 3 ? cN3 : cNx

f_brkDn(float lvl) =>
    na(lvl) ? false : confMode == "Wick beyond" ? low < lvl : confMode == "Close beyond" ? close < lvl : close < lvl and open < lvl

f_brkUp(float lvl) =>
    na(lvl) ? false : confMode == "Wick beyond" ? high > lvl : confMode == "Close beyond" ? close > lvl : close > lvl and open > lvl

// A level can stand longer than TradingView allows a drawing coordinate to sit
// behind the current bar (~10,000). Only the DRAWING is clamped.
f_xc(int x) =>
    na(x) ? bar_index : math.max(x, bar_index - 4000)

atr14 = ta.atr(14)

// ===================== THE TWO STACKS ========================================
// hl* — the higher lows an UP impulse leaves behind, eaten downward.
// lh* — the lower highs a DOWN impulse leaves behind, eaten upward.
// Newest is always the LAST element: that is the one the pullback takes first.
var array<float> hlP = array.new<float>()
var array<int> hlB = array.new<int>()
var array<float> lhP = array.new<float>()
var array<int> lhB = array.new<int>()
var bool hlOk = false
var bool lhOk = false
var int nHL = 0
var int nLH = 0
// THE SWING SERIES — strictly alternating high, low, high, low.
// ta.pivothigh and ta.pivotlow are INDEPENDENT: they do not alternate, and a
// strong leg happily produces two highs in a row with no low between. Pushing
// raw pivots into one list in confirmation order gives a series with same-side
// neighbours in it, which draws as a scribble and, worse, breaks every rule
// below that assumes a high is followed by a low. Two highs in a row collapse
// to the higher; two lows to the lower.
var array<float> swP = array.new<float>()
var array<int> swB = array.new<int>()
var array<bool> swH = array.new<bool>()
var array<line> zzLn = array.new<line>()
var array<label> zzLb = array.new<label>()

var array<line> brkLn = array.new<line>()
var array<label> brkLb = array.new<label>()
var array<line> stkLn = array.new<line>()
var array<label> stkLb = array.new<label>()
var array<label> enLb = array.new<label>()
var array<box> zBx = array.new<box>()

f_prune(array<line> la, array<label> lb, int k) =>
    while array.size(la) > k
        line.delete(array.shift(la))
    while array.size(lb) > k
        label.delete(array.shift(lb))
    array.size(la)

// pivots read unconditionally so their history stays consistent
float rawPl = ta.pivotlow(pvLen, pvLen)
float rawPh = ta.pivothigh(pvLen, pvLen)

// ---- one clean swing series, then everything is driven off it --------------
// Append a swing, or extend the last one if it is the same side. Returns true
// only when a genuinely NEW swing was appended.
f_addSwing(float p, int bx, bool isHigh) =>
    int n = array.size(swP)
    bool appended = false
    if n == 0
        array.push(swP, p)
        array.push(swB, bx)
        array.push(swH, isHigh)
        appended := true
    else
        if array.get(swH, n - 1) == isHigh
            float lastP = array.get(swP, n - 1)
            if (isHigh and p > lastP) or (not isHigh and p < lastP)
                array.set(swP, n - 1, p)
                array.set(swB, n - 1, bx)
        else
            array.push(swP, p)
            array.push(swB, bx)
            array.push(swH, isHigh)
            appended := true
    appended

// A new swing tells us what the PREVIOUS one was. A higher high means the low
// before it was a HIGHER LOW of the impulse — that is the level. A lower low
// means the high before it was a LOWER HIGH. Because the series alternates,
// the previous same-side swing is always exactly two back.
//
// This runs at GLOBAL scope, not in a function: Pine lets a function mutate a
// global array but NOT assign to a global scalar (CE10088), and this has to set
// hlOk / lhOk / nHL / nLH.
int adds = 0
if not na(rawPh)
    if f_addSwing(rawPh, bar_index - pvLen, true)
        adds += 1
if not na(rawPl)
    if f_addSwing(rawPl, bar_index - pvLen, false)
        adds += 1

// Both a pivot high and a pivot low can confirm on the same bar (one big
// outside bar). Classify each new swing in the order it formed.
if adds > 0
    for k = 0 to adds - 1
        int idx = array.size(swP) - adds + k
        if idx >= 2
            bool isHi = array.get(swH, idx)
            float cur = array.get(swP, idx)
            float prevSame = array.get(swP, idx - 2)
            if isHi and cur > prevSame
                float lo = array.get(swP, idx - 1)
                int lob = array.get(swB, idx - 1)
                if array.size(hlP) == 0 or lo > array.get(hlP, array.size(hlP) - 1)
                    array.push(hlP, lo)
                    array.push(hlB, lob)
                    if array.size(hlP) >= minLv
                        hlOk := true
                nHL := 0
            if not isHi and cur < prevSame
                float hi = array.get(swP, idx - 1)
                int hib = array.get(swB, idx - 1)
                if array.size(lhP) == 0 or hi < array.get(lhP, array.size(lhP) - 1)
                    array.push(lhP, hi)
                    array.push(lhB, hib)
                    if array.size(lhP) >= minLv
                        lhOk := true
                nLH := 0

while array.size(swP) > 60
    array.shift(swP)
    array.shift(swB)
    array.shift(swH)
while array.size(hlP) > stackMax
    array.shift(hlP)
    array.shift(hlB)
while array.size(lhP) > stackMax
    array.shift(lhP)
    array.shift(lhB)

// ---- the pullback eats the stack from the top ------------------------------
bool evalOk = not waitClose or barstate.isconfirmed
bool firedAny = false
int lastNo = 0
float lastLvl = na
bool lastWasHL = false

f_mark(int n, float p, int b, bool isHL) =>
    color c = f_col(n)
    int xStart = f_xc(b)
    if lineOn
        array.push(brkLn, line.new(xStart, p, bar_index, p, xloc = xloc.bar_index, color = c, style = f_lstyle(lineStyleIn), width = lineW))
    if lblOn
        float off = atr14 * lblOff
        float yL = isHL ? p - off : p + off
        int xL = lblPos == "Left" ? xStart : lblPos == "Right" ? bar_index : int(math.avg(xStart, bar_index))
        array.push(brkLb, label.new(xL, yL, f_txt(n, p), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = c, size = f_size(lblSzIn)))
    f_prune(brkLn, brkLb, keepN)

if evalOk and sellOn and hlOk
    while array.size(hlP) > 0 and f_brkDn(array.get(hlP, array.size(hlP) - 1))
        float p = array.pop(hlP)
        int b = array.pop(hlB)
        nHL := nHL + 1
        if capOn and nHL > capN
            break
        firedAny := true
        lastNo := nHL
        lastLvl := p
        lastWasHL := true
        f_mark(nHL, p, b, true)
        if zoneOn and nHL == 1 and array.size(hlP) > 0
            float below = array.get(hlP, array.size(hlP) - 1)
            if p > below
                array.push(zBx, box.new(f_xc(b), p, bar_index + 30, below, xloc = xloc.bar_index, border_color = color.new(cN1, 45), bgcolor = color.new(cN1, zFade)))
                while array.size(zBx) > 3
                    box.delete(array.shift(zBx))
        if entOn and nHL == entAt
            array.push(enLb, label.new(bar_index, close, entTxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(#F23645, 15), textcolor = color.white, size = f_size(lblSzIn)))
            while array.size(enLb) > keepN
                label.delete(array.shift(enLb))

if evalOk and buyOn and lhOk
    while array.size(lhP) > 0 and f_brkUp(array.get(lhP, array.size(lhP) - 1))
        float p = array.pop(lhP)
        int b = array.pop(lhB)
        nLH := nLH + 1
        if capOn and nLH > capN
            break
        firedAny := true
        lastNo := nLH
        lastLvl := p
        lastWasHL := false
        f_mark(nLH, p, b, false)
        if zoneOn and nLH == 1 and array.size(lhP) > 0
            float above = array.get(lhP, array.size(lhP) - 1)
            if above > p
                array.push(zBx, box.new(f_xc(b), above, bar_index + 30, p, xloc = xloc.bar_index, border_color = color.new(cN1, 45), bgcolor = color.new(cN1, zFade)))
                while array.size(zBx) > 3
                    box.delete(array.shift(zBx))
        if entOn and nLH == entAt
            array.push(enLb, label.new(bar_index, close, entTxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(#089981, 15), textcolor = color.white, size = f_size(lblSzIn)))
            while array.size(enLb) > keepN
                label.delete(array.shift(enLb))

// ===================== THE STRUCTURE IT IS USING =============================
// The alternating swing series the numbering is built from. Compare it against
// the structure you would draw by hand: if the two do not trace the same
// swings, the swing length is wrong and nothing downstream can be right.
if barstate.islast
    while array.size(zzLn) > 0
        line.delete(array.shift(zzLn))
    while array.size(zzLb) > 0
        label.delete(array.shift(zzLb))
    if zzOn and array.size(swP) > 1
        for i = 1 to array.size(swP) - 1
            array.push(zzLn, line.new(f_xc(array.get(swB, i - 1)), array.get(swP, i - 1), f_xc(array.get(swB, i)), array.get(swP, i), xloc = xloc.bar_index, color = zzCol, width = zzW))
        if zzLbl
            for i = 0 to array.size(swP) - 1
                bool isHi = array.get(swH, i)
                float p = array.get(swP, i)
                string t = i < 2 ? (isHi ? "H" : "L") : isHi ? (p > array.get(swP, i - 2) ? "HH" : "LH") : (p < array.get(swP, i - 2) ? "LL" : "HL")
                array.push(zzLb, label.new(f_xc(array.get(swB, i)), p, t, xloc = xloc.bar_index, yloc = yloc.price, style = isHi ? label.style_label_down : label.style_label_up, color = color.new(zzCol, 80), textcolor = zzCol, size = size.tiny))

// ===================== WHAT IS STILL STANDING ================================
// Redrawn on the last bar only. The TOP of each stack is what breaks first, so
// these are numbered 1 · 2 · 3 downward from the top.
if barstate.islast
    while array.size(stkLn) > 0
        line.delete(array.shift(stkLn))
    while array.size(stkLb) > 0
        label.delete(array.shift(stkLb))
    if stackShow
        if sellOn and array.size(hlP) > 0
            for i = 0 to array.size(hlP) - 1
                float p = array.get(hlP, i)
                int rank = array.size(hlP) - i
                array.push(stkLn, line.new(f_xc(array.get(hlB, i)), p, bar_index + 4, p, xloc = xloc.bar_index, color = stackHLC, style = line.style_dotted, width = 1))
                if stackTag
                    array.push(stkLb, label.new(bar_index + 5, p, str.tostring(rank), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = stackHLC, size = size.tiny))
        if buyOn and array.size(lhP) > 0
            for i = 0 to array.size(lhP) - 1
                float p = array.get(lhP, i)
                int rank = array.size(lhP) - i
                array.push(stkLn, line.new(f_xc(array.get(lhB, i)), p, bar_index + 4, p, xloc = xloc.bar_index, color = stackLHC, style = line.style_dotted, width = 1))
                if stackTag
                    array.push(stkLb, label.new(bar_index + 5, p, str.tostring(rank), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = stackLHC, size = size.tiny))

// ===================== ALERTS ================================================
alertcondition(firedAny, "Any break", "Basic Breaks — a structure level was broken")
if firedAny
    alert(f_ord(lastNo) + " Break — " + (lastWasHL ? "higher low" : "lower high") + " @ " + str.tostring(math.round_to_mintick(lastLvl)), alert.freq_once_per_bar_close)

// ===================== DASHBOARD =============================================
var table db = table.new(f_tpos(dbPos), 3, 3, border_width = 1)
f_cell(int col, int row, string txt, color c) =>
    table.cell(db, col, row, txt, text_color = c, text_size = f_size(dbSzIn), bgcolor = color.new(color.black, 85))

if dbOn and barstate.islast
    table.clear(db, 0, 0, 2, 2)
    f_cell(0, 0, "BREAKS", color.new(color.white, 0))
    f_cell(1, 0, "standing", color.new(color.gray, 0))
    f_cell(2, 0, "broken", color.new(color.gray, 0))
    f_cell(0, 1, "HL  (sells)", color.new(stackHLC, 0))
    f_cell(1, 1, sellOn ? (hlOk ? str.tostring(array.size(hlP)) : str.tostring(array.size(hlP)) + "!") : "—", color.new(stackHLC, sellOn ? 0 : 60))
    f_cell(2, 1, sellOn and nHL > 0 ? f_ord(nHL) : "·", f_col(nHL == 0 ? 4 : nHL))
    f_cell(0, 2, "LH  (buys)", color.new(stackLHC, 0))
    f_cell(1, 2, buyOn ? (lhOk ? str.tostring(array.size(lhP)) : str.tostring(array.size(lhP)) + "!") : "—", color.new(stackLHC, buyOn ? 0 : 60))
    f_cell(2, 2, buyOn and nLH > 0 ? f_ord(nLH) : "·", f_col(nLH == 0 ? 4 : nLH))
