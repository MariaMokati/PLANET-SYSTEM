//@version=6
// =============================================================================
// BASIC BREAKS  —  1st / 2nd / 3rd break of the fractal structure
// -----------------------------------------------------------------------------
// THE MODEL — fractals, nothing else.
//
//   Every confirmed fractal HIGH is a level. Every confirmed fractal LOW is a
//   level. No classification, no filtering, no deciding which ones are
//   "allowed" to count — the corners are the corners.
//
//   When price closes ABOVE the nearest standing fractal high, that is the
//   1st Break. The next one up is the 2nd. The one above that is the 3rd.
//   Mirror downward through the fractal lows.
//
//   A sequence runs until it restarts, and WHEN it restarts is a setting —
//   when the move that made the levels turns (default), when the other side
//   breaks, or only once the Nth is reached. That choice decides whether a
//   level taken hours after the one before it is still the 3rd or a fresh 1st.
//
//   A pullback often stops after the 1st or 2nd. That is not the indicator
//   missing something, it is the market failing to reach the 3rd.
//
//   Two things stop it numbering noise, and neither is a classification:
//     · fractals within a few ticks of each other are ONE level;
//     · a sequence only STARTS where structure is stacked beyond the level
//       being taken. An impulse breaking its own last minor high has clear air
//       above it, so it is the impulse continuing, not a sequence.
//
// SWING LENGTH is the only dial. It decides which corners are fractals, and
// therefore which levels get numbered. Nothing else filters.
//
// Non-repainting: fractals are CONFIRMED (placed `length` bars back) and a
// break is judged once at bar close. A wick through that closes back inside is
// a fake-out and breaks nothing.
//
// HONESTY: an annotation tool. It marks what happened, nothing more.
// =============================================================================
indicator("Basic Breaks", "BREAKS", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ===================== STRUCTURE =============================================
gSt = "Structure"
pvLen = input.int(10, "Swing length", minval = 1, group = gSt, tooltip = "Bars either side of a fractal. THIS IS THE ONLY DIAL. Lower it to pick up smaller corners, raise it to keep only the bigger ones. Nothing else decides which levels get numbered.")
upOn = input.bool(true, "Number breaks of fractal HIGHS  (price closing up through them)", group = gSt)
dnOn = input.bool(true, "Number breaks of fractal LOWS  (price closing down through them)", group = gSt)
capOn = input.bool(true, "Stop after the Nth break", group = gSt, tooltip = "On (default): a sequence runs 1st, 2nd, 3rd and then stops. Off: it keeps counting 4th, 5th, …")
capN = input.int(3, "…the Nth", minval = 1, maxval = 20, group = gSt)
dropUsed = input.bool(true, "Ignore a level price is already past when it confirms", group = gSt, tooltip = "A fractal is only known `swing length` bars after it printed. If price already closed through it in the meantime it was never standing, so it is not numbered. Turn this off to number it late instead.")
mergeAtr = input.float(0.25, "Treat levels closer than (× ATR) as one", minval = 0.0, maxval = 3.0, step = 0.05, group = gSt, tooltip = "A flat consolidation prints several fractals a few ticks apart. Without this they each eat a number, so the 1st and the 2nd land on what is visually the same level and the real 3rd never gets counted. Set to 0 to number every fractal separately.")
resetMode = input.string("When the move that made them turns", "A sequence restarts", options = ["When the move that made them turns", "When the other side breaks", "Only once the Nth is reached"], group = gSt, tooltip = "WHEN DOES 1st START OVER.\n\nWhen the move that made them turns (default) — a new fractal forms in the direction of travel, so the pullback has topped and the next run counts again from 1st. Tightest: a long chop between two breaks restarts the count.\n\nWhen the other side breaks — the count keeps running until price breaks the opposite way. Use this if a level that gets taken hours after the one before it should still be the 3rd rather than a fresh 1st.\n\nOnly once the Nth is reached — loosest. The count runs 1st, 2nd, 3rd and only then starts over, however long it takes.")
needBeyond = input.int(1, "A sequence only starts where N levels stand beyond it", minval = 0, maxval = 5, group = gSt, tooltip = "An impulse breaking its own last minor high has nothing above it — that is the impulse continuing, not a sequence, and it does not get numbered. A pullback breaking into stacked structure does. Once a sequence has started this no longer applies, so the 3rd still counts even when it is the last level there is. Set to 0 to number every break.")

// ===================== BREAK CONFIRMATION ====================================
gCf = "Break confirmation"
confMode = input.string("Close beyond", "What breaks a level", options = ["Wick beyond", "Close beyond", "Full body beyond"], group = gCf, tooltip = "Close beyond (default) — the candle must FINISH past the level. A wick through that closes back inside is a fake-out and breaks nothing.\nFull body beyond — open AND close both clear. Stricter.\nWick beyond — any touch counts, fake-outs included.")
waitClose = input.bool(true, "Only judge closed bars", group = gCf)

// ===================== WHAT IS STILL STANDING ================================
gLs = "Levels still standing"
stackShow = input.bool(true, "Show them", group = gLs, tooltip = "Dotted line for every fractal level nothing has broken yet. The nearest one is what the next move breaks first.")
stackHiC = input.color(color.new(#F23645, 40), "Highs above", inline = "sc", group = gLs)
stackLoC = input.color(color.new(#089981, 40), "Lows below", inline = "sc", group = gLs)
stackTag = input.bool(true, "Number them nearest-first", group = gLs, tooltip = "Labels the standing levels 1 · 2 · 3 outward from price, so you can see in advance which will be the 1st, 2nd and 3rd break.")
stackMax = input.int(20, "Track at most N levels per side", minval = 2, maxval = 60, group = gLs)

// ===================== VISUALS ===============================================
gVs = "Visuals"
cN1 = input.color(color.new(#5B9CF6, 0), "1st", inline = "cn", group = gVs)
cN2 = input.color(color.new(#2962FF, 0), "2nd", inline = "cn", group = gVs)
cN3 = input.color(color.new(#089981, 0), "3rd", inline = "cn", group = gVs)
cNx = input.color(color.new(#787B86, 0), "4th+", inline = "cn", group = gVs)
lineOn = input.bool(true, "Draw the broken level as a line", group = gVs, tooltip = "From where the fractal formed across to the candle that broke it.")
lineW = input.int(1, "Line width", minval = 1, maxval = 4, group = gVs)
lineStyleIn = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = gVs)
lblOn = input.bool(true, "Label the break", group = gVs)
lblFmt = input.string("1st Break", "Label text", options = ["1st Break", "1st", "1st Break + price", "1"], group = gVs)
lblPos = input.string("Centre", "Label sits", options = ["Left", "Centre", "Right"], group = gVs)
lblOff = input.float(0.25, "Label offset (× ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = gVs)
lblSzIn = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal", "Large"], group = gVs)
keepN = input.int(24, "Keep last N break marks", minval = 1, maxval = 200, group = gVs)

// ===================== NOT YET ASKED FOR — OFF BY DEFAULT ====================
gLater = "Entry  (off — breaks first)"
entOn = input.bool(false, "Mark an entry on the Nth break", group = gLater, tooltip = "Off. Turn on once the breaks are marking correctly.")
entAt = input.int(2, "…on which break", minval = 1, maxval = 20, group = gLater)
entTxt = input.string("ENTRY", "Entry label", group = gLater)

// ===================== DASHBOARD =============================================
gDb = "Dashboard"
dbOn = input.bool(true, "Show dashboard", group = gDb)
dbPos = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = gDb)
dbSzIn = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal"], group = gDb)

// ===================== HELPERS ===============================================
f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : size.large

f_lstyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_tpos(string s) =>
    switch s
        "Top left" => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left" => position.bottom_left
        "Middle right" => position.middle_right
        => position.top_right

f_ord(int n) =>
    int r100 = n % 100
    int r10 = n % 10
    string sfx = r100 >= 11 and r100 <= 13 ? "th" : r10 == 1 ? "st" : r10 == 2 ? "nd" : r10 == 3 ? "rd" : "th"
    str.tostring(n) + sfx

f_txt(int n, float px) =>
    switch lblFmt
        "1st Break" => f_ord(n) + " Break"
        "1st" => f_ord(n)
        "1st Break + price" => f_ord(n) + " Break " + str.tostring(math.round_to_mintick(px))
        => str.tostring(n)

f_col(int n) =>
    n == 1 ? cN1 : n == 2 ? cN2 : n == 3 ? cN3 : cNx

f_brkDn(float lvl) =>
    na(lvl) ? false : confMode == "Wick beyond" ? low < lvl : confMode == "Close beyond" ? close < lvl : close < lvl and open < lvl

f_brkUp(float lvl) =>
    na(lvl) ? false : confMode == "Wick beyond" ? high > lvl : confMode == "Close beyond" ? close > lvl : close > lvl and open > lvl

// A level can stand longer than TradingView allows a drawing coordinate to sit
// behind the current bar (~10,000). Only the DRAWING is clamped.
f_xc(int x) =>
    na(x) ? bar_index : math.max(x, bar_index - 4000)

// Index of a standing level within `tol` of p, or -1. A flat consolidation
// prints several fractals a few ticks apart; they are one level, not three.
f_mergeIdx(array<float> a, float p, float tol) =>
    int k = -1
    if array.size(a) > 0 and tol > 0
        for i = 0 to array.size(a) - 1
            if k == -1 and math.abs(array.get(a, i) - p) <= tol
                k := i
    k

atr14 = ta.atr(14)

// ===================== THE LEVELS ============================================
// hi* — every confirmed fractal high nothing has closed above yet.
// lo* — every confirmed fractal low nothing has closed below yet.
// No ordering is assumed: the NEAREST one is the one price reaches first, and
// that is the one that gets numbered first.
var array<float> hiP = array.new<float>()
var array<int> hiB = array.new<int>()
var array<float> loP = array.new<float>()
var array<int> loB = array.new<int>()
var int nUp = 0
var int nDn = 0

var array<line> brkLn = array.new<line>()
var array<label> brkLb = array.new<label>()
var array<line> stkLn = array.new<line>()
var array<label> stkLb = array.new<label>()
var array<label> enLb = array.new<label>()

// fractals read unconditionally so their history stays consistent
float rawPh = ta.pivothigh(pvLen, pvLen)
float rawPl = ta.pivotlow(pvLen, pvLen)
// the closes of the pvLen bars between the fractal bar and now
float maxC = ta.highest(close, pvLen)
float minC = ta.lowest(close, pvLen)

// A new fractal high means the move up topped out. Under the default reset
// that ends the sequence and the next run up starts again at 1st.
bool resetOnTurn = resetMode == "When the move that made them turns"
bool resetOnOther = resetMode == "When the other side breaks"
bool resetOnDone = resetMode == "Only once the Nth is reached"

if not na(rawPh)
    if resetOnTurn
        nUp := 0
    if not dropUsed or maxC < rawPh
        int k = f_mergeIdx(hiP, rawPh, mergeAtr * atr14)
        if k == -1
            array.push(hiP, rawPh)
            array.push(hiB, bar_index - pvLen)
        else if rawPh > array.get(hiP, k)
            array.set(hiP, k, rawPh)
if not na(rawPl)
    if resetOnTurn
        nDn := 0
    if not dropUsed or minC > rawPl
        int k = f_mergeIdx(loP, rawPl, mergeAtr * atr14)
        if k == -1
            array.push(loP, rawPl)
            array.push(loB, bar_index - pvLen)
        else if rawPl < array.get(loP, k)
            array.set(loP, k, rawPl)

while array.size(hiP) > stackMax
    array.shift(hiP)
    array.shift(hiB)
while array.size(loP) > stackMax
    array.shift(loP)
    array.shift(loB)

// ---- which standing level does this bar take, and in what order -------------
// Upward: the LOWEST standing high the bar closes above — that is the one price
// physically reached first. Downward: the highest standing low.
f_nextUp() =>
    int best = -1
    float bp = na
    if array.size(hiP) > 0
        for i = 0 to array.size(hiP) - 1
            float p = array.get(hiP, i)
            if f_brkUp(p) and (best == -1 or p < bp)
                best := i
                bp := p
    best

f_nextDn() =>
    int best = -1
    float bp = na
    if array.size(loP) > 0
        for i = 0 to array.size(loP) - 1
            float p = array.get(loP, i)
            if f_brkDn(p) and (best == -1 or p > bp)
                best := i
                bp := p
    best

// How much structure is still standing beyond a level. This is what separates
// a pullback eating into stacked structure (numbered) from an impulse taking
// out its own last minor high with clear air above it (not numbered).
f_cntAbove(float p) =>
    int n = 0
    if array.size(hiP) > 0
        for i = 0 to array.size(hiP) - 1
            if array.get(hiP, i) > p
                n += 1
    n

f_cntBelow(float p) =>
    int n = 0
    if array.size(loP) > 0
        for i = 0 to array.size(loP) - 1
            if array.get(loP, i) < p
                n += 1
    n

f_prune(array<line> la, array<label> lb, int k) =>
    while array.size(la) > k
        line.delete(array.shift(la))
    while array.size(lb) > k
        label.delete(array.shift(lb))
    array.size(la)

f_mark(int n, float p, int b, bool isLow) =>
    color c = f_col(n)
    int xStart = f_xc(b)
    if lineOn
        array.push(brkLn, line.new(xStart, p, bar_index, p, xloc = xloc.bar_index, color = c, style = f_lstyle(lineStyleIn), width = lineW))
    if lblOn
        float off = atr14 * lblOff
        float yL = isLow ? p - off : p + off
        int xL = lblPos == "Left" ? xStart : lblPos == "Right" ? bar_index : int(math.avg(xStart, bar_index))
        array.push(brkLb, label.new(xL, yL, f_txt(n, p), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = c, size = f_size(lblSzIn)))
    f_prune(brkLn, brkLb, keepN)

f_entry(bool up) =>
    array.push(enLb, label.new(bar_index, close, entTxt, xloc = xloc.bar_index, yloc = yloc.price, style = up ? label.style_label_up : label.style_label_down, color = color.new(up ? #089981 : #F23645, 15), textcolor = color.white, size = f_size(lblSzIn)))
    while array.size(enLb) > keepN
        label.delete(array.shift(enLb))
    array.size(enLb)

// ===================== NUMBER THE BREAKS =====================================
bool evalOk = not waitClose or barstate.isconfirmed
bool firedAny = false
int lastNo = 0
float lastLvl = na
bool lastWasLow = false

if evalOk and upOn
    int gi = f_nextUp()
    while gi >= 0
        float p = array.get(hiP, gi)
        int b = array.get(hiB, gi)
        bool starts = nUp > 0 or needBeyond == 0 or f_cntAbove(p) >= needBeyond
        array.remove(hiP, gi)
        array.remove(hiB, gi)
        if starts
            nUp := nUp + 1
            if capOn and nUp > capN
                break
            firedAny := true
            lastNo := nUp
            lastLvl := p
            lastWasLow := false
            f_mark(nUp, p, b, false)
            if entOn and nUp == entAt
                f_entry(true)
            if resetOnOther
                nDn := 0
            if resetOnDone and capOn and nUp >= capN
                nUp := 0
        gi := f_nextUp()

if evalOk and dnOn
    int gj = f_nextDn()
    while gj >= 0
        float p = array.get(loP, gj)
        int b = array.get(loB, gj)
        bool starts = nDn > 0 or needBeyond == 0 or f_cntBelow(p) >= needBeyond
        array.remove(loP, gj)
        array.remove(loB, gj)
        if starts
            nDn := nDn + 1
            if capOn and nDn > capN
                break
            firedAny := true
            lastNo := nDn
            lastLvl := p
            lastWasLow := true
            f_mark(nDn, p, b, true)
            if entOn and nDn == entAt
                f_entry(false)
            if resetOnOther
                nUp := 0
            if resetOnDone and capOn and nDn >= capN
                nDn := 0
        gj := f_nextDn()

// ===================== WHAT IS STILL STANDING ================================
// Redrawn on the last bar only, numbered 1 · 2 · 3 outward from price. Those
// numbers are a prediction: the one marked 1 is what the next move labels 1st.
if barstate.islast
    while array.size(stkLn) > 0
        line.delete(array.shift(stkLn))
    while array.size(stkLb) > 0
        label.delete(array.shift(stkLb))
    if stackShow
        if upOn and array.size(hiP) > 0
            for i = 0 to array.size(hiP) - 1
                float p = array.get(hiP, i)
                int rank = 1
                for j = 0 to array.size(hiP) - 1
                    if array.get(hiP, j) < p
                        rank += 1
                array.push(stkLn, line.new(f_xc(array.get(hiB, i)), p, bar_index + 4, p, xloc = xloc.bar_index, color = stackHiC, style = line.style_dotted, width = 1))
                if stackTag
                    array.push(stkLb, label.new(bar_index + 5, p, str.tostring(rank), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = stackHiC, size = size.tiny))
        if dnOn and array.size(loP) > 0
            for i = 0 to array.size(loP) - 1
                float p = array.get(loP, i)
                int rank = 1
                for j = 0 to array.size(loP) - 1
                    if array.get(loP, j) > p
                        rank += 1
                array.push(stkLn, line.new(f_xc(array.get(loB, i)), p, bar_index + 4, p, xloc = xloc.bar_index, color = stackLoC, style = line.style_dotted, width = 1))
                if stackTag
                    array.push(stkLb, label.new(bar_index + 5, p, str.tostring(rank), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = stackLoC, size = size.tiny))

// ===================== ALERTS ================================================
alertcondition(firedAny, "Any break", "Basic Breaks — a fractal level was broken")
if firedAny
    alert(f_ord(lastNo) + " Break — " + (lastWasLow ? "fractal low" : "fractal high") + " @ " + str.tostring(math.round_to_mintick(lastLvl)), alert.freq_once_per_bar_close)

// ===================== DASHBOARD =============================================
var table db = table.new(f_tpos(dbPos), 3, 3, border_width = 1)
f_cell(int col, int row, string txt, color c) =>
    table.cell(db, col, row, txt, text_color = c, text_size = f_size(dbSzIn), bgcolor = color.new(color.black, 85))

if dbOn and barstate.islast
    table.clear(db, 0, 0, 2, 2)
    f_cell(0, 0, "BREAKS", color.new(color.white, 0))
    f_cell(1, 0, "standing", color.new(color.gray, 0))
    f_cell(2, 0, "broken", color.new(color.gray, 0))
    f_cell(0, 1, "highs above", color.new(stackHiC, 0))
    f_cell(1, 1, upOn ? str.tostring(array.size(hiP)) : "—", color.new(stackHiC, upOn ? 0 : 60))
    f_cell(2, 1, upOn and nUp > 0 ? f_ord(nUp) : "·", f_col(nUp == 0 ? 4 : nUp))
    f_cell(0, 2, "lows below", color.new(stackLoC, 0))
    f_cell(1, 2, dnOn ? str.tostring(array.size(loP)) : "—", color.new(stackLoC, dnOn ? 0 : 60))
    f_cell(2, 2, dnOn and nDn > 0 ? f_ord(nDn) : "·", f_col(nDn == 0 ? 4 : nDn))
