//@version=6
// =============================================================================
// LIQUIDITY MARKET-STATE ENGINE (LMX) v3
// -----------------------------------------------------------------------------
// A price-action / liquidity / market-structure engine. NOT an indicator wrapper.
// No EMA/RSI/MACD/ADX/Supertrend as the entry engine. ATR is used ONLY for
// volatility normalisation and stop padding (never for direction).
//
// WHY v3 EXISTS (what killed v2):
//   v2 took EVERY sell-side sweep as a long and every buy-side sweep as a short,
//   regardless of premium/discount location or structure. On trending days that
//   is fading the trend -> 20% win rate. v3 fixes DIRECTION:
//     * Longs ONLY from DISCOUNT, ONLY when structure is bullish (BOS/CHoCH up),
//       ONLY after sell-side liquidity is swept & rejected, ONLY toward buy-side.
//     * Shorts are the exact mirror.
//   Trade WITH the draw, from the correct half of the range. That is the edge.
//
// HONESTY (per spec): manually reviewed, NOT machine-compiled here, NOT tester-
// validated. Expected behaviour only. No profit/win-rate claim. Validate in the
// TradingView Strategy Tester before trusting it.
//
// NON-REPAINTING: calc_on_every_tick=false; pivots used only after they confirm;
// PDH/PDL/PWH/PWL via request.security(...,[1],lookahead_off) = previous closed
// period; signal flags set on the confirmed bar; entries fill on later bars.
// =============================================================================

strategy("Liquidity Market-State Engine (LMX) v3", "LMX v3", overlay=true,
     calc_on_every_tick=false, pyramiding=0, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.02,
     slippage=1, max_lines_count=100, max_labels_count=120, max_boxes_count=60)

// =============================================================================
// INPUTS
// =============================================================================
gS = "Structure & Range"
swLen   = input.int(8,  "External swing length", minval=2, group=gS, tooltip="Legs for major swings (BOS/CHoCH, external liquidity, dealing range).")
intLen  = input.int(3,  "Internal swing length", minval=1, group=gS, tooltip="Legs for minor swings (internal liquidity, MSS).")
rngLook = input.int(100,"Range lookback (bars)", minval=20, group=gS)

gD = "Displacement"
bodyPct = input.float(0.6, "Min body / range", minval=0.3, maxval=1.0, step=0.05, group=gD, tooltip="Displacement candle body must be at least this fraction of its range.")
closePct= input.float(0.25,"Close within % of extreme", minval=0.05, maxval=0.5, step=0.05, group=gD, tooltip="Bullish close in the top X of the candle (bearish in the bottom X).")
bodyMult= input.float(1.3, "Body vs avg(10) body x", minval=1.0, step=0.1, group=gD, tooltip="Displacement body must exceed this multiple of the average of the last 10 bodies.")

gL = "Liquidity"
eqTol   = input.float(0.10,"Equal H/L tolerance (x ATR)", minval=0.0, step=0.05, group=gL)
setupWin= input.int(15, "Setup window after sweep (bars)", minval=2, group=gL)

gR = "Entry / Risk / Targets"
slPad   = input.float(0.25,"Stop pad beyond sweep (x ATR)", minval=0.0, step=0.05, group=gR)
minRR   = input.float(2.0, "Minimum RR to draw", minval=1.0, step=0.1, group=gR)
maxRR   = input.float(6.0, "Maximum RR (target must be reachable)", minval=2.0, step=0.5, group=gR)
tp1R    = input.float(1.0, "TP1 (R, partial + breakeven)", minval=0.2, step=0.1, group=gR)
useRun  = input.bool(true, "TP3 runner to external liquidity", group=gR)
tp3R    = input.float(3.0, "TP3 (R) if no external pool", minval=0.5, step=0.1, group=gR)
entryWin= input.int(12, "Cancel unfilled entry after (bars)", minval=1, group=gR)

gSc = "Signal Quality"
tierMode= input.string("A and above", "Trade which tiers", options=["A+ only","A and above","B and above"], group=gSc)

gSe = "Sessions (set tz for your instrument)"
tz      = input.string("GMT","Timezone", group=gSe)
asiaS   = input.session("0000-0700","Asia",  group=gSe)
lonS    = input.session("0700-1200","London",group=gSe)
nyS     = input.session("1200-2000","New York",group=gSe)
kzOnly  = input.bool(false,"Only trade in London/NY", group=gSe)

gP = "Prop-Firm Protection"
maxDay  = input.int(4, "Max trades / day", minval=1, group=gP)
maxSess = input.int(2, "Max trades / session", minval=1, group=gP)
maxLoss = input.float(3.0,"Max daily loss %", minval=0.1, step=0.1, group=gP)
tgtLock = input.float(4.0,"Daily target % (then lock out)", minval=0.1, step=0.1, group=gP)
maxCons = input.int(3, "Max consecutive losses", minval=1, group=gP)
coolLoss= input.int(5, "Cooldown after a loss (bars)", minval=0, group=gP)
useNoTrade = input.bool(false, "Enable restricted no-trade window", group=gP)
noTradeWin = input.session("2200-2300","Restricted no-trade window", group=gP)
friCut  = input.int(24,"Friday cutoff hour (chart tz, 24=off)", minval=0, maxval=24, group=gP)
skipMon = input.bool(false,"Skip Mondays", group=gP)

gV = "Display"
showLiq = input.bool(true, "Plot key liquidity", group=gV)
showZone= input.bool(true, "Show entry zone box", group=gV)
showMark= input.bool(true, "Show sweep/displacement markers", group=gV)
showSig = input.bool(true, "Show entry arrows + labels", group=gV)
showDash= input.bool(true, "Show dashboard", group=gV)
allowL  = input.bool(true, "Allow longs", group=gV)
allowS  = input.bool(true, "Allow shorts", group=gV)

gWh = "Webhook (Notion trade journal)"
whOn     = input.bool(false, "Emit JSON alert() payloads", group=gWh, tooltip="Additive only: builds a JSON message for the webhook relay. Changes no trading logic. Create the alert with condition = 'Any alert() function call'.")
whSecret = input.string("", "Webhook Secret", group=gWh, tooltip="Shared secret checked by the relay Worker (see integrations/notion). Use letters/digits/dashes only; quotes and backslashes are sanitised out of the JSON.")

// =============================================================================
// MODULE 0 — normalisation (ATR only, no direction)
// =============================================================================
atr   = ta.atr(14)
body  = math.abs(close - open)
rng   = high - low
avgBody = ta.sma(body, 10)

// =============================================================================
// MODULE 13 — SESSION ENGINE  (Asia / London / NY frozen highs & lows)
// =============================================================================
inAsia = not na(time(timeframe.period, asiaS, tz))
inLon  = not na(time(timeframe.period, lonS,  tz))
inNY   = not na(time(timeframe.period, nyS,   tz))
inKZ   = inLon or inNY
sessId = inLon ? 2 : inNY ? 3 : inAsia ? 1 : 0

f_sess(bool inS, float hi, float lo) =>
    bool st = inS and not inS[1]
    float h = hi
    float l = lo
    if st
        h := high
        l := low
    else if inS
        h := math.max(nz(hi, high), high)
        l := math.min(nz(lo, low),  low)
    [h, l]

var float asiaHi = na
var float asiaLo = na
var float lonHi  = na
var float lonLo  = na
var float nyHi   = na
var float nyLo   = na
[aH, aL] = f_sess(inAsia, asiaHi, asiaLo)
asiaHi := aH
asiaLo := aL
[lH, lL] = f_sess(inLon, lonHi, lonLo)
lonHi := lH
lonLo := lL
[nH, nL] = f_sess(inNY, nyHi, nyLo)
nyHi := nH
nyLo := nL

newDay = ta.change(time("D")) != 0

// =============================================================================
// MODULE 2 — external HTF liquidity (previous CLOSED day/week -> no repaint)
// =============================================================================
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_off)

// =============================================================================
// MODULE 6 — MARKET STRUCTURE ENGINE (swings, BOS, CHoCH, protected levels)
// =============================================================================
swHi = ta.pivothigh(swLen, swLen)
swLo = ta.pivotlow(swLen, swLen)
inHi = ta.pivothigh(intLen, intLen)
inLo = ta.pivotlow(intLen, intLen)

var float upSwing = na
var float dnSwing = na
var float lastIntHi = na
var float lastIntLo = na
var float nSwHi = na
var float nSwLo = na
if not na(swHi)
    upSwing := swHi
    nSwHi   := swHi
if not na(swLo)
    dnSwing := swLo
    nSwLo   := swLo
if not na(inHi)
    lastIntHi := inHi
if not na(inLo)
    lastIntLo := inLo

// BOS = break of the last external swing in the trend direction; CHoCH = a BOS
// that flips the current structural state. Protected level = the swing that
// must hold for the new state to remain valid.
var int   structState = 0
var float protLow  = na
var float protHigh = na
bosUp = not na(upSwing) and close > upSwing and close[1] <= upSwing
bosDn = not na(dnSwing) and close < dnSwing and close[1] >= dnSwing
chochUp = bosUp and structState <= 0
chochDn = bosDn and structState >= 0
if bosUp
    structState := 1
    protLow := dnSwing
if bosDn
    structState := -1
    protHigh := upSwing
if structState == 1 and not na(protLow) and close < protLow
    structState := 0
if structState == -1 and not na(protHigh) and close > protHigh
    structState := 0

// =============================================================================
// MODULE 1 — DEALING RANGE (premium / discount / equilibrium)
// =============================================================================
rngHi = ta.highest(high, rngLook)
rngLo = ta.lowest(low,  rngLook)
eqm   = (rngHi + rngLo) / 2.0
posInRange = rngHi != rngLo ? (close - rngLo) / (rngHi - rngLo) : 0.5
premium  = close > eqm
discount = close < eqm

// =============================================================================
// MODULE 2 (cont) — equal highs / lows
// =============================================================================
var float eqHigh = na
var float eqLow  = na
if not na(swHi) and not na(upSwing[1]) and math.abs(swHi - upSwing[1]) <= eqTol * atr
    eqHigh := math.max(swHi, upSwing[1])
if not na(swLo) and not na(dnSwing[1]) and math.abs(swLo - dnSwing[1]) <= eqTol * atr
    eqLow := math.min(swLo, dnSwing[1])

// =============================================================================
// MODULE 2 (cont) — build buy-side / sell-side liquidity maps
// =============================================================================
f_push(array<float> a, float v) =>
    if not na(v)
        array.push(a, v)

buySide  = array.new_float()
sellSide = array.new_float()
f_push(buySide, pdh)
f_push(buySide, pwh)
f_push(buySide, asiaHi)
f_push(buySide, lonHi)
f_push(buySide, nyHi)
f_push(buySide, nSwHi)
f_push(buySide, eqHigh)
f_push(sellSide, pdl)
f_push(sellSide, pwl)
f_push(sellSide, asiaLo)
f_push(sellSide, lonLo)
f_push(sellSide, nyLo)
f_push(sellSide, nSwLo)
f_push(sellSide, eqLow)

f_nearAbove(array<float> a, float px) =>
    float b = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if not na(v) and v > px and (na(b) or v < b)
                b := v
    b
f_nearBelow(array<float> a, float px) =>
    float b = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if not na(v) and v < px and (na(b) or v > b)
                b := v
    b
f_tgtAbove(array<float> a, float lo, float hi) =>
    float b = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if not na(v) and v >= lo and v <= hi and (na(b) or v < b)
                b := v
    b
f_tgtBelow(array<float> a, float hi, float lo) =>
    float b = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if not na(v) and v <= hi and v >= lo and (na(b) or v > b)
                b := v
    b

nearBuy  = f_nearAbove(buySide,  close)
nearSell = f_nearBelow(sellSide, close)

// =============================================================================
// MODULE 3 — DRAW ON LIQUIDITY (where price is likely headed)
// =============================================================================
drawDir = structState == 1 and not na(nearBuy) ? 1 :
         structState == -1 and not na(nearSell) ? -1 :
         na(nearBuy) and na(nearSell) ? 0 :
         na(nearBuy) ? -1 :
         na(nearSell) ? 1 :
         (nearBuy - close) < (close - nearSell) ? 1 : -1
drawLevel = drawDir == 1 ? nearBuy : drawDir == -1 ? nearSell : na
drawExt   = not na(drawLevel) and (drawLevel == pdh or drawLevel == pwh or drawLevel == pdl or drawLevel == pwl)

// =============================================================================
// MODULE 4 — LIQUIDITY SWEEP ENGINE  (wick sweep + rejection close)
// =============================================================================
sweptSell = false
if array.size(sellSide) > 0
    for i = 0 to array.size(sellSide) - 1
        lv = array.get(sellSide, i)
        if not na(lv) and low < lv and close > lv and close > open
            sweptSell := true
sweptBuy = false
if array.size(buySide) > 0
    for i = 0 to array.size(buySide) - 1
        lv = array.get(buySide, i)
        if not na(lv) and high > lv and close < lv and close < open
            sweptBuy := true
sweptSellExt = (not na(pdl) and low < pdl and close > pdl) or (not na(pwl) and low < pwl and close > pwl) or (not na(asiaLo) and not inAsia and low < asiaLo and close > asiaLo)
sweptBuyExt  = (not na(pdh) and high > pdh and close < pdh) or (not na(pwh) and high > pwh and close < pwh) or (not na(asiaHi) and not inAsia and high > asiaHi and close < asiaHi)

// =============================================================================
// MODULE 5 — DISPLACEMENT ENGINE  (strict candle criteria + breaks internal)
// =============================================================================
bullDisp = close > open and rng > 0 and body >= bodyPct * rng and close >= high - closePct * rng and body > bodyMult * avgBody and not na(lastIntHi) and close > lastIntHi
bearDisp = close < open and rng > 0 and body >= bodyPct * rng and close <= low + closePct * rng and body > bodyMult * avgBody and not na(lastIntLo) and close < lastIntLo

// =============================================================================
// MODULES 4-7 — SEQUENCE STATE MACHINE (sweep -> displacement -> structure)
// =============================================================================
var bool  Lraid = false
var int   Lbar  = na
var float Lsweep = na
var bool  Lext  = false
var bool  Ldisp = false
var float LdispHi = na
var bool  Sraid = false
var int   Sbar  = na
var float Ssweep = na
var bool  Sext  = false
var bool  Sdisp = false
var float SdispLo = na

if sweptSell and discount
    Lraid := true
    Lbar := bar_index
    Lsweep := low
    Lext := sweptSellExt
    Ldisp := false
    LdispHi := na
if Lraid and bar_index - Lbar > setupWin
    Lraid := false
if Lraid and bullDisp
    Ldisp := true
    LdispHi := math.max(nz(LdispHi, high), high)

if sweptBuy and premium
    Sraid := true
    Sbar := bar_index
    Ssweep := high
    Sext := sweptBuyExt
    Sdisp := false
    SdispLo := na
if Sraid and bar_index - Sbar > setupWin
    Sraid := false
if Sraid and bearDisp
    Sdisp := true
    SdispLo := math.min(nz(SdispLo, low), low)

// =============================================================================
// MODULE 14 — PROP-FIRM PROTECTION bookkeeping
// =============================================================================
var float dayEq = na
var int tradesDay = 0
var int tradesSess = 0
var int consecLoss = 0
var int coolUntil = 0
var bool lock = false
var int curSess = 0
if newDay
    dayEq := strategy.equity
    tradesDay := 0
    lock := false
if sessId != curSess
    curSess := sessId
    tradesSess := 0
dayPnl = na(dayEq) or dayEq == 0 ? 0.0 : (strategy.equity - dayEq) / dayEq * 100.0
if dayPnl <= -maxLoss or dayPnl >= tgtLock or consecLoss >= maxCons
    lock := true

inNoTrade = useNoTrade and not na(time(timeframe.period, noTradeWin, tz))
friBlock  = friCut < 24 and dayofweek == dayofweek.friday and hour >= friCut
monBlock  = skipMon and dayofweek == dayofweek.monday
timeOK = not inNoTrade and not friBlock and not monBlock and (not kzOnly or inKZ)

riskOK = tradesDay < maxDay and tradesSess < maxSess and not lock and bar_index >= coolUntil and timeOK

// =============================================================================
// MODULES 7-10 — SETUP ASSEMBLY, ENTRY ZONE, RR GATE, QUALITY SCORE
// =============================================================================
flat = strategy.position_size == 0
longTrig  = allowL and Lraid and Ldisp and structState == 1 and discount
shortTrig = allowS and Sraid and Sdisp and structState == -1 and premium

var int    pDir = 0
var float  pEntry = na
var float  pSL = na
var float  pTP1 = na
var float  pTP2 = na
var float  pTP3 = na
var int    pExp = na
var float  pScore = 0.0
var string pReason = ""
var string pTier = ""

bool sigL = false
bool sigS = false

f_score(bool sweepClean, bool drawClear, float dispLeg, bool mss, bool pdLoc, bool sess, float rr) =>
    float s = 0.0
    s += sweepClean ? 20.0 : 10.0
    s += drawClear ? 20.0 : 8.0
    s += math.min(20.0, dispLeg / atr * 10.0)
    s += mss ? 15.0 : 0.0
    s += pdLoc ? 10.0 : 3.0
    s += sess ? 10.0 : 4.0
    s += rr >= 3.0 ? 5.0 : rr >= 2.0 ? 3.0 : 0.0
    math.round(math.min(100.0, s))

f_minScore(string m) =>
    m == "A+ only" ? 85 : m == "A and above" ? 75 : 65

if flat and pDir == 0 and riskOK and longTrig
    entry = (Lsweep + LdispHi) / 2.0
    sl    = Lsweep - slPad * atr
    risk  = entry - sl
    if risk > 0 and entry <= eqm
        tgt = f_tgtAbove(buySide, entry + minRR * risk, entry + maxRR * risk)
        if not na(tgt)
            rr = (tgt - entry) / risk
            sc = f_score(Lext, drawDir == 1, LdispHi - Lsweep, structState == 1, discount, inKZ, rr)
            tier = sc >= 85 ? "A+" : sc >= 75 ? "A" : sc >= 65 ? "B" : "-"
            if sc >= f_minScore(tierMode)
                pDir := 1
                pEntry := entry
                pSL := sl
                pTP1 := entry + risk * tp1R
                pTP2 := tgt
                pTP3 := useRun ? nz(f_tgtAbove(buySide, tgt + syminfo.mintick, entry + (maxRR + 3) * risk), entry + risk * tp3R) : na
                pExp := bar_index + entryWin
                pScore := sc
                pTier := tier
                pReason := "LONG " + tier + ": SSL swept + bullish displacement + MSS + discount -> draw BSL @ " + str.tostring(tgt, format.mintick)
                sigL := true
                Lraid := false
                strategy.entry("Long", strategy.long, limit=entry)

if flat and pDir == 0 and riskOK and shortTrig
    entry = (Ssweep + SdispLo) / 2.0
    sl    = Ssweep + slPad * atr
    risk  = sl - entry
    if risk > 0 and entry >= eqm
        tgt = f_tgtBelow(sellSide, entry - minRR * risk, entry - maxRR * risk)
        if not na(tgt)
            rr = (entry - tgt) / risk
            sc = f_score(Sext, drawDir == -1, Ssweep - SdispLo, structState == -1, premium, inKZ, rr)
            tier = sc >= 85 ? "A+" : sc >= 75 ? "A" : sc >= 65 ? "B" : "-"
            if sc >= f_minScore(tierMode)
                pDir := -1
                pEntry := entry
                pSL := sl
                pTP1 := entry - risk * tp1R
                pTP2 := tgt
                pTP3 := useRun ? nz(f_tgtBelow(sellSide, tgt - syminfo.mintick, entry - (maxRR + 3) * risk), entry - risk * tp3R) : na
                pExp := bar_index + entryWin
                pScore := sc
                pTier := tier
                pReason := "SHORT " + tier + ": BSL swept + bearish displacement + MSS + premium -> draw SSL @ " + str.tostring(tgt, format.mintick)
                sigS := true
                Sraid := false
                strategy.entry("Short", strategy.short, limit=entry)

// =============================================================================
// ORDER / POSITION MANAGEMENT  (Modules 8-9 + duplicate control)
// =============================================================================
inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0
var int tDir = 0
var bool tp1Done = false
var float entryEq = na
newL = inLong  and tDir != 1
newS = inShort and tDir != -1
if newL
    tDir := 1
    tp1Done := false
    entryEq := strategy.equity
    tradesDay := tradesDay + 1
    tradesSess := tradesSess + 1
if newS
    tDir := -1
    tp1Done := false
    entryEq := strategy.equity
    tradesDay := tradesDay + 1
    tradesSess := tradesSess + 1

if inLong and not tp1Done and not na(pTP1) and high >= pTP1
    tp1Done := true
    pSL := math.max(pSL, pEntry)
if inShort and not tp1Done and not na(pTP1) and low <= pTP1
    tp1Done := true
    pSL := math.min(pSL, pEntry)

if inLong
    strategy.exit("L1", "Long", qty_percent=50, limit=pTP1, stop=pSL)
    if useRun and not na(pTP3)
        strategy.exit("L2", "Long", qty_percent=50, limit=pTP2, stop=pSL)
        strategy.exit("L3", "Long", limit=pTP3, stop=pSL)
    else
        strategy.exit("L2", "Long", limit=pTP2, stop=pSL)
if inShort
    strategy.exit("S1", "Short", qty_percent=50, limit=pTP1, stop=pSL)
    if useRun and not na(pTP3)
        strategy.exit("S2", "Short", qty_percent=50, limit=pTP2, stop=pSL)
        strategy.exit("S3", "Short", limit=pTP3, stop=pSL)
    else
        strategy.exit("S2", "Short", limit=pTP2, stop=pSL)

Linval = pDir == 1  and flat and (bar_index > pExp or low  < pSL)
Sinval = pDir == -1 and flat and (bar_index > pExp or high > pSL)
if Linval
    strategy.cancel("Long")
if Sinval
    strategy.cancel("Short")

exitedL = tDir == 1  and flat
exitedS = tDir == -1 and flat

// consecutive-loss / cooldown tracking, per SETUP (measured entry->flat equity)
justFlat = flat and not flat[1]
if justFlat
    win = strategy.equity > nz(entryEq, strategy.equity)
    if win
        consecLoss := 0
    else
        consecLoss := consecLoss + 1
        coolUntil := bar_index + coolLoss

if flat and (exitedL or exitedS or Linval or Sinval)
    pDir := 0
    pEntry := na
    pSL := na
    pTP1 := na
    pTP2 := na
    pTP3 := na
    pExp := na
    tDir := 0
    tp1Done := false

// =============================================================================
// MODULE 16 — VISUALS (clean: key pools, hidden once swept; active setup only)
// =============================================================================
pdhT = not na(pdh) and high > pdh
pdlT = not na(pdl) and low  < pdl
plot(showLiq and not pdhT ? pdh : na, "PDH", color.new(color.red,40),   style=plot.style_linebr)
plot(showLiq and not pdlT ? pdl : na, "PDL", color.new(color.green,40), style=plot.style_linebr)
plot(showLiq ? pwh : na, "PWH", color.new(color.maroon,30), style=plot.style_linebr, linewidth=2)
plot(showLiq ? pwl : na, "PWL", color.new(color.teal,30),   style=plot.style_linebr, linewidth=2)
plot(showLiq and not na(nearBuy)  ? nearBuy  : na, "Nearest BSL", color.new(color.red,0),   style=plot.style_linebr)
plot(showLiq and not na(nearSell) ? nearSell : na, "Nearest SSL", color.new(color.green,0), style=plot.style_linebr)
plot(showLiq ? eqm : na, "Equilibrium", color.new(color.gray,60), style=plot.style_linebr)

plotshape(showMark and sweptSell and discount, "SSL sweep", shape.triangleup,   location.belowbar, color.new(color.blue,0),   size=size.tiny)
plotshape(showMark and sweptBuy  and premium,  "BSL sweep", shape.triangledown, location.abovebar, color.new(color.orange,0), size=size.tiny)
plotchar(showMark and bullDisp, "Bull displacement", "▲", location.belowbar, color.new(color.green,20), size=size.tiny)
plotchar(showMark and bearDisp, "Bear displacement", "▼", location.abovebar, color.new(color.red,20),   size=size.tiny)
plotchar(showMark and chochUp, "CHoCH up", "C", location.belowbar, color.new(color.aqua,0),    size=size.tiny)
plotchar(showMark and chochDn, "CHoCH down", "C", location.abovebar, color.new(color.fuchsia,0), size=size.tiny)

plot(tDir != 0 ? pSL  : na, "SL",  color.new(color.red,0),   style=plot.style_linebr, linewidth=2)
plot(tDir != 0 ? pTP1 : na, "TP1", color.new(color.teal,0),  style=plot.style_linebr)
plot(tDir != 0 ? pTP2 : na, "TP2", color.new(color.green,0), style=plot.style_linebr)
plot(tDir != 0 and useRun ? pTP3 : na, "TP3", color.new(color.lime,0), style=plot.style_linebr)

var box zoneBox = na
if showZone and pDir != 0 and na(zoneBox)
    zt = pDir == 1 ? pEntry : pSL
    zb = pDir == 1 ? pSL : pEntry
    zoneBox := box.new(bar_index, math.max(zt, zb), bar_index + entryWin, math.min(zt, zb), border_color=color.new(color.blue,50), bgcolor=color.new(color.blue,88))
if pDir == 0 and not na(zoneBox)
    box.delete(zoneBox)
    zoneBox := na

plotshape(showSig and sigL, "Long", shape.labelup,   location.belowbar, color.new(color.green,0), text="LONG", textcolor=color.white, size=size.small)
plotshape(showSig and sigS, "Short", shape.labeldown, location.abovebar, color.new(color.red,0),   text="SHORT", textcolor=color.white, size=size.small)
if showSig and (sigL or sigS)
    label.new(bar_index, sigL ? low : high, pReason, yloc=sigL ? yloc.belowbar : yloc.abovebar, style=sigL ? label.style_label_up : label.style_label_down, color=sigL ? color.new(color.green,25) : color.new(color.red,25), textcolor=color.white, size=size.small)

// =============================================================================
// MODULE 15 — DASHBOARD
// =============================================================================
structTxt = structState == 1 ? "BULLISH" : structState == -1 ? "BEARISH" : "RANGING"
structCol = structState == 1 ? color.lime : structState == -1 ? color.red : color.gray
drawTxt = drawDir == 1 ? "BUY-SIDE" : drawDir == -1 ? "SELL-SIDE" : "NEUTRAL"
pdTxt = premium ? "PREMIUM" : discount ? "DISCOUNT" : "EQ"
sessTxt = inLon ? "LONDON" : inNY ? "NEW YORK" : inAsia ? "ASIA" : "OFF"
sweptTxt = (pdhT?"PDH ":"") + (pdlT?"PDL ":"") + (not na(asiaHi) and not inAsia and high>asiaHi?"AsiaH ":"") + (not na(asiaLo) and not inAsia and low<asiaLo?"AsiaL ":"")
sweptTxt := sweptTxt == "" ? "none yet" : sweptTxt
posTxt = tDir == 1 ? "LONG" : tDir == -1 ? "SHORT" : pDir != 0 ? "PENDING" : "FLAT"
posCol = tDir == 1 ? color.lime : tDir == -1 ? color.red : pDir != 0 ? color.orange : color.gray
distDraw = na(drawLevel) ? na : math.abs(drawLevel - close)
liveRR = pDir == 1 and (pEntry-pSL) > 0 ? (pTP2-pEntry)/(pEntry-pSL) : pDir == -1 and (pSL-pEntry) > 0 ? (pEntry-pTP2)/(pSL-pEntry) : na
wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na

var table d = table.new(position.top_right, 2, 18, border_width=1, frame_color=color.new(color.gray,50), frame_width=1)
f_c(int r, string k, string v, color vc) =>
    table.cell(d, 0, r, k, text_color=color.silver, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.black,70))
    table.cell(d, 1, r, v, text_color=vc, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(color.black,70))
if showDash and barstate.islast
    table.cell(d, 0, 0, "LMX v3", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.blue,30))
    table.cell(d, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue,30))
    f_c(1,  "Structure", structTxt, structCol)
    f_c(2,  "Draw", drawTxt + (na(drawLevel)?"":(drawExt?" (ext)":" (int)")), drawDir==1?color.lime:drawDir==-1?color.red:color.gray)
    f_c(3,  "Draw level", na(drawLevel)?"-":str.tostring(drawLevel, format.mintick), color.white)
    f_c(4,  "Dist to draw", na(distDraw)?"-":str.tostring(distDraw, format.mintick), color.white)
    f_c(5,  "Nearest BSL", na(nearBuy)?"-":str.tostring(nearBuy, format.mintick), color.red)
    f_c(6,  "Nearest SSL", na(nearSell)?"-":str.tostring(nearSell, format.mintick), color.green)
    f_c(7,  "Swept today", sweptTxt, color.orange)
    f_c(8,  "Range Lo-Hi", str.tostring(rngLo, format.mintick)+" - "+str.tostring(rngHi, format.mintick), color.white)
    f_c(9,  "Zone", pdTxt+" ("+str.tostring(posInRange*100, "#")+"%)", premium?color.red:discount?color.lime:color.gray)
    f_c(10, "Session", sessTxt, inKZ?color.lime:color.gray)
    f_c(11, "Setup", pDir!=0?(pTier+" "+str.tostring(pScore,"#")):"-", pScore>=85?color.lime:pScore>=75?color.aqua:pScore>=65?color.orange:color.gray)
    f_c(12, "Expected RR", na(liveRR)?"-":str.tostring(liveRR,"#.##"), na(liveRR)?color.gray:liveRR>=minRR?color.lime:color.red)
    f_c(13, "Position", posTxt, posCol)
    f_c(14, "Trades D/S", str.tostring(tradesDay)+"/"+str.tostring(maxDay)+"  "+str.tostring(tradesSess)+"/"+str.tostring(maxSess), color.white)
    f_c(15, "Day PnL %", str.tostring(dayPnl,"#.##")+(lock?"  LOCK":""), lock?color.red:dayPnl>=0?color.lime:color.red)
    f_c(16, "Win% / PF", (na(wr)?"-":str.tostring(wr,"#.#"))+" / "+(na(pf)?"-":str.tostring(pf,"#.##")), color.white)
    f_c(17, "Consec loss", str.tostring(consecLoss)+"/"+str.tostring(maxCons), consecLoss>=maxCons?color.red:color.white)

// =============================================================================
// MODULE 17 — ALERTS
// =============================================================================
alertcondition(sigL, "LMX Long Entry",  "LMX LONG {{ticker}} {{interval}}: SSL swept + displacement + MSS in discount -> BSL draw")
alertcondition(sigS, "LMX Short Entry", "LMX SHORT {{ticker}} {{interval}}: BSL swept + displacement + MSS in premium -> SSL draw")
alertcondition(sweptSell and discount, "LMX SSL Swept", "LMX sell-side liquidity swept {{ticker}} {{interval}}")
alertcondition(sweptBuy and premium,   "LMX BSL Swept", "LMX buy-side liquidity swept {{ticker}} {{interval}}")
alertcondition(bullDisp, "LMX Bull Displacement", "LMX bullish displacement {{ticker}} {{interval}}")
alertcondition(bearDisp, "LMX Bear Displacement", "LMX bearish displacement {{ticker}} {{interval}}")
alertcondition(exitedL, "LMX Long Closed",  "LMX long closed {{ticker}} {{interval}}")
alertcondition(exitedS, "LMX Short Closed", "LMX short closed {{ticker}} {{interval}}")
alertcondition(lock, "LMX Daily Lockout", "LMX daily risk lockout {{ticker}} {{interval}}")
alertcondition(sigL or sigS, "LMX Any Entry", "LMX entry {{ticker}} {{interval}}")

// =============================================================================
// MODULE 17b — WEBHOOK PAYLOAD (JSON for the Notion trade journal)
// -----------------------------------------------------------------------------
// PURELY ADDITIVE. This module reads existing signal flags and emits alert()
// messages next to the alertcondition()s above. It sets no state, places no
// order, and changes no threshold — remove it and the strategy behaves exactly
// as before. It is off until you tick "Emit JSON alert() payloads" in the
// Webhook input group.
//
// Pine is sandboxed and cannot call an HTTP API, so the JSON leaves as an alert
// message: strategy -> TradingView webhook -> relay Worker -> Notion.
// The contract lives in integrations/notion/src/payload.js; the setup guide in
// integrations/notion/README.md.
//
// The alertcondition() strings above are compile-time constants and cannot hold
// series values, which is why the payload has to go through alert(). In
// TradingView create the alert with condition = "Any alert() function call".
// =============================================================================

// Pine has no JSON encoder. Rather than emit backslash escapes (easy to get
// wrong by hand, unreadable in the alert log) the text is SANITISED: a double
// quote becomes a single quote and a backslash becomes a forward slash, so the
// result never needs an escape sequence at all.
f_jsonSafe(string s) =>
    string a = str.replace_all(s, "\\", "/")
    str.replace_all(a, '"', "'")

// ,"key":value — emitted only when the value exists, so an absent field is
// genuinely absent rather than null (Notion rejects null on typed properties).
// Fixed-point format so prices never come out in scientific notation.
f_jsonNum(string k, float v) =>
    na(v) ? "" : ',"' + k + '":' + str.tostring(v, "#.#####")

// ,"key":"value" — same rule, plus sanitising. Empty string means absent.
f_jsonStr(string k, string v) =>
    str.length(v) == 0 ? "" : ',"' + k + '":"' + f_jsonSafe(v) + '"'

// One payload builder for every event, so the JSON shape can only be wrong in
// one place. Optional numerics are passed as na when the event has no such
// level (an exit knows the fill price, not the original entry/stop/target).
f_payload(string ev, string dir, float px, float en, float sl, float tg, float q, string nt) =>
    string j = '{"event":"' + f_jsonSafe(ev) + '"'
    j := j + f_jsonStr("secret", whSecret)
    j := j + ',"symbol":"' + f_jsonSafe(syminfo.tickerid) + '"'
    j := j + ',"timeframe":"' + f_jsonSafe(timeframe.period) + '"'
    j := j + ',"direction":"' + dir + '"'
    j := j + ',"price":' + str.tostring(px, "#.#####")
    j := j + f_jsonNum("entry", en)
    j := j + f_jsonNum("stop", sl)
    j := j + f_jsonNum("target", tg)
    j := j + f_jsonNum("quality", q)
    j := j + f_jsonStr("session", sessTxt)
    j := j + f_jsonStr("note", nt)
    j := j + ',"time":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "GMT") + '"'
    j + "}"

// Entries: the full setup is known here (pEntry/pSL/pTP2/pScore were just set).
if whOn and sigL
    alert(f_payload("entry", "long", close, pEntry, pSL, pTP2, pScore, pReason), alert.freq_once_per_bar_close)
if whOn and sigS
    alert(f_payload("entry", "short", close, pEntry, pSL, pTP2, pScore, pReason), alert.freq_once_per_bar_close)

// Exits: the setup has already been cleared above, so only the price is sent.
if whOn and exitedL
    alert(f_payload("exit", "long", close, na, na, na, na, "LMX long closed"), alert.freq_once_per_bar_close)
if whOn and exitedS
    alert(f_payload("exit", "short", close, na, na, na, na, "LMX short closed"), alert.freq_once_per_bar_close)

// Sweeps: journalled with the direction they imply, not a position direction.
if whOn and sweptSell and discount
    alert(f_payload("sweep", "long", close, na, na, na, na, "LMX sell-side liquidity swept in discount"), alert.freq_once_per_bar_close)
if whOn and sweptBuy and premium
    alert(f_payload("sweep", "short", close, na, na, na, na, "LMX buy-side liquidity swept in premium"), alert.freq_once_per_bar_close)
