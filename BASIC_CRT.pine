//@version=6
// =============================================================================
// BASIC CRT  —  Candle Range Theory range marker
// -----------------------------------------------------------------------------
// Marks the High / Low / 50% equilibrium of each closed candle on a chosen
// timeframe (default 4H) as a projected range.
//
//   * A NEW range is anchored on every closed HTF candle (candle 1 of a CRT set)
//     and projects right for "Keep range live for N candles" (default 3), i.e.
//     it stays live until the 3rd candle of the set closes. Ranges overlap by
//     design — that is normal CRT.
//   * The CURRENT (newest) range is drawn in colour and labelled CRT High / Low.
//   * The PREVIOUS range is greyed out and can be toggled off independently.
//   * HISTORICAL ranges are hidden by default and can be enabled in settings.
//   * 50% equilibrium is drawn as a dotted line; its label shows the range size.
//
// Label designs (Filled / Ghost / Tinted / Chip) all anchor at the END of each
// line with text to the right — never overlapping. Colours, price on/off, short
// names, and EQ units are all configurable.
//
// Non-repainting: ranges are built only from CLOSED HTF candles
// (request.security on high[1]/low[1]/time[1] with lookahead_off).
// =============================================================================
indicator("Basic CRT", overlay=true, max_lines_count=500, max_labels_count=100)

// ------------------------------- INPUTS --------------------------------------
tfIn   = input.timeframe("240", "Range timeframe", tooltip="Which candle defines each range. 240 = 4H.")
liveN  = input.int(3, "Keep range live for N candles", minval=1, tooltip="A range projects right for this many candles. 3 = classic CRT — it stays live until the 3rd candle closes.")

gVis   = "Visibility"
showPrev = input.bool(true,  "Show previous range", group=gVis, tooltip="The range immediately before the current one. Independent of the historical toggle.")
showHist = input.bool(false, "Show historical ranges", group=gVis, tooltip="Every range older than 'previous'. Off by default.")
maxHist  = input.int(20, "Max historical ranges kept", minval=1, maxval=200, group=gVis)

gCol   = "Lines — Colours & Style"
curCol   = input.color(color.new(#2962FF, 0),  "Current range", group=gCol)
prevCol  = input.color(color.new(color.gray, 0),  "Previous range", group=gCol)
histCol  = input.color(color.new(color.gray, 55), "Historical range", group=gCol)
showEqLn = input.bool(true, "Show equilibrium line", group=gCol)
eqLnCol  = input.color(color.new(#FF6D00, 40), "Equilibrium line", group=gCol)
lw       = input.int(2, "Line width", minval=1, maxval=4, group=gCol)

gLab   = "Labels"
labDesign = input.string("Filled", "Label design", options=["Filled","Ghost","Tinted","Chip"], group=gLab, tooltip="All designs sit at the END of the line, text to the right. Filled = solid tab (most visible). Ghost = coloured text only. Tinted = soft translucent badge. Chip = clean tab matching the chart background.")
showHL    = input.bool(true,  "Show High / Low labels", group=gLab)
shortHL   = input.bool(false, "Short names (CRT H / CRT L)", group=gLab)
showPx    = input.bool(true,  "Show price in High / Low labels", group=gLab)
labSz     = input.string("Small", "Label size", options=["Tiny","Small","Normal"], group=gLab)

gLabC  = "Labels — Colours"
hlLabCol  = input.color(color.new(#2962FF, 0), "High / Low label", group=gLabC)
eqLabCol  = input.color(color.new(color.black, 0), "EQ label", group=gLabC)
labTxtCol = input.color(color.white, "Label text colour", group=gLabC)

gEq    = "Equilibrium label"
showEqLab = input.bool(true,  "Show EQ label", group=gEq)
showEqPx  = input.bool(false, "Include EQ price", group=gEq)
showSize  = input.bool(true,  "Show range size (PTS)", group=gEq)
pointSize = input.float(0.0, "Price per point (0 = auto min-tick)", minval=0, step=0.001, group=gEq, tooltip="Value of 1 'point'. 0 = symbol min tick. e.g. 0.01 = cents.")
brUnit    = input.string("Pips", "Bracket unit", options=["Pips","Ticks","Price","None"], group=gEq)
pipSize   = input.float(0.0, "Price per pip (0 = auto)", minval=0, step=0.0001, group=gEq, tooltip="Value of 1 pip for the bracket. 0 = auto (10x min tick).")

// ------------------------------- HELPERS -------------------------------------
f_lsz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

// Every design uses style_label_left so the label ALWAYS anchors at the end of
// the line with its text to the right (never overlapping). Only the fill/text
// colour changes between designs, so alignment is identical across all of them.
mkLabel(int x, float y, string txt, string design, color mainCol, color txtCol, string szStr) =>
    bg = design == "Ghost"  ? color.new(color.gray, 100) : design == "Tinted" ? color.new(mainCol, 70) : design == "Chip" ? chart.bg_color : mainCol
    tc = design == "Filled" ? txtCol : mainCol
    label.new(x, y, txt, xloc=xloc.bar_time, style=label.style_label_left, color=bg, textcolor=tc, size=f_lsz(szStr))

// --------------------- HTF DATA (previous CLOSED candle) ---------------------
cHigh  = request.security(syminfo.tickerid, tfIn, high[1], lookahead=barmerge.lookahead_off)
cLow   = request.security(syminfo.tickerid, tfIn, low[1],  lookahead=barmerge.lookahead_off)
cOpenT = request.security(syminfo.tickerid, tfIn, time[1], lookahead=barmerge.lookahead_off)
tfMs   = timeframe.in_seconds(tfIn) * 1000

// ------------------------------- STORAGE -------------------------------------
var array<line> hiA = array.new<line>()
var array<line> loA = array.new<line>()
var array<line> eqA = array.new<line>()
var label labHi = na
var label labLo = na
var label labEq = na
HIDE = color.new(color.gray, 100)   // fully transparent = hidden

// A new closed HTF candle appears when its open time changes.
newClosed = not na(cHigh) and not na(cOpenT) and (na(cOpenT[1]) or cOpenT != cOpenT[1])

if newClosed
    startT = cOpenT
    endT   = cOpenT + liveN * tfMs
    eqv    = (cHigh + cLow) / 2.0
    rangePx = cHigh - cLow

    // ---- draw the new (current) range lines ----
    lh = line.new(startT, cHigh, endT, cHigh, xloc=xloc.bar_time, color=curCol, width=lw)
    ll = line.new(startT, cLow,  endT, cLow,  xloc=xloc.bar_time, color=curCol, width=lw)
    le = showEqLn ? line.new(startT, eqv, endT, eqv, xloc=xloc.bar_time, color=eqLnCol, width=1, style=line.style_dotted) : na
    array.push(hiA, lh)
    array.push(loA, ll)
    array.push(eqA, le)

    // ---- build label texts ----
    hiName = shortHL ? "CRT H" : "CRT High"
    loName = shortHL ? "CRT L" : "CRT Low"
    hiTxt  = hiName + (showPx ? " " + str.tostring(cHigh, format.mintick) : "")
    loTxt  = loName + (showPx ? " " + str.tostring(cLow,  format.mintick) : "")

    ptSz  = pointSize > 0 ? pointSize : syminfo.mintick
    ppSz  = pipSize   > 0 ? pipSize   : syminfo.mintick * 10
    ptsN  = math.round(rangePx / ptSz)
    brNum = brUnit == "Pips" ? math.round(rangePx / ppSz) : brUnit == "Ticks" ? math.round(rangePx / syminfo.mintick) : na
    brStr = brUnit == "None" ? "" : brUnit == "Price" ? "(" + str.tostring(rangePx, format.mintick) + ")" : "(" + str.tostring(brNum, "#") + " " + (brUnit == "Pips" ? "pips" : "ticks") + ")"
    eqTxt = "EQ" + (showEqPx ? " " + str.tostring(eqv, format.mintick) : "") + (showSize ? "  " + str.tostring(ptsN, "#") + " PTS" : "") + (brStr == "" ? "" : "  " + brStr)

    // ---- labels live only on the CURRENT range: delete old, make new ----
    if not na(labHi)
        label.delete(labHi)
    if not na(labLo)
        label.delete(labLo)
    if not na(labEq)
        label.delete(labEq)
    labHi := showHL    ? mkLabel(endT, cHigh, hiTxt, labDesign, hlLabCol, labTxtCol, labSz) : na
    labLo := showHL    ? mkLabel(endT, cLow,  loTxt, labDesign, hlLabCol, labTxtCol, labSz) : na
    labEq := showEqLab ? mkLabel(endT, eqv,   eqTxt, labDesign, eqLabCol, labTxtCol, labSz) : na

    // ---- recolour every range by age: 0 = current, 1 = previous, >=2 = historical
    n = array.size(hiA)
    for i = 0 to n - 1
        age = n - 1 - i
        col = age == 0 ? curCol : age == 1 ? (showPrev ? prevCol : HIDE) : (showHist ? histCol : HIDE)
        line.set_color(array.get(hiA, i), col)
        line.set_color(array.get(loA, i), col)
        lex = array.get(eqA, i)
        if not na(lex)
            line.set_color(lex, age == 0 ? eqLnCol : col)

    // ---- prune the oldest ranges (keep current + previous + maxHist) ----
    while array.size(hiA) > maxHist + 2
        line.delete(array.shift(hiA))
        line.delete(array.shift(loA))
        led = array.shift(eqA)
        if not na(led)
            line.delete(led)
