//@version=6
// =============================================================================
// BASIC CRT  —  STEP 1: RANGES   ·   STEP 2: SWEEPS & BREAKS
// -----------------------------------------------------------------------------
// Rebuilt from scratch, one layer at a time, each layer measured before it ships.
//
// THE RANGE
//   Every closed candle on the range timeframe IS a range. Its high and low are
//   the boundaries; the midpoint is equilibrium. The range is drawn from the
//   candle's own open time and projected forward for N candles.
//
// THE EVENT
//   What the NEXT candle does to those levels is the whole of CRT:
//     SWEEP   took the level, closed back INSIDE   — liquidity taken, rejected
//     BREAK   took the level, closed BEYOND it     — the level was accepted
//   Those two are exhaustive over candles that touch a level, so nothing that
//   touches a level goes unlabelled, and a break always outranks a sweep.
//
//   DOUBLE SWEEP (took both sides, closed inside) is its own event in its own
//   colour: measured on OANDA:XAUUSD it loses on every timeframe, so it must
//   never look like a directional sweep.
//
// Rules, defaults and the evidence behind them: SWEEP_SPEC.md in this repo.
//
// Non-repainting: every reading comes from the [1] / [2] offsets of the source
// timeframe — always fully closed candles — fetched with lookahead_off. Markers
// are anchored at the candle CLOSE, so they land on the bar they describe on
// every chart timeframe.
// =============================================================================
indicator("Basic CRT", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ===================== RANGE =================================================
gRng   = "Range"
tfIn   = input.timeframe("240", "Range timeframe", group=gRng, tooltip="Which candle defines each range. 240 = 4H. Any timeframe TradingView accepts works: 30, 60, 240, D, W.")
liveN  = input.int(3, "Keep each range live for N candles", minval=1, group=gRng, tooltip="How far right the range is projected, measured in candles of the range timeframe.")
tagTf  = input.bool(false, "Title the range with its timeframe", group=gRng, tooltip="On = '4H CRT High'. Off = 'CRT High'.")

// ===================== RANGE TIME FILTER =====================================
// Which ranges are worth looking at, by the time the RANGE CANDLE opened.
//
// Measured on eight instruments over 2010-2026, net of realistic costs
// (SLOT_STUDY.md). The finding in one line: no slot is profitable traded
// mechanically, but the RANKING between slots is large and consistent — 0.31 R
// per trade separates the best 4H bucket from the worst, and seven instruments
// that share nothing but a clock agree on the order. This filter mutes the
// slots that are consistently worst; it does not promise the rest are good.
//
// The boxes below arrive pre-set to that finding. Everything is one tick away
// from coming back.
gSlot  = "Range time filter"
sltOn  = input.bool(true, "Only use ranges that open in the ticked slots", group=gSlot, tooltip="Applies to the range boxes AND to the sweep/break markers, since a marker describes what happened to a range. Untick to see every range again.")
sltTz  = input.string("Africa/Johannesburg", "Timezone", options=["Africa/Johannesburg","America/New_York","Europe/London","Asia/Tokyo","UTC","Exchange"], group=gSlot, tooltip="Africa/Johannesburg = SAST, UTC+2 with no daylight saving, so the slots read the same all year.")

// ---- 4H: six sessions. US daylight saving moves each one by an hour, so each
// bucket covers two adjacent SAST hours and follows the shift automatically.
gS4 = "Range slots — 4H sessions"
s4b0 = input.bool(true,  "23:00/00:00   daily open", group=gS4, tooltip="Mean net -0.178 R across seven instruments. Middle of the pack.")
s4b1 = input.bool(false, "03:00/04:00   Asia", group=gS4, tooltip="WORST bucket measured: mean net -0.395 R, negative on 7 of 7 instruments. Off by default.")
s4b2 = input.bool(true,  "07:00/08:00   London open", group=gS4, tooltip="Mean net -0.212 R.")
s4b3 = input.bool(true,  "11:00/12:00   London PM", group=gS4, tooltip="BEST bucket measured: mean net -0.081 R, the least negative on nearly every instrument.")
s4b4 = input.bool(true,  "15:00/16:00   NY open", group=gS4, tooltip="Mean net -0.174 R.")
s4b5 = input.bool(false, "19:00/20:00   NY afternoon", group=gS4, tooltip="Second worst: mean net -0.286 R, negative on 7 of 7 instruments. Off by default.")

// ---- every other intraday range timeframe: by the hour the candle opened
gSH = "Range slots — hourly (15m, 30m, 1H, 2H, 8H)"
h00 = input.bool(false, "00", inline="q1", group=gSH)
h01 = input.bool(true,  "01", inline="q1", group=gSH)
h02 = input.bool(true,  "02", inline="q1", group=gSH)
h03 = input.bool(false, "03", inline="q1", group=gSH)
h04 = input.bool(true,  "04", inline="q1", group=gSH)
h05 = input.bool(true,  "05", inline="q1", group=gSH)
h06 = input.bool(false, "06", inline="q2", group=gSH)
h07 = input.bool(false, "07", inline="q2", group=gSH)
h08 = input.bool(false, "08", inline="q2", group=gSH)
h09 = input.bool(false, "09", inline="q2", group=gSH)
h10 = input.bool(true,  "10", inline="q2", group=gSH)
h11 = input.bool(true,  "11", inline="q2", group=gSH)
h12 = input.bool(true,  "12", inline="q3", group=gSH)
h13 = input.bool(true,  "13", inline="q3", group=gSH)
h14 = input.bool(true,  "14", inline="q3", group=gSH)
h15 = input.bool(true,  "15", inline="q3", group=gSH)
h16 = input.bool(true,  "16", inline="q3", group=gSH)
h17 = input.bool(true,  "17", inline="q3", group=gSH)
h18 = input.bool(true,  "18", inline="q4", group=gSH)
h19 = input.bool(true,  "19", inline="q4", group=gSH)
h20 = input.bool(true,  "20", inline="q4", group=gSH)
h21 = input.bool(true,  "21", inline="q4", group=gSH)
h22 = input.bool(true,  "22", inline="q4", group=gSH)
h23 = input.bool(true,  "23", inline="q4", group=gSH)

// ---- day of week, applied on every timeframe
gSD = "Range slots — day of week"
wMon = input.bool(true, "Mon", inline="w1", group=gSD)
wTue = input.bool(true, "Tue", inline="w1", group=gSD)
wWed = input.bool(true, "Wed", inline="w1", group=gSD)
wThu = input.bool(true, "Thu", inline="w2", group=gSD)
wFri = input.bool(true, "Fri", inline="w2", group=gSD)
wSat = input.bool(true, "Sat", inline="w2", group=gSD)
wSun = input.bool(true, "Sun", inline="w2", group=gSD, tooltip="All days on by default. The weekday effect measured far weaker than the hourly one — 0.085 R between best and worst, against 0.31 R across the 4H sessions — so nothing is pre-muted here. For reference on DAILY ranges: Wed was least bad (-0.045 R), then Mon (-0.055), Fri (-0.103), Tue (-0.126), Thu (-0.130).")

// ===================== VISIBILITY ============================================
gVis     = "Visibility"
showPrev = input.bool(true,  "Show previous range", group=gVis)
showHist = input.bool(false, "Show historical ranges", group=gVis)
maxHist  = input.int(20, "Max historical ranges kept", minval=1, maxval=200, group=gVis)

// ===================== COLOURS & STYLE =======================================
gCol     = "Range box — Colours & Style"
curCol   = input.color(color.new(#2962FF, 0),     "Current range",    group=gCol)
prevCol  = input.color(color.new(color.gray, 0),  "Previous range",   group=gCol)
histCol  = input.color(color.new(color.gray, 55), "Historical range", group=gCol)
lw       = input.int(2, "Line width", minval=1, maxval=4, group=gCol)
showShade    = input.bool(true, "Shade inside the range", group=gCol)
shadeCol     = input.color(#2962FF, "Shade colour", group=gCol)
shadeOpacity = input.int(90, "Shade opacity (0 = solid, 100 = invisible)", minval=0, maxval=100, group=gCol, tooltip="Higher = lighter than the range lines. The left side of the range stays open; the shading highlights it.")
shadeDepth   = input.float(1.0, "Shade depth (0 = none, 1 = full range)", minval=0, maxval=1, step=0.05, group=gCol)

// ===================== HIGH / LOW LABELS =====================================
gLab      = "CRT High / Low labels"
labDesign = input.string("Filled", "Label design", options=["Filled","Ghost","Tinted","Chip"], group=gLab)
showHL    = input.bool(true,  "Show High / Low labels", group=gLab)
shortHL   = input.bool(false, "Short names (CRT H / CRT L)", group=gLab)
showPx    = input.bool(true,  "Show price in labels", group=gLab)
labSz     = input.string("Small", "Label size", options=["Tiny","Small","Normal"], group=gLab)
hlLabCol  = input.color(color.new(#2962FF, 0), "Label colour", group=gLab)
labTxtCol = input.color(color.white, "Text colour (Filled design)", group=gLab)

// ===================== SWEEPS (optional, per timeframe) ======================
// A sweep = a CLOSED candle takes the PRIOR candle's high or low and CLOSES
// BACK INSIDE it. The wick took the liquidity, the body refused the price.
// Detected independently on each ticked timeframe, so a scalper can watch 15m
// sweeps only and a swing trader only D/W. Data loads only for ticked
// timeframes, so the rest cost nothing.
//
// DOUBLE SWEEP gets its own event and its own colour because it is not the same
// trade. A candle that takes BOTH sides and closes inside is 10-14% of all
// candles, and measured on OANDA:XAUUSD 2023-2026 it loses on every timeframe
// (-0.08 R on 15m, -0.18 R on 1H and 4H) — the win rate is high but the candle
// already sits at the opposite extreme, so there is nothing left to win.
gSwp = "Sweeps  (optional)"
showSweep   = input.bool(false, "Show liquidity sweeps", group=gSwp)
sweepDesign = input.string("Label", "Sweep marker design", options=["Label","Triangle S","Circle S"], group=gSwp, tooltip="Label = pointer tag ('Sweep'). Triangle S / Circle S = minimal shape with an 'S' on the sweeping candle.")
sweepLbl    = input.bool(true,  "Show 'Sweep' text (Label design only)", group=gSwp)
sweepTf     = input.bool(true,  "Title each sweep with its timeframe", group=gSwp, tooltip="On = '4H Sweep', '1H Sweep' etc, so you always know which timeframe produced the marker.")
sweepAnchor = input.string("Candle close", "Sweep marker position", options=["Candle close","Candle open"], group=gSwp, tooltip="Candle close = the last bar of the candle that did the sweeping, which is where it was confirmed (recommended). Candle open = the first bar of that candle — on a 15m chart that puts a 4H marker up to 4 hours to the left of the wick it describes.")
sweepSz     = input.string("Tiny", "Sweep marker size", options=["Tiny","Small","Normal"], group=gSwp)
sweepUpC    = input.color(color.new(color.lime, 0), "Bullish sweep (swept lows)", group=gSwp)
sweepDnC    = input.color(color.new(color.red, 0),  "Bearish sweep (swept highs)", group=gSwp)
dblOn       = input.bool(true, "Mark double sweeps (BOTH wicks get a marker)", group=gSwp, tooltip="A candle that takes the prior high AND the prior low and still closes inside has swept two liquidity pools, so it gets TWO markers — one on the high it took, one on the low — in their own colour. As a trade it points nowhere and measured negative on every timeframe, which is exactly why it must be recognisable on sight. Untick to hide both markers.")
dblC        = input.color(color.new(#FF9800, 0), "Double sweep (both wicks)", group=gSwp)
swp5On  = input.bool(false, "5m",  inline="sw1", group=gSwp)
swp15On = input.bool(false, "15m", inline="sw1", group=gSwp)
swp30On = input.bool(false, "30m", inline="sw1", group=gSwp)
swp1On  = input.bool(false, "1H",  inline="sw2", group=gSwp)
swp2On  = input.bool(false, "2H",  inline="sw2", group=gSwp)
swp4On  = input.bool(true,  "4H",  inline="sw2", group=gSwp)
swp8On  = input.bool(false, "8H",  inline="sw3", group=gSwp)
swpDOn  = input.bool(false, "D",   inline="sw3", group=gSwp)
swpWOn  = input.bool(false, "W",   inline="sw3", group=gSwp)
swKeep  = input.int(12, "Keep last N sweep markers (all TFs)", minval=1, maxval=100, group=gSwp, tooltip="About a third of all candles carry a sweep mark, so this is what stops the chart filling up.")

// ===================== BREAKS (optional, per timeframe) ======================
// Same two candles as a sweep, opposite outcome. The candle takes the prior
// high or low and CLOSES BEYOND it — the level was accepted, not rejected.
//
// ONE TAG PER CANDLE. Classification runs once, before anything is drawn, and a
// break outranks a sweep, so which layers you switch on can never change what a
// candle IS. Turning breaks off never turns a break candle into a sweep.
gBrk = "Breaks  (optional)"
showBreak   = input.bool(false, "Show breaks (closed BEYOND the level)", group=gBrk, tooltip="Master switch. A break = the candle took the prior high/low and finished past it instead of reclaiming.")
brkStrict   = input.bool(false, "Also require the OPEN beyond the level", group=gBrk, tooltip="OFF (recommended): the close beyond the level is the break — the standard definition. ON: the whole body, open AND close, must clear the level. In a 24-hour market the open equals the previous close, so this needs a gap — measured on 4H gold it found 60 breaks in 5,269 candles. Nothing goes unmarked either way: a level that was taken without being accepted is a sweep, so with this on, a candle whose body still straddles the level is marked as a sweep rather than a break.")
breakDesign = input.string("Label", "Break marker design", options=["Label","Triangle B","Circle B"], group=gBrk)
breakLbl    = input.bool(true,  "Show 'Break' text (Label design only)", group=gBrk)
breakTf     = input.bool(true,  "Title each break with its timeframe", group=gBrk)
breakAnchor = input.string("Candle close", "Break marker position", options=["Candle close","Candle open"], group=gBrk)
breakSz     = input.string("Tiny", "Break marker size", options=["Tiny","Small","Normal"], group=gBrk)
breakUpC    = input.color(color.new(color.aqua, 0),   "Bullish break (closed above the high)", group=gBrk)
breakDnC    = input.color(color.new(color.orange, 0), "Bearish break (closed below the low)", group=gBrk)
comboOn     = input.bool(true, "Also mark the wick a break candle swept first", group=gBrk, tooltip="A candle that dips under the low, rejects it, and still closes clean above the high is manipulation and distribution in one candle — 17% of 4H breaks. On = that swept wick gets its own marker in the colour below, alongside the break marker at the level that was accepted. Off = only the break is marked and the swept wick is invisible.")
comboC      = input.color(color.new(#AA00FF, 0), "Wick swept by a break candle", group=gBrk)
brk5On  = input.bool(false, "5m",  inline="br1", group=gBrk)
brk15On = input.bool(false, "15m", inline="br1", group=gBrk)
brk30On = input.bool(false, "30m", inline="br1", group=gBrk)
brk1On  = input.bool(false, "1H",  inline="br2", group=gBrk)
brk2On  = input.bool(false, "2H",  inline="br2", group=gBrk)
brk4On  = input.bool(true,  "4H",  inline="br2", group=gBrk)
brk8On  = input.bool(false, "8H",  inline="br3", group=gBrk)
brkDOn  = input.bool(false, "D",   inline="br3", group=gBrk)
brkWOn  = input.bool(false, "W",   inline="br3", group=gBrk)
brKeep  = input.int(12, "Keep last N break markers (all TFs)", minval=1, maxval=100, group=gBrk)

// ===================== CRT SETUPS ============================================
// The rule, exactly as traded: a full bar CLOSES BACK INSIDE the range. That is
// the setup. Target the opposite extreme — the whole range. Stop beyond the
// level that was swept.
//
// Measured across seven instruments (ENTRY_STUDY.md), the two settings that
// improved EVERY instrument tested:
//   - a stop 50% of the range beyond the level instead of at the sweep wick
//     (mean -0.235 -> -0.105 R). Cost in R is 2 x slippage / stop distance, so
//     a tight stop hands the spread a large share of your R.
//   - banking part of the position at equilibrium with the stop to breakeven
//     (+0.038 R, better on 7 of 7, and gross positive on 6 of 7).
// Both arrive on. Neither makes the mechanical rule profitable after costs; they
// are the difference between -0.105 R and -0.067 R per trade.
gSet = "CRT setups  (optional)"
showSetup = input.bool(false, "Show CRT setups (entry / stop / target)", group=gSet, tooltip="Setups come from the RANGE timeframe above, so the range you can see is the range you are trading. They also obey the range time filter.")
setWatch  = input.int(2, "Sweep must happen within N candles of the range", minval=1, maxval=3, group=gSet, tooltip="1 = only the candle immediately after the range. 2 = the classic three-candle CRT, allowing the sweep one candle later. A range whose level is BROKEN rather than swept is discarded immediately.")
setDbl    = input.bool(false, "Also take double sweeps", group=gSet, tooltip="A candle that sweeps both sides has taken two liquidity pools and points nowhere. It measured negative on every timeframe and instrument tested, so it is skipped by default.")
slMode    = input.string("% of range beyond the level", "Stop placed at", options=["% of range beyond the level","Swept wick"], group=gSet, tooltip="Measured: a stop 50% of the range beyond the level beat a stop at the sweep wick on every instrument tested, because cost in R is 2 x slippage / stop distance. The wick option is never tighter than the wick actually printed.")
slPct     = input.float(50, "Stop distance (% of range beyond the level)", minval=0, maxval=300, step=5, group=gSet)
tpPart    = input.bool(true, "Bank part of the position at equilibrium", group=gSet, tooltip="Take profit at the 50% mark and move the stop to breakeven, letting the rest run to the opposite extreme. This is taking profit at EQ, NOT entering there. Improved every instrument tested.")
tpPartPct = input.float(50, "Portion banked at EQ (%)", minval=0, maxval=100, step=5, group=gSet)
setLongC  = input.color(color.new(color.teal, 0), "Long setup", inline="sc", group=gSet)
setShortC = input.color(color.new(color.maroon, 0), "Short setup", inline="sc", group=gSet)
setTpC    = input.color(color.new(color.green, 0), "Target", inline="sc2", group=gSet)
setSlC    = input.color(color.new(color.red, 0),   "Stop", inline="sc2", group=gSet)
setEqC    = input.color(color.new(#FF9800, 0),     "Equilibrium", inline="sc2", group=gSet)
setW      = input.int(2, "Line width", minval=1, maxval=4, group=gSet)
setProj   = input.int(4, "Line length (chart bars)", minval=1, maxval=50, group=gSet, tooltip="Entry, stop, target and break-even are drawn as short dotted lines of this length, starting on the entry bar — the original layout. Measured in bars of the chart you are looking at, so they stay the same size whatever timeframe you view.")
bePct     = input.float(10, "BE stop offset (% of original risk)", minval=0, maxval=90, step=1, group=gSet, tooltip="How far past ENTRY the stop moves once the equilibrium portion is banked. Longs go above entry, shorts below, so a scratch locks a small gain instead of nothing.")
setKeep   = input.int(8, "Keep last N setups", minval=1, maxval=40, group=gSet)
beFade    = input.int(70, "Faded original stop transparency", minval=0, maxval=95, group=gSet)

// ===================== EQUILIBRIUM ===========================================
gEQ       = "Equilibrium"
showEqLn  = input.bool(true, "Show equilibrium line", group=gEQ)
eqLnCol   = input.color(color.new(#FF6D00, 0), "EQ line colour", group=gEQ)
eqLnWidth = input.int(2, "EQ line width", minval=1, maxval=4, group=gEQ)
eqLnStyle = input.string("Dotted", "EQ line style", options=["Dotted","Dashed","Solid"], group=gEQ)
showEqLab = input.bool(true, "Show EQ label", group=gEQ)
eqLabSz   = input.string("Tiny", "EQ label size", options=["Tiny","Small","Normal"], group=gEQ)
eqLabCol  = input.color(color.new(color.black, 0), "EQ label colour", group=gEQ)
showEqPx  = input.bool(false, "Include EQ price in label", group=gEQ)
showSize  = input.bool(true,  "Show range size (PTS) in label", group=gEQ)
pointSize = input.float(0.0, "Price per point (0 = auto min-tick)", minval=0, step=0.001, group=gEQ)
brUnit    = input.string("Pips", "Bracket unit", options=["Pips","Ticks","Price","None"], group=gEQ)
pipSize   = input.float(0.0, "Price per pip (0 = auto)", minval=0, step=0.0001, group=gEQ)

// ===================== HELPERS ===============================================
f_lsz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

f_lstyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Solid" ? line.style_solid : line.style_dotted

// "60" -> "1H", "240" -> "4H", "D" -> "D". The parameter is qualified `simple`
// because timeframe.in_seconds() refuses a series string.
f_tfName(simple string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 604800 ? "W" : s == 86400 ? "D" : s > 86400 ? str.tostring(int(s / 86400)) + "D" : s >= 3600 ? str.tostring(int(s / 3600)) + "H" : str.tostring(int(s / 60)) + "m"

mkLabel(int x, float y, string txt, string design, color mainCol, color txtCol, string szStr) =>
    bg = design == "Ghost" ? color.new(color.gray, 100) : design == "Tinted" ? color.new(mainCol, 70) : design == "Chip" ? chart.bg_color : mainCol
    tc = design == "Filled" ? txtCol : mainCol
    label.new(x, y, txt, xloc=xloc.bar_time, style=label.style_label_left, color=bg, textcolor=tc, size=f_lsz(szStr))

TRANSP = color.new(color.gray, 100)
HIDE   = color.new(color.gray, 100)

// ---- range time filter -----------------------------------------------------
// Lookup tables built once from the inputs, so the test is an array read rather
// than a twenty-four-way ternary.
tzSlot = sltTz == "Exchange" ? syminfo.timezone : sltTz
hrOn  = array.from(h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23)
dayOn = array.from(wSun, wMon, wTue, wWed, wThu, wFri, wSat)   // dayofweek is 1..7 from Sunday
sesOn = array.from(s4b0, s4b1, s4b2, s4b3, s4b4, s4b5)

// Is a range that OPENED at time t, on a timeframe msLen long, one we want?
//   daily and above -> the weekday boxes are the whole filter
//   exactly 4H      -> the six session buckets. Bucket = ((hour+1) % 24) / 4,
//                      which pairs 23/00, 03/04, 07/08, 11/12, 15/16, 19/20 and
//                      therefore follows the daylight-saving shift by itself.
//   anything else   -> the hour the candle opened
f_slotOK(int t, int msLen) =>
    bool ok = true
    if sltOn and not na(t)
        h  = hour(t, tzSlot)
        dw = dayofweek(t, tzSlot)
        okDay = array.get(dayOn, dw - 1)
        bool okT = true
        if msLen >= 86400000
            okT := true
        else if msLen == 14400000
            okT := array.get(sesOn, int(((h + 1) % 24) / 4))
        else
            okT := array.get(hrOn, h)
        ok := okDay and okT
    ok

// ===================== THE RANGE FETCH =======================================
// The last CLOSED candle of the range timeframe: its high, its low, and the
// timestamp it opened at. Everything else in this file is drawn from these three
// numbers.
sym = syminfo.tickerid
// length of one CHART bar, in milliseconds — used to land higher-timeframe
// markers on a real bar of the chart you are actually looking at
chartMs = timeframe.in_seconds(timeframe.period) * 1000
[rHigh, rLow, rOpenT, rOpen, rClose] = request.security(sym, tfIn, [high[1], low[1], time[1], open[1], close[1]], lookahead=barmerge.lookahead_off)
tfMs = timeframe.in_seconds(tfIn) * 1000
tfNm = f_tfName(tfIn)

// One store per drawing type. They stay in lock-step: index i of each array
// belongs to the same range, so age-based recolouring and pruning line up.
var array<line> hiA = array.new<line>()
var array<line> loA = array.new<line>()
var array<line> eqA = array.new<line>()
var array<box>  shA = array.new<box>()

// The newest range owns the labels. Older ranges are lines only, which is what
// stops a screen full of stacked tags.
var label labHi = na
var label labLo = na
var label labEq = na

// A new range exists the moment the range timeframe's open time changes.
newRange = not na(rHigh) and not na(rLow) and not na(rOpenT) and (na(rOpenT[1]) or rOpenT != rOpenT[1]) and f_slotOK(int(rOpenT), tfMs)

if newRange
    startT  = int(rOpenT)
    endT    = startT + liveN * tfMs
    eqv     = (rHigh + rLow) / 2.0
    rangePx = rHigh - rLow

    // ---- draw this range ----
    array.push(hiA, line.new(startT, rHigh, endT, rHigh, xloc=xloc.bar_time, color=curCol, width=lw))
    array.push(loA, line.new(startT, rLow,  endT, rLow,  xloc=xloc.bar_time, color=curCol, width=lw))
    array.push(eqA, showEqLn ? line.new(startT, eqv, endT, eqv, xloc=xloc.bar_time, color=eqLnCol, width=eqLnWidth, style=f_lstyle(eqLnStyle)) : na)
    array.push(shA, showShade and shadeDepth > 0 ? box.new(startT, rHigh, startT + int(shadeDepth * (endT - startT)), rLow, xloc=xloc.bar_time, border_color=TRANSP, bgcolor=color.new(shadeCol, shadeOpacity)) : na)

    // ---- labels: only the newest range carries them ----
    if not na(labHi)
        label.delete(labHi)
    if not na(labLo)
        label.delete(labLo)
    if not na(labEq)
        label.delete(labEq)

    pre    = tagTf ? tfNm + " " : ""
    hiName = shortHL ? "CRT H" : "CRT High"
    loName = shortHL ? "CRT L" : "CRT Low"
    hiTxt  = pre + hiName + (showPx ? " " + str.tostring(rHigh, format.mintick) : "")
    loTxt  = pre + loName + (showPx ? " " + str.tostring(rLow,  format.mintick) : "")

    ptSz  = pointSize > 0 ? pointSize : syminfo.mintick
    ppSz  = pipSize   > 0 ? pipSize   : syminfo.mintick * 10
    ptsN  = math.round(rangePx / ptSz)
    brNum = brUnit == "Pips" ? math.round(rangePx / ppSz) : brUnit == "Ticks" ? math.round(rangePx / syminfo.mintick) : na
    brStr = brUnit == "None" ? "" : brUnit == "Price" ? "(" + str.tostring(rangePx, format.mintick) + ")" : "(" + str.tostring(brNum, "#") + " " + (brUnit == "Pips" ? "pips" : "ticks") + ")"
    eqTxt = pre + "EQ" + (showEqPx ? " " + str.tostring(eqv, format.mintick) : "") + (showSize ? "  " + str.tostring(ptsN, "#") + " PTS" : "") + (brStr == "" ? "" : "  " + brStr)

    labHi := showHL    ? mkLabel(endT, rHigh, hiTxt, labDesign, hlLabCol, labTxtCol, labSz)  : na
    labLo := showHL    ? mkLabel(endT, rLow,  loTxt, labDesign, hlLabCol, labTxtCol, labSz)  : na
    labEq := showEqLab ? mkLabel(endT, eqv,   eqTxt, labDesign, eqLabCol, labTxtCol, eqLabSz) : na

    // ---- age-based recolour: newest, then previous, then history ----
    n = array.size(hiA)
    for i = 0 to n - 1
        age = n - 1 - i
        col = age == 0 ? curCol : age == 1 ? (showPrev ? prevCol : HIDE) : (showHist ? histCol : HIDE)
        line.set_color(array.get(hiA, i), col)
        line.set_color(array.get(loA, i), col)
        lex = array.get(eqA, i)
        if not na(lex)
            line.set_color(lex, age == 0 ? eqLnCol : col)
        shx = array.get(shA, i)
        if not na(shx)
            // shading only ever fills the CURRENT range; older ranges are lines
            box.set_bgcolor(shx, age == 0 ? color.new(shadeCol, shadeOpacity) : HIDE)

    // ---- prune ----
    while array.size(hiA) > maxHist + 2
        line.delete(array.shift(hiA))
        line.delete(array.shift(loA))
        led = array.shift(eqA)
        if not na(led)
            line.delete(led)
        shd = array.shift(shA)
        if not na(shd)
            box.delete(shd)

// ===================== SWEEPS & BREAKS =======================================
// Two candles of the source timeframe, both fully closed:
//   A = the older one. Its high and low are the levels.
//   B = the one that just closed.
//
// A MARKER MARKS A LEVEL, NOT A CANDLE. A has two levels and B can take both of
// them, so B can produce two events at two different prices. Each side is
// resolved on its own:
//
//   A's HIGH, if B traded above it     accepted (closed beyond) -> BREAK
//                                      rejected                 -> SWEEP
//   A's LOW,  if B traded below it     same question, answered separately
//
// Every taken side resolves to exactly one of break or sweep, so no side that
// was taken ever goes unmarked. What is exclusive is the CLASSIFICATION of a
// single side — never both labels on one level — not the number of events on a
// candle.
//
//   DOUBLE SWEEP   both sides taken, neither accepted. TWO markers, one on each
//                  wick, in their own colour: this configuration measured
//                  negative on every timeframe and must be recognisable at a
//                  glance.
//   SWEPT + BROKE  one side taken and rejected, the other taken and accepted.
//                  Also two markers — the swept wick and the broken level —
//                  because hiding the swept half is hiding the manipulation.

var array<label> swLbA = array.new<label>()
var array<label> brLbA = array.new<label>()

f_pushMark(array<label> store, int keepN, label lb) =>
    array.push(store, lb)
    while array.size(store) > keepN
        label.delete(array.shift(store))

// One sweep marker at one price. `bull` = it sits UNDER the candle pointing up
// (a swept low); false = above it pointing down (a swept high).
f_sweepMark(bool bull, color col, string core, string lett, int atT, float y, string tfName) =>
    style = sweepDesign == "Triangle S" ? (bull ? label.style_triangleup : label.style_triangledown) : sweepDesign == "Circle S" ? label.style_circle : (bull ? label.style_label_up : label.style_label_down)
    pre   = sweepTf ? tfName + " " : ""
    txt   = sweepDesign == "Label" ? (sweepLbl ? pre + core : str.trim(pre)) : str.trim(pre + lett)
    f_pushMark(swLbA, swKeep, label.new(atT, y, txt, xloc=xloc.bar_time, style=style, color=color.new(col, 20), textcolor=chart.bg_color, size=f_lsz(sweepSz)))

// One break marker at one price.
f_breakMark(bool bull, int atT, float y, string tfName) =>
    col   = bull ? breakUpC : breakDnC
    style = breakDesign == "Triangle B" ? (bull ? label.style_triangleup : label.style_triangledown) : breakDesign == "Circle B" ? label.style_circle : (bull ? label.style_label_up : label.style_label_down)
    pre   = breakTf ? tfName + " " : ""
    txt   = breakDesign == "Label" ? (breakLbl ? pre + "Break" : str.trim(pre)) : str.trim(pre + "B")
    f_pushMark(brLbA, brKeep, label.new(atT, y, txt, xloc=xloc.bar_time, style=style, color=color.new(col, 20), textcolor=chart.bg_color, size=f_lsz(breakSz)))

// One pass over A and B. `nb` is true only on the first chart bar after B closed,
// so each source candle is classified exactly once no matter which chart
// timeframe you are looking at.
//
// ANCHORING. xloc.bar_time positions a drawing by TIME, and a time that does not
// match a bar is resolved to the NEAREST bar. So the anchor has to be an actual
// chart-bar open time, not merely a moment inside the candle:
//
//   bT                     B's open  = the FIRST chart bar of the candle
//   bT + msLen - 1         one ms before B ends. Measured against real data this
//                          matches a chart bar 0% of the time and resolves to the
//                          bar AFTER the candle — every marker one bar too far
//                          right. This was wrong and is not used.
//   bT + (msLen - chartMs) the open time of the LAST chart bar inside B, which is
//                          an exact bar time 100% of the time. This is used.
//
// Clamped to `time` so a marker can never be placed to the right of the bar that
// is currently being processed.
f_swpBrkScan(string tfName, bool swEn, bool brEn, float aLoV, float aHiV, float bLoV, float bHiV, float bO, float bC, int aT, int bT, int msLen, bool nb) =>
    // aT is candle A's own open time, not bT - msLen: across a weekend that
    // subtraction lands on a Saturday and the slot test would read the wrong day.
    if nb and not na(aLoV) and not na(aHiV) and not na(bO) and not na(bC) and f_slotOK(aT, msLen)
        tookLo = bLoV < aLoV
        tookHi = bHiV > aHiV
        bodyHi = math.max(bO, bC)
        bodyLo = math.min(bO, bC)
        brUp = tookHi and bC > aHiV and (not brkStrict or bodyLo > aHiV)
        brDn = tookLo and bC < aLoV and (not brkStrict or bodyHi < aLoV)
        // brUp and brDn cannot both be true: aHiV >= aLoV
        // A side that was taken and NOT accepted was swept. Every taken side
        // therefore resolves to exactly one of break / sweep — no holes, in
        // strict mode as well as loose.
        swHi = tookHi and not brUp
        swLo = tookLo and not brDn
        isDbl = swHi and swLo
        lastBarT = math.min(bT + math.max(0, msLen - chartMs), time)
        swT = sweepAnchor == "Candle open" ? bT : lastBarT
        brT = breakAnchor == "Candle open" ? bT : lastBarT

        // ---- the event at the HIGH ----
        if tookHi
            if brUp
                if brEn
                    f_breakMark(true, brT, bHiV, tfName)
            else
                // swept the high while breaking the low = the swept half of a
                // break candle; own colour, own switch
                cmb = brDn
                okHi = isDbl ? dblOn : cmb ? comboOn : true
                if swEn and okHi
                    f_sweepMark(false, isDbl ? dblC : cmb ? comboC : sweepDnC, isDbl ? "Double Sweep" : "Sweep", isDbl ? "DS" : "S", swT, bHiV, tfName)

        // ---- the event at the LOW ----
        if tookLo
            if brDn
                if brEn
                    f_breakMark(false, brT, bLoV, tfName)
            else
                cmb2 = brUp
                okLo = isDbl ? dblOn : cmb2 ? comboOn : true
                if swEn and okLo
                    f_sweepMark(true, isDbl ? dblC : cmb2 ? comboC : sweepUpC, isDbl ? "Double Sweep" : "Sweep", isDbl ? "DS" : "S", swT, bLoV, tfName)

// ---- one fetch per timeframe, gated by its own checkboxes ------------------
// [2] is A, [1] is B — both always fully closed, so nothing is ever classified
// while it is still forming. Data loads only where a layer is switched on.
sw5 = showSweep and swp5On
br5 = showBreak and brk5On
if sw5 or br5
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "5",   [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("5m", sw5, br5, al, ah, bl, bh, bo, bc, int(at), int(bt), 300000, not na(bt) and bt != bt[1])
sw15 = showSweep and swp15On
br15 = showBreak and brk15On
if sw15 or br15
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "15",  [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("15m", sw15, br15, al, ah, bl, bh, bo, bc, int(at), int(bt), 900000, not na(bt) and bt != bt[1])
sw30 = showSweep and swp30On
br30 = showBreak and brk30On
if sw30 or br30
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "30",  [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("30m", sw30, br30, al, ah, bl, bh, bo, bc, int(at), int(bt), 1800000, not na(bt) and bt != bt[1])
sw1 = showSweep and swp1On
br1H = showBreak and brk1On
if sw1 or br1H
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "60",  [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("1H", sw1, br1H, al, ah, bl, bh, bo, bc, int(at), int(bt), 3600000, not na(bt) and bt != bt[1])
sw2 = showSweep and swp2On
br2H = showBreak and brk2On
if sw2 or br2H
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "120", [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("2H", sw2, br2H, al, ah, bl, bh, bo, bc, int(at), int(bt), 7200000, not na(bt) and bt != bt[1])
sw4 = showSweep and swp4On
br4H = showBreak and brk4On
if sw4 or br4H
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "240", [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("4H", sw4, br4H, al, ah, bl, bh, bo, bc, int(at), int(bt), 14400000, not na(bt) and bt != bt[1])
sw8 = showSweep and swp8On
br8H = showBreak and brk8On
if sw8 or br8H
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "480", [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("8H", sw8, br8H, al, ah, bl, bh, bo, bc, int(at), int(bt), 28800000, not na(bt) and bt != bt[1])
swD = showSweep and swpDOn
brD = showBreak and brkDOn
if swD or brD
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "1D",  [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("D", swD, brD, al, ah, bl, bh, bo, bc, int(at), int(bt), 86400000, not na(bt) and bt != bt[1])
swW = showSweep and swpWOn
brW = showBreak and brkWOn
if swW or brW
    [al,ah,bl,bh,bo,bc,at,bt] = request.security(sym, "1W",  [low[2],high[2],low[1],high[1],open[1],close[1],time[2],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("W", swW, brW, al, ah, bl, bh, bo, bc, int(at), int(bt), 604800000, not na(bt) and bt != bt[1])

// ===================== CRT SETUPS ============================================
// A range candle closes and a WATCH arms. Each later candle of the range
// timeframe is then asked one question about each live watch:
//
//   did it take a level, and where did it CLOSE?
//     closed back inside  -> the setup fires on that close
//     closed beyond       -> the level was accepted, not swept: the watch dies
//     never reached it    -> the watch waits, then expires
//
// The entry is that closing price. Not a retrace to equilibrium — that enters
// into the leg, keeps the risk and gives up half the reward.
//
// Everything is decided on CLOSED candles of the range timeframe, read through
// the same [1] offset as the ranges themselves, so a setup can never appear and
// then vanish as a candle forms.

var array<float> wHi   = array.new<float>()   // the watched range
var array<float> wLo   = array.new<float>()
var array<int>   wDead = array.new<int>()     // time this watch stops looking

// one slot per live setup, all pruned together
var array<line>  uEn = array.new<line>()
var array<line>  uSl = array.new<line>()
var array<line>  uTp = array.new<line>()
var array<line>  uEq = array.new<line>()
var array<label> uEnL = array.new<label>()
var array<label> uSlL = array.new<label>()
var array<label> uTpL = array.new<label>()
var array<label> uEqL = array.new<label>()
var array<float> uBeS  = array.new<float>()   // where the stop goes once EQ is banked
var array<line>  uBeLn = array.new<line>()
var array<label> uBeLb = array.new<label>()
var array<int>   uDir = array.new<int>()
var array<float> uEnP = array.new<float>()
var array<float> uSlP = array.new<float>()
var array<float> uTpP = array.new<float>()
var array<float> uEqP = array.new<float>()
var array<bool>  uBE  = array.new<bool>()     // has the EQ portion been banked?
var array<bool>  uDone = array.new<bool>()

f_setupDraw(int dir, float entry, float stop, float tp, float eqv, int x0) =>
    dirC = dir == 1 ? setLongC : setShortC
    x1 = x0 + setProj
    // entry / stop / target / BE all the SAME short dotted length, tiny tags at
    // the right end. Drawn in BAR INDEX space so the length is four bars of the
    // chart you are on, not four candles of the range timeframe.
    array.push(uEn, line.new(x0, entry, x1, entry, color=dirC, width=setW, style=line.style_dotted))
    array.push(uSl, line.new(x0, stop,  x1, stop,  color=setSlC, width=setW, style=line.style_dotted))
    array.push(uTp, line.new(x0, tp,    x1, tp,    color=setTpC, width=setW, style=line.style_dotted))
    array.push(uEq, tpPart ? line.new(x0, eqv, x1, eqv, color=setEqC, width=setW, style=line.style_dotted) : na)
    array.push(uEnL, label.new(x1, entry, dir == 1 ? "LE" : "SE", style=label.style_label_left, color=HIDE, textcolor=dirC, size=size.tiny))
    array.push(uSlL, label.new(x1, stop, "SL", style=label.style_label_left, color=HIDE, textcolor=setSlC, size=size.tiny))
    array.push(uTpL, label.new(x1, tp, "TP", style=label.style_label_left, color=HIDE, textcolor=setTpC, size=size.tiny))
    array.push(uEqL, tpPart ? label.new(x1, eqv, "BE", style=label.style_label_left, color=HIDE, textcolor=setEqC, size=size.tiny) : na)
    array.push(uDir, dir)
    array.push(uEnP, entry)
    array.push(uSlP, stop)
    array.push(uTpP, tp)
    array.push(uEqP, tpPart ? eqv : na)
    array.push(uBeS, dir == 1 ? entry + math.abs(entry - stop) * bePct / 100.0 : entry - math.abs(entry - stop) * bePct / 100.0)
    array.push(uBeLn, na)
    array.push(uBeLb, na)
    array.push(uBE, false)
    array.push(uDone, false)
    while array.size(uEn) > setKeep
        line.delete(array.shift(uEn))
        line.delete(array.shift(uSl))
        line.delete(array.shift(uTp))
        eqo = array.shift(uEq)
        if not na(eqo)
            line.delete(eqo)
        label.delete(array.shift(uEnL))
        label.delete(array.shift(uSlL))
        label.delete(array.shift(uTpL))
        eql = array.shift(uEqL)
        if not na(eql)
            label.delete(eql)
        bln = array.shift(uBeLn)
        if not na(bln)
            line.delete(bln)
        blb = array.shift(uBeLb)
        if not na(blb)
            label.delete(blb)
        array.shift(uDir)
        array.shift(uEnP)
        array.shift(uSlP)
        array.shift(uTpP)
        array.shift(uEqP)
        array.shift(uBeS)
        array.shift(uBE)
        array.shift(uDone)

// Run every live watch against the candle that just closed, then arm a watch
// for that candle. Order matters: a candle cannot sweep itself.
if showSetup and newRange and not na(rOpen) and not na(rClose)
    bT = int(rOpenT)
    k = array.size(wHi) - 1
    while k >= 0
        hiW = array.get(wHi, k)
        loW = array.get(wLo, k)
        if bT > array.get(wDead, k)
            array.remove(wHi, k)
            array.remove(wLo, k)
            array.remove(wDead, k)
        else
            tookHi = rHigh > hiW
            tookLo = rLow < loW
            brUp = tookHi and rClose > hiW
            brDn = tookLo and rClose < loW
            swHi = tookHi and not brUp          // took the high, closed back inside
            swLo = tookLo and not brDn
            dbl  = swHi and swLo
            dir  = dbl ? (setDbl ? (rClose < (hiW + loW) / 2.0 ? -1 : 1) : 0) : swHi ? -1 : swLo ? 1 : 0
            if brUp or brDn or dir != 0
                // resolved either way: this range is finished with
                array.remove(wHi, k)
                array.remove(wLo, k)
                array.remove(wDead, k)
            if dir != 0
                rngH = hiW - loW
                lvl  = dir == -1 ? hiW : loW
                wick = dir == -1 ? rHigh : rLow
                pad  = slPct / 100.0 * rngH
                beyond = dir == -1 ? lvl + pad : lvl - pad
                stop = slMode == "Swept wick" ? wick : (dir == -1 ? math.max(beyond, wick) : math.min(beyond, wick))
                entry = rClose
                tp = dir == -1 ? loW : hiW
                eqv = (hiW + loW) / 2.0
                ok = dir == -1 ? (stop > entry and tp < entry) : (stop < entry and tp > entry)
                if ok
                    f_setupDraw(dir, entry, stop, tp, eqv, bar_index)
        k := k - 1
    // this candle now becomes a range in its own right
    array.push(wHi, rHigh)
    array.push(wLo, rLow)
    array.push(wDead, bT + setWatch * tfMs)
    while array.size(wHi) > 8
        array.shift(wHi)
        array.shift(wLo)
        array.shift(wDead)

// ---- outcome, resolved on CHART bars --------------------------------------
// A finer chart resolves the order of events more precisely, and a bar that
// touches both the stop and the target is called a STOP. Intrabar order is
// unknowable and flattering it would make the markers lie.
if showSetup and array.size(uEn) > 0
    j = array.size(uEn) - 1
    while j >= 0
        if not array.get(uDone, j)
            dir = array.get(uDir, j)
            tp  = array.get(uTpP, j)
            eqv = array.get(uEqP, j)
            banked = array.get(uBE, j)
            // once the equilibrium portion is banked the stop sits just past entry
            eff = banked ? array.get(uBeS, j) : array.get(uSlP, j)
            hitSl = dir == 1 ? low <= eff : high >= eff
            hitTp = dir == 1 ? high >= tp : low <= tp
            if hitSl
                if banked
                    lb = array.get(uBeLb, j)
                    if not na(lb)
                        label.set_text(lb, "BE ✓")
                else
                    label.set_text(array.get(uSlL, j), "SL ✗")
                array.set(uDone, j, true)
            else if hitTp
                label.set_text(array.get(uTpL, j), "TP ✓")
                array.set(uDone, j, true)
            else if not banked and not na(eqv) and (dir == 1 ? high >= eqv : low <= eqv)
                // equilibrium reached: part banked, stop moves to just past entry.
                // The original stop dims so its starting point stays visible.
                array.set(uBE, j, true)
                oln = array.get(uSl, j)
                if not na(oln)
                    line.set_color(oln, color.new(setSlC, beFade))
                olb = array.get(uSlL, j)
                if not na(olb)
                    label.set_textcolor(olb, color.new(setSlC, beFade))
                eqL = array.get(uEqL, j)
                if not na(eqL)
                    label.set_text(eqL, "BE ✓")
                bs = array.get(uBeS, j)
                if not na(bs) and not na(oln)
                    x1 = int(line.get_x1(oln))
                    x2 = int(line.get_x2(oln))
                    array.set(uBeLn, j, line.new(x1, bs, x2, bs, color=setEqC, width=setW, style=line.style_dotted))
                    array.set(uBeLb, j, label.new(x2, bs, "BE SL", style=label.style_label_left, color=HIDE, textcolor=setEqC, size=size.tiny))
        j := j - 1
