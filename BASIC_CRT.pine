// ===================== HELPERS ===============================================
f_lsz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small
f_lstyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Solid" ? line.style_solid : line.style_dotted

// is timestamp t inside the HHMM-HHMM session window on one of the listed days,
// read in tz? Works for ANY timestamp, not just the current bar — which is what
// lets the time filter judge the range candle's formation time.
f_winHit(int t, string sess, string days, string tz) =>
    bool hit = false
    if not na(t)
        if str.contains(days, str.tostring(dayofweek(t, tz)))
            parts = str.split(sess, "-")
            if array.size(parts) == 2
                a = array.get(parts, 0)
                b = array.get(parts, 1)
                m1 = int(60 * str.tonumber(str.substring(a, 0, 2)) + str.tonumber(str.substring(a, 2, 4)))
                m2 = int(60 * str.tonumber(str.substring(b, 0, 2)) + str.tonumber(str.substring(b, 2, 4)))
                md = 60 * hour(t, tz) + minute(t, tz)
                hit := m1 == m2 ? true : m1 < m2 ? (md >= m1 and md < m2) : (md >= m1 or md < m2)
    hit

mkLabel(int x, float y, string txt, string design, color mainCol, color txtCol, string szStr) =>
    bg = design == "Ghost"  ? color.new(color.gray, 100) : design == "Tinted" ? color.new(mainCol, 70) : design == "Chip" ? chart.bg_color : mainCol
    tc = design == "Filled" ? txtCol : mainCol
    label.new(x, y, txt, xloc=xloc.bar_time, style=label.style_label_left, color=bg, textcolor=tc, size=f_lsz(szStr))

TRANSP = color.new(color.gray, 100)

// ---- current & previous week start times (for the weekly filter) ----
curWkStart = time("W")
var int prevWkStart = na
if ta.change(time("W")) != 0
    prevWkStart := time("W")[1]
// which week bucket a formation-time belongs to: 0 = current, 1 = previous, 2 = older
f_wkBucket(int L) =>
    L >= curWkStart ? 0 : (na(prevWkStart) or L >= prevWkStart) ? 1 : 2
f_wkVisible(int bucket) =>
    (bucket == 0 and showCurWeek) or (bucket == 1 and showPrevWeek)

// ---- Daily/Weekly store ----
var array<line>  dwL   = array.new<line>()
var array<box>   dwB   = array.new<box>()
var array<label> dwLab = array.new<label>()
f_clearDW() =>
    while array.size(dwL) > 0
        line.delete(array.shift(dwL))
    while array.size(dwB) > 0
        box.delete(array.shift(dwB))
    while array.size(dwLab) > 0
        label.delete(array.shift(dwLab))
f_drawHTF(float hi, float lo, int st, int projMs, color lc, string tag) =>
    if not na(hi) and not na(lo) and not na(st)
        eqy = (hi + lo) / 2.0
        en  = st + projMs
        array.push(dwL, line.new(st, hi,  en, hi,  xloc=xloc.bar_time, color=lc, width=lw))
        array.push(dwL, line.new(st, lo,  en, lo,  xloc=xloc.bar_time, color=lc, width=lw))
        if showEqLn
            array.push(dwL, line.new(st, eqy, en, eqy, xloc=xloc.bar_time, color=color.new(lc, 30), width=eqLnWidth, style=f_lstyle(eqLnStyle)))
        if showPD
            array.push(dwB, box.new(st, hi,  en, eqy, xloc=xloc.bar_time, border_color=TRANSP, bgcolor=color.new(premC, 92)))
            array.push(dwB, box.new(st, eqy, en, lo,  xloc=xloc.bar_time, border_color=TRANSP, bgcolor=color.new(discC, 92)))
        if showHtfLbl
            hiTag = tag + " High" + (showHtfPx ? " " + str.tostring(hi, format.mintick) : "")
            loTag = tag + " Low"  + (showHtfPx ? " " + str.tostring(lo, format.mintick) : "")
            array.push(dwLab, mkLabel(en, hi, hiTag, labDesign, lc, labTxtCol, dwLabSz))
            array.push(dwLab, mkLabel(en, lo, loTag, labDesign, lc, labTxtCol, dwLabSz))

// ---- PD array (FVG/OB): box stores + parallel 50% EQ midline stores ----
var array<box>  fvgU  = array.new<box>()
var array<box>  fvgD  = array.new<box>()
var array<box>  obU   = array.new<box>()
var array<box>  obD   = array.new<box>()
var array<box>  fvgUh = array.new<box>()
var array<box>  fvgDh = array.new<box>()
var array<box>  obUh  = array.new<box>()
var array<box>  obDh  = array.new<box>()
var array<line> fvgUm = array.new<line>()
var array<line> fvgDm = array.new<line>()
var array<line> obUm  = array.new<line>()
var array<line> obDm  = array.new<line>()
f_addBoxT(array<box> a, array<line> m, float top, float bot, int left, color col, string txt) =>
    b = box.new(left, top, time, bot, xloc=xloc.bar_time, border_color=TRANSP, bgcolor=col, text=showPdLbl ? txt : "", text_color=pdTxtCol, text_halign=text.align_center, text_valign=text.align_center, text_size=f_lsz(pdLabSz))
    array.push(a, b)
    line lm = na
    if showFvgEq
        mid = (top + bot) / 2.0
        lm := line.new(left, mid, time, mid, xloc=xloc.bar_time, color=eqLnCol, width=eqLnWidth, style=f_lstyle(eqLnStyle))
    array.push(m, lm)
    while array.size(a) > pdKeep
        box.delete(array.shift(a))
        lmo = array.shift(m)
        if not na(lmo)
            line.delete(lmo)
f_maintainT(array<box> act, array<line> actM, array<box> hist, bool bull, color realCol) =>
    if array.size(act) > 0
        i = array.size(act) - 1
        while i >= 0
            b  = array.get(act, i)
            lm = array.get(actM, i)
            bucket = f_wkBucket(int(box.get_left(b)))
            if bucket >= 2
                array.remove(act, i)
                array.remove(actM, i)
                box.delete(b)
                if not na(lm)
                    line.delete(lm)
            else
                vis = f_wkVisible(bucket)
                box.set_right(b, time)
                box.set_bgcolor(b, vis ? realCol : TRANSP)
                box.set_text_color(b, vis ? pdTxtCol : TRANSP)
                if not na(lm)
                    line.set_x2(lm, time)
                    line.set_color(lm, vis and showFvgEq ? eqLnCol : TRANSP)
                mit = pdMit and (bull ? close < box.get_bottom(b) : close > box.get_top(b))
                if mit
                    array.remove(act, i)
                    array.remove(actM, i)
                    if not na(lm)
                        line.delete(lm)
                    if showHistPD
                        box.set_bgcolor(b, histC)
                        array.push(hist, b)
                        while array.size(hist) > pdKeep
                            box.delete(array.shift(hist))
                    else
                        box.delete(b)
            i := i - 1
f_pdScan(bool en, string tfName, float h1, float h3, float l1, float l3, float o3, float c3, int t2, bool nb) =>
    if en and nb
        bull = not na(h3) and not na(l1) and h3 < l1
        bear = not na(l3) and not na(h1) and l3 > h1
        if showFVG and bull
            f_addBoxT(fvgU, fvgUm, l1, h3, t2, fvgUpC, tfName + " FVG")
        if showFVG and bear
            f_addBoxT(fvgD, fvgDm, l3, h1, t2, fvgDnC, tfName + " FVG")
        if showOB and bull and c3 < o3
            f_addBoxT(obU, obUm, h3, l3, t2, obUpC, tfName + " OB")
        if showOB and bear and c3 > o3
            f_addBoxT(obD, obDm, h3, l3, t2, obDnC, tfName + " OB")

// title tag at the right end of an S/R or equal-H/L line
f_srLabel(label lb, bool show, line ln, string txt, color col, int ext, string sz) =>
    label out = lb
    if show and not na(ln)
        lvl = line.get_y2(ln)
        if na(out)
            out := label.new(bar_index + ext, lvl, txt, style=label.style_label_left, color=color.new(color.gray, 100), textcolor=col, size=f_lsz(sz))
        else
            label.set_xy(out, bar_index + ext, lvl)
            label.set_text(out, txt)
    out

// ===================== CORE: per-candle CRT ranges ===========================
sym    = syminfo.tickerid
cHigh  = request.security(sym, tfIn, high[1], lookahead=barmerge.lookahead_off)
cLow   = request.security(sym, tfIn, low[1],  lookahead=barmerge.lookahead_off)
cOpenT = request.security(sym, tfIn, time[1], lookahead=barmerge.lookahead_off)
cClose = request.security(sym, tfIn, close[1], lookahead=barmerge.lookahead_off)
tfMs   = timeframe.in_seconds(tfIn) * 1000
chartMs = timeframe.in_seconds(timeframe.period) * 1000
// range-TF ATR for stop padding. The range itself = the last closed candle (cHigh/cLow).
atrTf = request.security(sym, tfIn, ta.atr(14)[1], lookahead=barmerge.lookahead_off)
// chart-TF ATR — an alternative pad unit, and the tolerance for equal highs/lows
atrChart = ta.atr(14)

// ---- range slot filter ------------------------------------------------------
// Is the range whose candle opened at time t in an enabled slot? The 4H session
// index is ((h+1) % 24) / 4, which puts 23:00 and 00:00 opens in the same
// daily-open bucket (broker 4H grids shift an hour with US daylight saving, so
// each session lands on two adjacent SAST hours — the study labels both).
var sesSel = array.from(ses0, ses1, ses2, ses3, ses4, ses5)
var hrSel  = array.from(hr0, hr1, hr2, hr3, hr4, hr5, hr6, hr7, hr8, hr9, hr10, hr11, hr12, hr13, hr14, hr15, hr16, hr17, hr18, hr19, hr20, hr21, hr22, hr23)
slotTzUse = slotTz == "Exchange" ? syminfo.timezone : slotTz
f_slotVis(int t) =>
    bool v = true
    if slotOn and not na(t)
        h = hour(t, slotTzUse)
        if tfMs == 14400000
            v := array.get(sesSel, int(((h + 1) % 24) / 4))
        else if tfMs == 3600000
            v := array.get(hrSel, h)
    v

var array<line> hiA   = array.new<line>()
var array<line> loA   = array.new<line>()
var array<line> eqA   = array.new<line>()
var array<box>  shA   = array.new<box>()
var array<label> swLbA  = array.new<label>()
var array<label> brLbA  = array.new<label>()
// setup stores (parallel; one slot per setup, pruned together by setKeep)
var array<line>  sEntryLn = array.new<line>()
var array<line>  sTpLn    = array.new<line>()
var array<line>  sSlLn    = array.new<line>()
var array<label> sTpLb    = array.new<label>()
var array<label> sSlLb    = array.new<label>()
var array<label> sRrLb    = array.new<label>()
var array<int>   sDir     = array.new<int>()
var array<float> sTp      = array.new<float>()
var array<float> sSl      = array.new<float>()
var array<bool>  sDone    = array.new<bool>()
// break-even state, one slot per setup (parallel to the stores above)
var array<float> sBeLvl   = array.new<float>()   // trigger price (range EQ), na = no BE
var array<float> sBeStop  = array.new<float>()   // where the stop moves to
var array<bool>  sBeArm   = array.new<bool>()    // has the trigger been reached?
var array<line>  sBeLn    = array.new<line>()    // the EQ trigger line
var array<label> sBeLb    = array.new<label>()   // its "BE" tag
var array<line>  sBeSLn   = array.new<line>()    // the moved stop line (drawn on arm)
var array<label> sBeSLb   = array.new<label>()
// live setup watches: each = a closed HTF range being watched for a sweep+reclaim
var array<float> wHi   = array.new<float>()
var array<float> wLo   = array.new<float>()
var array<int>   wOpenT= array.new<int>()   // the range candle's OPEN time (for the formation-time filter)
var array<int>   wDead = array.new<int>()
var array<bool>  wSwH  = array.new<bool>()
var array<bool>  wSwL  = array.new<bool>()
var array<float> wExtH = array.new<float>()
var array<float> wExtL = array.new<float>()

// draw one sweep marker (design-aware) at a bar-time, pruning the shared store.
// tfName titles the marker so a 4H sweep never gets confused with a 1H one.
f_sweepMark(bool bull, int atT, float y, string tfName) =>
    style = sweepDesign == "Triangle S" ? (bull ? label.style_triangleup : label.style_triangledown) : sweepDesign == "Circle S" ? label.style_circle : (bull ? label.style_label_up : label.style_label_down)
    pre   = sweepTf ? tfName + " " : ""
    txt   = sweepDesign == "Label" ? (sweepLbl ? pre + "Sweep" : str.trim(pre)) : str.trim(pre + "S")
    col   = bull ? sweepUpC : sweepDnC
    lb = label.new(atT, y, txt, xloc=xloc.bar_time, style=style, color=color.new(col, 20), textcolor=chart.bg_color, size=f_lsz(sweepSz))
    array.push(swLbA, lb)
    while array.size(swLbA) > swKeep
        label.delete(array.shift(swLbA))
// same idea for a break — its own design, size, colours and pruning store, so
// the two layers never fight over each other's settings or marker budget.
f_breakMark(bool bull, int atT, float y, string tfName) =>
    style = breakDesign == "Triangle B" ? (bull ? label.style_triangleup : label.style_triangledown) : breakDesign == "Circle B" ? label.style_circle : (bull ? label.style_label_up : label.style_label_down)
    pre   = breakTf ? tfName + " " : ""
    txt   = breakDesign == "Label" ? (breakLbl ? pre + "Break" : str.trim(pre)) : str.trim(pre + "B")
    col   = bull ? breakUpC : breakDnC
    lb = label.new(atT, y, txt, xloc=xloc.bar_time, style=style, color=color.new(col, 20), textcolor=chart.bg_color, size=f_lsz(breakSz))
    array.push(brLbA, lb)
    while array.size(brLbA) > brKeep
        label.delete(array.shift(brLbA))
// One pass over a timeframe's last two closed candles, A (older) and B (the one
// just closed). Taking out A's high or low is the shared condition; what B does
// by the time it FINISHES decides the classification.
//
// Everything here comes from the [1]-offset bar of the source timeframe, so B is
// always a fully closed candle — nothing is ever classified mid-formation.
//
// BREAK  — B expands clear of the level. With brkStrict on, the whole body
//          (open AND close) has to be outside; a body still straddling the level
//          is indecision, not a break, and gets nothing.
// SWEEP  — B took the level and closed back INSIDE the range. Rejection.
//
// EACH LEVEL RESOLVES INDEPENDENTLY. A marker marks a LEVEL, not a candle: an
// outside candle that wicks below A's low and expands through A's high is two
// events — a sweep of the low AND a break of the high — and gets both tags, the
// same way a double sweep gets a tag on each side. On any ONE level a break
// still outranks a sweep (closing beyond a level is a strictly stronger
// statement than wicking through it), and that ranking is decided per side
// before any drawing, so which layers you have switched on never changes what
// a candle IS.
//
// bT is the source candle's OPEN time. On a chart TF below the source TF that
// is the far LEFT edge of the candle — an hour to the left of the wick for a 1H
// marker on a 2m chart — which is why an untethered tag appears floating over
// empty space. msLen lets us anchor at the candle's LAST CHART BAR instead,
// i.e. where the sweep or break was actually confirmed.
f_swpBrkScan(string tfName, bool swEn, bool brEn, float aLoV, float aHiV, float bLoV, float bHiV, float bO, float bC, int bT, int msLen, bool nb) =>
    if nb and not na(aLoV) and not na(aHiV) and not na(bO) and not na(bC)
        tookLo = bLoV < aLoV
        tookHi = bHiV > aHiV
        bodyHi = math.max(bO, bC)
        bodyLo = math.min(bO, bC)
        brUp = tookHi and (brkStrict ? bodyLo > aHiV : bC > aHiV)
        brDn = tookLo and (brkStrict ? bodyHi < aLoV : bC < aLoV)
        // each side on its own: taking a level and NOT breaking it = sweeping it.
        // A candle that takes both sides therefore gets a tag on each — a double
        // sweep shows both, an outside candle shows a sweep AND a break.
        swDn = tookHi and not brUp and bC < aHiV   // took the high, closed back inside
        swUp = tookLo and not brDn and bC > aLoV   // took the low,  closed back inside
        // the candle's last CHART bar, clamped to now. bT + msLen - 1 is not a
        // real bar open, and xloc.bar_time snaps such a timestamp to the NEXT
        // bar — one bar past the candle. Stepping back one chart bar lands the
        // marker exactly on the candle that confirmed the event (verified
        // against every source/chart pairing tested).
        confT = math.min(bT + math.max(0, msLen - chartMs), time)
        swT = sweepAnchor == "Candle open" ? bT : confT
        brT = breakAnchor == "Candle open" ? bT : confT
        if brEn and brUp
            f_breakMark(true, brT, bHiV, tfName)
        if brEn and brDn
            f_breakMark(false, brT, bLoV, tfName)
        if swEn and swDn
            f_sweepMark(false, swT, bHiV, tfName)
        if swEn and swUp
            f_sweepMark(true, swT, bLoV, tfName)

// how far past the stop anchor to sit, in whichever unit is selected, plus the
// flat tick buffer. rngH is the height of the CRT range this setup came from, so
// the "% of range height" mode scales itself to the instrument and timeframe.
f_slPad(float rngH) =>
    ptSzSl = pointSize > 0 ? pointSize : syminfo.mintick
    base = slPadMode == "ATR of range TF" ? slPadVal * nz(atrTf, 0) : slPadMode == "ATR of chart TF" ? slPadVal * nz(atrChart, 0) : slPadMode == "% of range height" ? slPadVal / 100.0 * rngH : slPadMode == "% of price" ? slPadVal / 100.0 * close : slPadVal * ptSzSl
    base + slBuffTk * syminfo.mintick

// build one setup (RR-gated): entry line + short titled TP/SL, tracked for hits.
// Anchored on the live entry bar (bar_index) with a fixed short projection.
f_makeSetup(int dir, float entry, float sl, float tp, float eqLvl, int startX) =>
    risk = math.abs(entry - sl)
    rew  = math.abs(tp - entry)
    rr   = risk > 0 ? rew / risk : 0.0
    if rr >= setupMinRR and tp != entry and ((dir == 1 and tp > entry) or (dir == -1 and tp < entry))
        dirC = dir == 1 ? setupLongC : setupShortC
        shortEndX = startX + 4
        // entry / TP / SL all the SAME short dotted length with tiny titles.
        // LE = long entry, SE = short entry.
        lnE = line.new(startX, entry, shortEndX, entry, color=dirC, width=setupLineW, style=line.style_dotted)
        lbR = label.new(shortEndX, entry, dir == 1 ? "LE" : "SE", style=label.style_label_left, color=color.new(color.gray, 100), textcolor=dirC, size=size.tiny)
        lnT = line.new(startX, tp, shortEndX, tp, color=setupTpC, width=setupLineW, style=line.style_dotted)
        lnS = line.new(startX, sl, shortEndX, sl, color=setupSlC, width=setupLineW, style=line.style_dotted)
        lbT = label.new(shortEndX, tp, "TP", style=label.style_label_left, color=color.new(color.gray, 100), textcolor=setupTpC, size=size.tiny)
        lbSl = label.new(shortEndX, sl, "SL", style=label.style_label_left, color=color.new(color.gray, 100), textcolor=setupSlC, size=size.tiny)
        array.push(sEntryLn, lnE)
        array.push(sTpLn, lnT)
        array.push(sSlLn, lnS)
        array.push(sTpLb, lbT)
        array.push(sSlLb, lbSl)
        array.push(sRrLb, lbR)
        array.push(sDir, dir)
        array.push(sTp, tp)
        array.push(sSl, sl)
        array.push(sDone, false)
        // ---- break-even setup ----
        // Only valid when the range EQ actually sits BETWEEN entry and target.
        // If the reclaim let us in beyond the EQ there is nothing to arm, so the
        // setup simply runs without a BE leg rather than triggering instantly.
        float beLvl = na
        float beStp = na
        if beOn and ((dir == 1 and eqLvl > entry and eqLvl < tp) or (dir == -1 and eqLvl < entry and eqLvl > tp))
            beLvl := eqLvl
            beStp := dir == 1 ? entry + risk * bePct / 100.0 : entry - risk * bePct / 100.0
        line  lnB = na
        label lbB = na
        if not na(beLvl)
            lnB := line.new(startX, beLvl, shortEndX, beLvl, color=beCol, width=setupLineW, style=line.style_dotted)
            lbB := label.new(shortEndX, beLvl, beTxt, style=label.style_label_left, color=color.new(color.gray, 100), textcolor=beCol, size=size.tiny)
        array.push(sBeLvl, beLvl)
        array.push(sBeStop, beStp)
        array.push(sBeArm, false)
        line  naLn = na
        label naLb = na
        array.push(sBeLn, lnB)
        array.push(sBeLb, lbB)
        array.push(sBeSLn, naLn)
        array.push(sBeSLb, naLb)
        while array.size(sEntryLn) > setKeep
            line.delete(array.shift(sEntryLn))
            line.delete(array.shift(sTpLn))
            line.delete(array.shift(sSlLn))
            label.delete(array.shift(sTpLb))
            label.delete(array.shift(sSlLb))
            label.delete(array.shift(sRrLb))
            lnBo = array.shift(sBeLn)
            if not na(lnBo)
                line.delete(lnBo)
            lbBo = array.shift(sBeLb)
            if not na(lbBo)
                label.delete(lbBo)
            lnSo = array.shift(sBeSLn)
            if not na(lnSo)
                line.delete(lnSo)
            lbSo = array.shift(sBeSLb)
            if not na(lbSo)
                label.delete(lbSo)
            array.shift(sBeLvl)
            array.shift(sBeStop)
            array.shift(sBeArm)
            array.shift(sDir)
            array.shift(sTp)
            array.shift(sSl)
            array.shift(sDone)

var label labHi = na
var label labLo = na
var label labEq = na
HIDE = color.new(color.gray, 100)

newClosed = not na(cHigh) and not na(cOpenT) and (na(cOpenT[1]) or cOpenT != cOpenT[1])
// does this range's slot pass the picker? (always true with the picker off)
slotOk = f_slotVis(cOpenT)

if newClosed and slotOk
    startT = cOpenT
    endT   = cOpenT + liveN * tfMs
    eqv    = (cHigh + cLow) / 2.0
    rangePx = cHigh - cLow

    lh = line.new(startT, cHigh, endT, cHigh, xloc=xloc.bar_time, color=curCol, width=lw)
    ll = line.new(startT, cLow,  endT, cLow,  xloc=xloc.bar_time, color=curCol, width=lw)
    le = showEqLn ? line.new(startT, eqv, endT, eqv, xloc=xloc.bar_time, color=eqLnCol, width=eqLnWidth, style=f_lstyle(eqLnStyle)) : na
    shBg = color.new(shadeCol, shadeOpacity)
    sh  = showShade and shadeDepth > 0 ? box.new(startT, cHigh, startT + int(shadeDepth * (endT - startT)), cLow, xloc=xloc.bar_time, border_color=TRANSP, bgcolor=shBg) : na
    array.push(hiA, lh)
    array.push(loA, ll)
    array.push(eqA, le)
    array.push(shA, sh)

    hiName = shortHL ? "CRT H" : "CRT High"
    loName = shortHL ? "CRT L" : "CRT Low"
    hiTxt  = hiName + (showPx ? " " + str.tostring(cHigh, format.mintick) : "")
    loTxt  = loName + (showPx ? " " + str.tostring(cLow,  format.mintick) : "")

    ptSz  = pointSize > 0 ? pointSize : syminfo.mintick
    ppSz  = pipSize   > 0 ? pipSize   : syminfo.mintick * 10
    ptsN  = math.round(rangePx / ptSz)
    brNum = brUnit == "Pips" ? math.round(rangePx / ppSz) : brUnit == "Ticks" ? math.round(rangePx / syminfo.mintick) : na
    brStr = brUnit == "None" ? "" : brUnit == "Price" ? "(" + str.tostring(rangePx, format.mintick) + ")" : "(" + str.tostring(brNum, "#") + " " + (brUnit == "Pips" ? "pips" : "ticks") + ")"
    eqTxt = "EQ" + (showEqPx ? " " + str.tostring(eqv, format.mintick) : "") + (showSize ? "  " + str.tostring(ptsN, "#") + " PTS" : "") + (brStr == "" ? "" : "  " + brStr)

    if not na(labHi)
        label.delete(labHi)
    if not na(labLo)
        label.delete(labLo)
    if not na(labEq)
        label.delete(labEq)
    labHi := showHL    ? mkLabel(endT, cHigh, hiTxt, labDesign, hlLabCol, labTxtCol, labSz) : na
    labLo := showHL    ? mkLabel(endT, cLow,  loTxt, labDesign, hlLabCol, labTxtCol, labSz) : na
    labEq := showEqLab ? mkLabel(endT, eqv,   eqTxt, labDesign, eqLabCol, labTxtCol, eqLabSz) : na

    n = array.size(hiA)
    for i = 0 to n - 1
        age = n - 1 - i
        col = age == 0 ? curCol : age == 1 ? (showPrev ? prevCol : HIDE) : (showHist ? histCol : HIDE)
        line.set_color(array.get(hiA, i), col)
        line.set_color(array.get(loA, i), col)
        lex = array.get(eqA, i)
        if not na(lex)
            line.set_color(lex, age == 0 ? eqLnCol : col)
        shx = array.get(shA, i)
        if not na(shx)
            // shading only ever fills the CURRENT range; older ranges are line-only
            box.set_bgcolor(shx, age == 0 ? color.new(shadeCol, shadeOpacity) : HIDE)

    while array.size(hiA) > maxHist + 2
        line.delete(array.shift(hiA))
        line.delete(array.shift(loA))
        led = array.shift(eqA)
        if not na(led)
            line.delete(led)
        shd = array.shift(shA)
        if not na(shd)
            box.delete(shd)

// ===================== OPTIONAL: Sweeps & Breaks (per timeframe) ==============
// Data loads only for timeframes where AT LEAST ONE of the two layers is enabled
// (request.security gated inside each if), so disabled TFs cost no memory. Each
// timeframe fires on its own closed candles and carries its own title.
sw5 = showSweep and swp5On
br5 = showBreak and brk5On
if sw5 or br5
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "5",   [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("5m", sw5, br5, al, ah, bl, bh, bo, bc, int(bt), 300000, not na(bt) and bt != bt[1])
sw15 = showSweep and swp15On
br15 = showBreak and brk15On
if sw15 or br15
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "15",  [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("15m", sw15, br15, al, ah, bl, bh, bo, bc, int(bt), 900000, not na(bt) and bt != bt[1])
sw30 = showSweep and swp30On
br30 = showBreak and brk30On
if sw30 or br30
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "30",  [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("30m", sw30, br30, al, ah, bl, bh, bo, bc, int(bt), 1800000, not na(bt) and bt != bt[1])
sw1 = showSweep and swp1On
br1H = showBreak and brk1On
if sw1 or br1H
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "60",  [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("1H", sw1, br1H, al, ah, bl, bh, bo, bc, int(bt), 3600000, not na(bt) and bt != bt[1])
sw2 = showSweep and swp2On
br2H = showBreak and brk2On
if sw2 or br2H
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "120", [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("2H", sw2, br2H, al, ah, bl, bh, bo, bc, int(bt), 7200000, not na(bt) and bt != bt[1])
sw4 = showSweep and swp4On
br4H = showBreak and brk4On
if sw4 or br4H
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "240", [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("4H", sw4, br4H, al, ah, bl, bh, bo, bc, int(bt), 14400000, not na(bt) and bt != bt[1])
sw8 = showSweep and swp8On
br8H = showBreak and brk8On
if sw8 or br8H
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "480", [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("8H", sw8, br8H, al, ah, bl, bh, bo, bc, int(bt), 28800000, not na(bt) and bt != bt[1])
swD = showSweep and swpDOn
brD = showBreak and brkDOn
if swD or brD
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "1D",  [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("D", swD, brD, al, ah, bl, bh, bo, bc, int(bt), 86400000, not na(bt) and bt != bt[1])
swW = showSweep and swpWOn
brW = showBreak and brkWOn
if swW or brW
    [al,ah,bl,bh,bo,bc,bt] = request.security(sym, "1W",  [low[2],high[2],low[1],high[1],open[1],close[1],time[1]], lookahead=barmerge.lookahead_off)
    f_swpBrkScan("W", swW, brW, al, ah, bl, bh, bo, bc, int(bt), 604800000, not na(bt) and bt != bt[1])

// ===================== SETUP TIME FILTER =====================================
// Evaluated on the CURRENT chart bar — i.e. the bar the reclaim happens on, which
// is the bar the trade would actually start on. A blocked bar does NOT consume the
// watch: if the same range is still swept when an allowed bar arrives, the setup
// fires then instead of being lost.
tzUse   = tfltTz == "Exchange" ? syminfo.timezone : tfltTz
daysUse = tfltDays == "" ? "1234567" : tfltDays
inBlk   = not na(time(timeframe.period, blkSess + ":" + daysUse, tzUse))
inAlw   = not na(time(timeframe.period, alwSess + ":" + daysUse, tzUse))
// Block wins on overlap. With the master switch off nothing is filtered.
setupTimeOk = not tfltOn or ((not (blkOn and inBlk)) and (not alwOn or inAlw))
bgcolor(tfltOn and tfltShade and blkOn and inBlk ? tfltShadeC : na, title="Blocked hours")
// The same verdict for the RANGE CANDLE'S formation time — used when "Windows
// apply to" is set to Range formation. The session that BUILT the range is what
// carried the measured edge, so the windows judge that timestamp instead of the
// bar the setup fires on.
f_watchTimeOk(int t0) =>
    bool ok = true
    if tfltOn
        blkHit = blkOn and f_winHit(t0, blkSess, daysUse, tzUse)
        alwHit = f_winHit(t0, alwSess, daysUse, tzUse)
        ok := not blkHit and (not alwOn or alwHit)
    ok

// ===================== OPTIONAL: CRT setups (live sweep → reclaim) ============
// The range = the last CLOSED range-TF candle. The MOMENT it closes we arm a
// watch and then track live chart-TF bars: when price sweeps the range high/low
// and a bar CLOSES back inside (the impulsive reclaim), we enter THERE — we do
// NOT wait for the whole next HTF candle to close. SL beyond the swept extreme,
// TP the opposite range extreme. Use a chart TF below the range TF for precision.
// 2-candle = reclaim in the very next candle; 3-candle allows one candle later.
// rolling range-height history for the relative size floor. Every range counts
// toward the regime — including slot-muted ones — because the regime describes
// the instrument, not the selection. rngMed is read BEFORE this candle is
// pushed, so the floor compares against the PRIOR 20 ranges, as in the study.
var array<float> rngHist = array.new<float>()
float rngMed = array.size(rngHist) >= 5 ? array.median(rngHist) : na
sizeOk = not qualSize or na(rngMed) or cHigh - cLow >= rngMed
if newClosed and not na(cHigh) and not na(cLow)
    array.push(rngHist, cHigh - cLow)
    while array.size(rngHist) > 20
        array.shift(rngHist)

// A range smaller than either size floor still DRAWS exactly as always — it
// just arms no watch, because the smallest ranges were the worst-testing
// bucket on every instrument.
if newClosed and slotOk and sizeOk and showSetup and (setup2c or setup3c) and not na(cHigh) and not na(cLow) and (setupMinRng <= 0 or cHigh - cLow >= setupMinRng * nz(atrTf, 0))
    array.push(wHi, cHigh)
    array.push(wLo, cLow)
    array.push(wOpenT, cOpenT)
    array.push(wDead, cOpenT + (setup3c ? 3 : 2) * tfMs)
    array.push(wSwH, false)
    array.push(wSwL, false)
    array.push(wExtH, cHigh)
    array.push(wExtL, cLow)
    while array.size(wHi) > 10
        array.shift(wHi)
        array.shift(wLo)
        array.shift(wOpenT)
        array.shift(wDead)
        array.shift(wSwH)
        array.shift(wSwL)
        array.shift(wExtH)
        array.shift(wExtL)

htfConf = setupConf != "Chart bar close (original)"
if showSetup and barstate.isconfirmed and array.size(wHi) > 0
    k = array.size(wHi) - 1
    while k >= 0
        // With range-candle confirmation, a candle that closed INSIDE the watch
        // window can be reported on a chart bar past it (a weekend or session
        // gap sits between them). Judge the candle's open time, not the
        // reporting bar, so those legitimate confirmations are not thrown away.
        rescue = htfConf and newClosed and not na(cOpenT) and cOpenT < array.get(wDead, k)
        if time > array.get(wDead, k) and not rescue
            array.remove(wHi, k)
            array.remove(wLo, k)
            array.remove(wOpenT, k)
            array.remove(wDead, k)
            array.remove(wSwH, k)
            array.remove(wSwL, k)
            array.remove(wExtH, k)
            array.remove(wExtL, k)
        else
            hi = array.get(wHi, k)
            lo = array.get(wLo, k)
            // sweep state and swept extreme as they stood BEFORE this chart bar.
            // The range-candle confirmation judges the candle that just CLOSED,
            // and the current chart bar already belongs to the next one.
            pSwH = array.get(wSwH, k)
            pSwL = array.get(wSwL, k)
            pExH = array.get(wExtH, k)
            pExL = array.get(wExtL, k)
            if high > pExH
                array.set(wExtH, k, high)
            if low < pExL
                array.set(wExtL, k, low)
            swH = pSwH or high > hi
            swL = pSwL or low < lo
            array.set(wSwH, k, swH)
            array.set(wSwL, k, swL)
            eqR  = (hi + lo) / 2.0
            bool canS = false
            bool canL = false
            if htfConf
                // fires only when a range-TF candle just closed, judged on THAT
                // candle: it swept the watched range and its own close is back
                // inside. This is the entry that measured best.
                if newClosed
                    canS := pSwH and cClose < hi
                    canL := pSwL and cClose > lo
            else
                // original behaviour: the first CHART bar that closes back
                // inside after the sweep fires the setup
                canS := swH and close < hi   // swept the high, now reclaimed back inside
                canL := swL and close > lo   // swept the low,  now reclaimed back inside
            refC = htfConf ? cClose : close
            wdir = canS and canL ? (refC < eqR ? -1 : 1) : canS ? -1 : canL ? 1 : 0
            tOk = tfltRef == "Entry bar" ? setupTimeOk : f_watchTimeOk(array.get(wOpenT, k))
            // reclaim band: where the confirming close sits, as a share of the
            // range measured back in from the swept level. A close outside the
            // band skips THIS bar only — the watch stays alive, so a later bar
            // closing inside the band can still fire the setup.
            bool qOk = true
            if qualRec and wdir != 0
                recPos = (wdir == -1 ? hi - refC : refC - lo) / (hi - lo)
                qOk := recPos >= qualRecLo / 100 and recPos <= qualRecHi / 100
            if wdir != 0 and tOk and qOk
                rngH = hi - lo
                pad  = f_slPad(rngH)
                // the sweep wick as of the confirming candle
                wickA = wdir == -1 ? (htfConf ? pExH : array.get(wExtH, k)) : (htfConf ? pExL : array.get(wExtL, k))
                // anchor: half the range past the swept level (never tighter
                // than the wick — the config that tested best on all seven
                // instruments), or the wick itself, or the bare range boundary
                anchor = slRef == "Range boundary" ? (wdir == -1 ? hi : lo) : slRef == "Swept extreme" ? wickA : (wdir == -1 ? math.max(hi + 0.5 * rngH, wickA) : math.min(lo - 0.5 * rngH, wickA))
                float sl = wdir == -1 ? anchor + pad : anchor - pad
                // floor measured from ENTRY, so a reclaim that closes right on
                // top of the swept wick still gets a survivable stop
                if slMinOn
                    minD = slMinPct / 100.0 * rngH
                    sl := wdir == -1 ? math.max(sl, refC + minD) : math.min(sl, refC - minD)
                tp = wdir == -1 ? lo : hi
                f_makeSetup(wdir, refC, sl, tp, eqR, bar_index)
                array.remove(wHi, k)
                array.remove(wLo, k)
                array.remove(wOpenT, k)
                array.remove(wDead, k)
                array.remove(wSwH, k)
                array.remove(wSwL, k)
                array.remove(wExtH, k)
                array.remove(wExtL, k)
        k := k - 1

// mark TP / SL hits: when price reaches a level, tag the label (✓ win, ✗ loss)
if showSetup and array.size(sTp) > 0
    j = array.size(sTp) - 1
    while j >= 0
        if not array.get(sDone, j)
            dir = array.get(sDir, j)
            tpv = array.get(sTp, j)
            slv = array.get(sSl, j)
            // The stop in force for THIS bar is the one that was already armed
            // when the bar opened. If a single bar both reaches the EQ trigger
            // and trades through the original stop we cannot know the order, so
            // we resolve it as a stop-out rather than flattering the result.
            wasArm = array.get(sBeArm, j)
            eff = wasArm ? array.get(sBeStop, j) : slv
            hitTp = dir == 1 ? high >= tpv : low  <= tpv
            hitSl = dir == 1 ? low  <= eff : high >= eff
            if hitSl
                if wasArm
                    lbS = array.get(sBeSLb, j)
                    if not na(lbS)
                        label.set_text(lbS, beTxt + " ✓")
                else
                    label.set_text(array.get(sSlLb, j), "SL ✗")
                array.set(sDone, j, true)
            else if hitTp
                label.set_text(array.get(sTpLb, j), "TP ✓")
                array.set(sDone, j, true)
            else
                // not resolved this bar — arm break-even if the EQ was reached
                bl = array.get(sBeLvl, j)
                if not na(bl) and not wasArm and (dir == 1 ? high >= bl : low <= bl)
                    array.set(sBeArm, j, true)
                    // fade the original stop so its starting point stays visible
                    oln = array.get(sSlLn, j)
                    if not na(oln)
                        line.set_color(oln, color.new(setupSlC, beFade))
                    olb = array.get(sSlLb, j)
                    if not na(olb)
                        label.set_textcolor(olb, color.new(setupSlC, beFade))
                    // draw the moved stop alongside it, same length and style
                    bs = array.get(sBeStop, j)
                    if not na(bs) and not na(oln)
                        x1 = line.get_x1(oln)
                        x2 = line.get_x2(oln)
                        nln = line.new(x1, bs, x2, bs, color=beCol, width=setupLineW, style=line.style_dotted)
                        nlb = label.new(x2, bs, beTxt + " SL", style=label.style_label_left, color=color.new(color.gray, 100), textcolor=beCol, size=size.tiny)
                        array.set(sBeSLn, j, nln)
                        array.set(sBeSLb, j, nlb)
        j := j - 1

// ===================== OPTIONAL: Daily / Weekly CRT ranges ====================
ndHi = request.security(sym, "1D", high[1], lookahead=barmerge.lookahead_off)
ndLo = request.security(sym, "1D", low[1],  lookahead=barmerge.lookahead_off)
ndT  = request.security(sym, "1D", time[1], lookahead=barmerge.lookahead_off)
nwHi = request.security(sym, "1W", high[1], lookahead=barmerge.lookahead_off)
nwLo = request.security(sym, "1W", low[1],  lookahead=barmerge.lookahead_off)
nwT  = request.security(sym, "1W", time[1], lookahead=barmerge.lookahead_off)

shiftMs = 7 * 3600 * 1000
newNYd = ta.change(dayofmonth(time + shiftMs, "America/New_York")) != 0
newNYw = ta.change(weekofyear(time + shiftMs, "America/New_York")) != 0

var float cdH = na
var float cdL = na
var int   cdS = na
var float pdH = na
var float pdL = na
var int   pdS = na
if newNYd
    pdH := cdH
    pdL := cdL
    pdS := cdS
    cdH := high
    cdL := low
    cdS := time
else
    cdH := math.max(nz(cdH, high), high)
    cdL := math.min(nz(cdL, low),  low)

var float cwH = na
var float cwL = na
var int   cwS = na
var float pwH = na
var float pwL = na
var int   pwS = na
if newNYw
    pwH := cwH
    pwL := cwL
    pwS := cwS
    cwH := high
    cwL := low
    cwS := time
else
    cwH := math.max(nz(cwH, high), high)
    cwL := math.min(nz(cwL, low),  low)

prevDHi = nyAnchor ? pdH : ndHi
prevDLo = nyAnchor ? pdL : ndLo
prevDSt = nyAnchor ? pdS : ndT
prevWHi = nyAnchor ? pwH : nwHi
prevWLo = nyAnchor ? pwL : nwLo
prevWSt = nyAnchor ? pwS : nwT
newDailyEvt  = nyAnchor ? newNYd : (ndT != ndT[1])
newWeeklyEvt = nyAnchor ? newNYw : (nwT != nwT[1])
dProjMs = 86400000 * htfProj
wProjMs = 604800000 * htfProj

if (showDR and newDailyEvt) or (showWR and newWeeklyEvt)
    f_clearDW()
    if showDR
        f_drawHTF(prevDHi, prevDLo, int(prevDSt), dProjMs, dCol, "D")
    if showWR
        f_drawHTF(prevWHi, prevWLo, int(prevWSt), wProjMs, wCol, "W")

// ===================== OPTIONAL: Multi-TF FVG / Order Blocks ==================
// Data is loaded ONLY for timeframes that are enabled AND while FVG/OB is on, so
// disabled timeframes cost no memory (request.security is gated inside each if).
// This prevents "Memory limits exceeded" from loading 5m/15m/30m on a high chart.
pdaOn = showFVG or showOB
if pdaOn and tf5On
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "5",   [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "5m", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])
if pdaOn and tf15On
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "15",  [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "15m", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])
if pdaOn and tf30On
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "30",  [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "30m", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])
if pdaOn and tf1On
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "60",  [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "1h", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])
if pdaOn and tf2On
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "120", [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "2h", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])
if pdaOn and tf4On
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "240", [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "4h", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])
if pdaOn and tf8On
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "480", [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "8h", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])
if pdaOn and tfDOn
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "1D",  [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "1D", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])
if pdaOn and tfWOn
    [h1,h3,l1,l3,o3,c3,t1,t2] = request.security(sym, "1W",  [high[1],high[3],low[1],low[3],open[3],close[3],time[1],time[2]], lookahead=barmerge.lookahead_off)
    f_pdScan(true, "1W", h1, h3, l1, l3, o3, c3, int(t2), not na(t1) and t1 != t1[1])

if showFVG
    f_maintainT(fvgU, fvgUm, fvgUh, true,  fvgUpC)
    f_maintainT(fvgD, fvgDm, fvgDh, false, fvgDnC)
if showOB
    f_maintainT(obU, obUm, obUh, true,  obUpC)
    f_maintainT(obD, obDm, obDh, false, obDnC)

// ===================== OPTIONAL: Swing S/R + Equal H/L ========================
srUseTF = srTF == "" ? timeframe.period : srTF
[srPh, srPl] = request.security(sym, srUseTF, [ta.pivothigh(srLen, srLen), ta.pivotlow(srLen, srLen)], lookahead=barmerge.lookahead_off)
var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
var line resLine = na
var line supLine = na
var line eqhLine = na
var line eqlLine = na
var label resLbl = na
var label supLbl = na
var label eqhLbl = na
var label eqlLbl = na
var int resBar = na
var int supBar = na
var int eqhBar = na
var int eqlBar = na

if not na(srPh)
    prevPH := lastPH
    lastPH := srPh
    if showSR
        if not na(resLine)
            line.delete(resLine)
        resLine := line.new(bar_index - srLen, srPh, bar_index, srPh, color=resCol, width=2)
        resBar  := bar_index - srLen
    if showEQL and not na(prevPH) and math.abs(lastPH - prevPH) <= eqlTol * atrChart
        if not na(eqhLine)
            line.delete(eqhLine)
        eqhLine := line.new(bar_index - srLen, math.max(lastPH, prevPH), bar_index, math.max(lastPH, prevPH), color=eqlCol, style=line.style_dotted)
        eqhBar  := bar_index - srLen
if not na(srPl)
    prevPL := lastPL
    lastPL := srPl
    if showSR
        if not na(supLine)
            line.delete(supLine)
        supLine := line.new(bar_index - srLen, srPl, bar_index, srPl, color=supCol, width=2)
        supBar  := bar_index - srLen
    if showEQL and not na(prevPL) and math.abs(lastPL - prevPL) <= eqlTol * atrChart
        if not na(eqlLine)
            line.delete(eqlLine)
        eqlLine := line.new(bar_index - srLen, math.min(lastPL, prevPL), bar_index, math.min(lastPL, prevPL), color=eqlCol, style=line.style_dotted)
        eqlBar  := bar_index - srLen

if not na(resLine)
    line.set_x1(resLine, srMaxLen > 0 ? math.max(nz(resBar, bar_index), bar_index - srMaxLen) : nz(resBar, bar_index))
    line.set_x2(resLine, bar_index + srExt)
if not na(supLine)
    line.set_x1(supLine, srMaxLen > 0 ? math.max(nz(supBar, bar_index), bar_index - srMaxLen) : nz(supBar, bar_index))
    line.set_x2(supLine, bar_index + srExt)
if not na(eqhLine)
    line.set_x1(eqhLine, srMaxLen > 0 ? math.max(nz(eqhBar, bar_index), bar_index - srMaxLen) : nz(eqhBar, bar_index))
    line.set_x2(eqhLine, bar_index + srExt)
if not na(eqlLine)
    line.set_x1(eqlLine, srMaxLen > 0 ? math.max(nz(eqlBar, bar_index), bar_index - srMaxLen) : nz(eqlBar, bar_index))
    line.set_x2(eqlLine, bar_index + srExt)
resLbl := f_srLabel(resLbl, showSR and showSrLbl,  resLine, "Resistance", resCol, srExt, srLabSz)
supLbl := f_srLabel(supLbl, showSR and showSrLbl,  supLine, "Support",    supCol, srExt, srLabSz)
eqhLbl := f_srLabel(eqhLbl, showEQL and showSrLbl, eqhLine, "EQH",        eqlCol, srExt, srLabSz)
eqlLbl := f_srLabel(eqlLbl, showEQL and showSrLbl, eqlLine, "EQL",        eqlCol, srExt, srLabSz)

// ===================== OPTIONAL: Supply / Demand zones ========================
sdUseTF = sdTF == "" ? timeframe.period : sdTF
[sdPhV, sdPhBody, sdPlV, sdPlBody] = request.security(sym, sdUseTF, [ta.pivothigh(sdLen, sdLen), math.max(open[sdLen], close[sdLen]), ta.pivotlow(sdLen, sdLen), math.min(open[sdLen], close[sdLen])], lookahead=barmerge.lookahead_off)
var array<box> supplyA = array.new<box>()
var array<box> demandA = array.new<box>()
var array<int> supplyT = array.new<int>()
var array<int> demandT = array.new<int>()
if showSD and not na(sdPhV)
    bS = box.new(bar_index - sdLen, sdPhV, bar_index, sdPhBody, border_color=TRANSP, bgcolor=supplyC, text=showSdLbl ? "Supply" : "", text_color=zoneTxtCol, text_halign=text.align_center, text_valign=text.align_center, text_size=f_lsz(sdLabSz))
    array.push(supplyA, bS)
    array.push(supplyT, time)
    while array.size(supplyA) > sdKeep
        box.delete(array.shift(supplyA))
        array.shift(supplyT)
if showSD and not na(sdPlV)
    bD = box.new(bar_index - sdLen, sdPlBody, bar_index, sdPlV, border_color=TRANSP, bgcolor=demandC, text=showSdLbl ? "Demand" : "", text_color=zoneTxtCol, text_halign=text.align_center, text_valign=text.align_center, text_size=f_lsz(sdLabSz))
    array.push(demandA, bD)
    array.push(demandT, time)
    while array.size(demandA) > sdKeep
        box.delete(array.shift(demandA))
        array.shift(demandT)
// weekly filter + trail — supply
if array.size(supplyA) > 0
    i = array.size(supplyA) - 1
    while i >= 0
        b = array.get(supplyA, i)
        bucket = f_wkBucket(array.get(supplyT, i))
        if bucket >= 2
            box.delete(b)
            array.remove(supplyA, i)
            array.remove(supplyT, i)
        else
            vis = showSD and f_wkVisible(bucket)
            box.set_right(b, bar_index + sdExt)
            box.set_bgcolor(b, vis ? supplyC : TRANSP)
            box.set_text_color(b, vis ? zoneTxtCol : TRANSP)
        i := i - 1
// weekly filter + trail — demand
if array.size(demandA) > 0
    i2 = array.size(demandA) - 1
    while i2 >= 0
        b = array.get(demandA, i2)
        bucket = f_wkBucket(array.get(demandT, i2))
        if bucket >= 2
            box.delete(b)
            array.remove(demandA, i2)
            array.remove(demandT, i2)
        else
            vis = showSD and f_wkVisible(bucket)
            box.set_right(b, bar_index + sdExt)
            box.set_bgcolor(b, vis ? demandC : TRANSP)
            box.set_text_color(b, vis ? zoneTxtCol : TRANSP)
        i2 := i2 - 1
