//@version=6
// =============================================================================
// BASIC CRT  —  Candle Range Theory marker + optional HTF confluence layers
// -----------------------------------------------------------------------------
// CORE (always on): High / Low / 50% EQ of each closed candle on a chosen TF.
// The range is left open; optional internal shading (with adjustable opacity and
// depth) highlights it without a hard left edge.
//
// OPTIONAL LAYERS (all default OFF — the core stays simple when unused):
//   1. Daily & Weekly CRT ranges + premium/discount (broker or NY-17:00 anchor)
//   2. FVGs & Order Blocks across 5m/15m/30m/1H/2H/4H/8H/D/W, each titled with
//      its timeframe, with a 50% EQ line, mitigation, and historical toggle
//   3. Sweeps & Breaks per timeframe, each marker titled with its own TF
//   4. Swing High/Low support & resistance + equal highs/lows (own source TF)
//   5. Supply / demand zones at recent swings (own source TF)
// Every element has its own on/off switch, colours, and label size.
//
// Non-repainting: HTF data via request.security(closed bars, lookahead_off);
// swings via confirmed pivots.
// =============================================================================
indicator("Basic CRT", overlay=true, max_lines_count=500, max_labels_count=100, max_boxes_count=500)

// ===================== CORE INPUTS ===========================================
tfIn   = input.timeframe("240", "Range timeframe", tooltip="Which candle defines each range. 240 = 4H.")
liveN  = input.int(3, "Keep range live for N candles", minval=1)

gVis   = "Visibility"
showPrev = input.bool(true,  "Show previous range", group=gVis)
showHist = input.bool(false, "Show historical ranges", group=gVis)
maxHist  = input.int(20, "Max historical ranges kept", minval=1, maxval=200, group=gVis)

// ===================== RANGE SLOTS (optional) ================================
// Pick WHICH ranges exist on the chart, by the time their candle OPENED. Built
// on the slot study: the session ranking reproduced across seven instruments
// sharing nothing but a clock. Master switch OFF = every range draws, exactly
// as always. ON = only ranges from ticked slots are drawn or traded — a muted
// range draws nothing and arms no setup, so you can never be signalled into a
// range you have chosen not to see.
// The six session boxes apply when the Range timeframe is 4H; the 24 hour boxes
// apply when it is 1H; any other range timeframe shows every range regardless.
// Pre-ticked = the best-measured slots (4H: London PM, NY open, Daily open;
// 1H: 17, 18, 11, 02, 16 SAST — the 06:00-09:00 block tested worst everywhere).
gSlot = "Range slots  (optional)"
slotOn = input.bool(false, "Only show selected range slots", group=gSlot, tooltip="Off (default) = every range draws, original behaviour. On = only ranges whose candle OPENED inside a ticked slot below exist on the chart — the rest draw nothing and produce no setups. 4H range timeframe uses the six session boxes; 1H uses the 24 hour boxes; any other range timeframe is unaffected.")
slotTz = input.string("Africa/Johannesburg", "Slot timezone", options=["Africa/Johannesburg","America/New_York","Europe/London","UTC","Exchange"], group=gSlot, tooltip="The hour boxes below are read in this zone. Africa/Johannesburg = SAST, matching the study.")
ses0 = input.bool(true,  "23/00 Daily open",   inline="q1", group=gSlot)
ses1 = input.bool(false, "03/04 Asia",         inline="q1", group=gSlot)
ses2 = input.bool(false, "07/08 London open",  inline="q2", group=gSlot)
ses3 = input.bool(true,  "11/12 London PM",    inline="q2", group=gSlot)
ses4 = input.bool(true,  "15/16 NY open",      inline="q3", group=gSlot)
ses5 = input.bool(false, "19/20 NY afternoon", inline="q3", group=gSlot)
hr0  = input.bool(false, "00", inline="h1", group=gSlot)
hr1  = input.bool(false, "01", inline="h1", group=gSlot)
hr2  = input.bool(true,  "02", inline="h1", group=gSlot)
hr3  = input.bool(false, "03", inline="h1", group=gSlot)
hr4  = input.bool(false, "04", inline="h1", group=gSlot)
hr5  = input.bool(false, "05", inline="h1", group=gSlot)
hr6  = input.bool(false, "06", inline="h2", group=gSlot)
hr7  = input.bool(false, "07", inline="h2", group=gSlot)
hr8  = input.bool(false, "08", inline="h2", group=gSlot)
hr9  = input.bool(false, "09", inline="h2", group=gSlot)
hr10 = input.bool(false, "10", inline="h2", group=gSlot)
hr11 = input.bool(true,  "11", inline="h2", group=gSlot)
hr12 = input.bool(false, "12", inline="h3", group=gSlot)
hr13 = input.bool(false, "13", inline="h3", group=gSlot)
hr14 = input.bool(false, "14", inline="h3", group=gSlot)
hr15 = input.bool(false, "15", inline="h3", group=gSlot)
hr16 = input.bool(true,  "16", inline="h3", group=gSlot)
hr17 = input.bool(true,  "17", inline="h3", group=gSlot)
hr18 = input.bool(true,  "18", inline="h4", group=gSlot)
hr19 = input.bool(false, "19", inline="h4", group=gSlot)
hr20 = input.bool(false, "20", inline="h4", group=gSlot)
hr21 = input.bool(false, "21", inline="h4", group=gSlot)
hr22 = input.bool(false, "22", inline="h4", group=gSlot)
hr23 = input.bool(false, "23", inline="h4", group=gSlot)

gCol   = "Range box — Colours & Style"
curCol   = input.color(color.new(#2962FF, 0),  "Current range", group=gCol)
prevCol  = input.color(color.new(color.gray, 0),  "Previous range", group=gCol)
histCol  = input.color(color.new(color.gray, 55), "Historical range", group=gCol)
lw       = input.int(2, "Line width", minval=1, maxval=4, group=gCol)
showShade= input.bool(true, "Shade inside the range", group=gCol)
shadeCol = input.color(#2962FF, "Shade colour", group=gCol)
shadeOpacity = input.int(90, "Shade opacity (0 = solid, 100 = invisible)", minval=0, maxval=100, group=gCol, tooltip="Higher = lighter / less vibrant than the range lines. The left side of the range stays open; the shading highlights it.")
shadeDepth = input.float(1.0, "Shade depth (0 = none, 1 = full range)", minval=0, maxval=1, step=0.05, group=gCol)

gLab   = "CRT High / Low labels"
labDesign = input.string("Filled", "Label design", options=["Filled","Ghost","Tinted","Chip"], group=gLab)
showHL    = input.bool(true,  "Show High / Low labels", group=gLab)
shortHL   = input.bool(false, "Short names (CRT H / CRT L)", group=gLab)
showPx    = input.bool(true,  "Show price in labels", group=gLab)
labSz     = input.string("Small", "Label size", options=["Tiny","Small","Normal"], group=gLab)
hlLabCol  = input.color(color.new(#2962FF, 0), "Label colour", group=gLab)
labTxtCol = input.color(color.white, "Text colour (Filled)", group=gLab)

// ===================== SWEEPS (optional, per timeframe) ======================
// A valid sweep = a CLOSED candle wicks beyond the PRIOR candle's high/low but
// CLOSES back inside it (liquidity taken then rejected). Detected independently
// on each enabled timeframe, so a scalper can watch 15m sweeps only, a swing
// trader only D/W, etc. Data loads only for enabled timeframes (memory-safe).
gSwp = "Sweeps  (optional)"
showSweep   = input.bool(false, "Show liquidity sweeps", group=gSwp)
sweepDesign = input.string("Label", "Sweep marker design", options=["Label","Triangle S","Circle S"], group=gSwp, tooltip="Label = pointer tag ('Sweep'). Triangle S / Circle S = minimal shape with an 'S' on the sweeping candle.")
sweepLbl    = input.bool(true,  "Show 'Sweep' text (Label design only)", group=gSwp)
sweepTf     = input.bool(true,  "Title each sweep with its timeframe", group=gSwp, tooltip="On = '4H Sweep', '1H Sweep' etc, so you always know which timeframe produced the marker. Off = plain 'Sweep'.")
sweepAnchor = input.string("Candle close", "Sweep marker position", options=["Candle close","Candle open"], group=gSwp, tooltip="Where on the source candle the marker sits when you are on a lower chart TF. Candle close = the moment the sweep was confirmed (recommended — the marker lands on the price action that made it). Candle open = the far left edge of that candle, which can float an hour or more away from the wick.")
sweepSz     = input.string("Tiny", "Sweep marker size", options=["Tiny","Small","Normal"], group=gSwp)
sweepUpC    = input.color(color.new(color.lime, 0), "Bullish sweep (swept lows)", group=gSwp)
sweepDnC    = input.color(color.new(color.red, 0),  "Bearish sweep (swept highs)", group=gSwp)
swp5On  = input.bool(false, "5m",  inline="sw1", group=gSwp)
swp15On = input.bool(false, "15m", inline="sw1", group=gSwp)
swp30On = input.bool(false, "30m", inline="sw1", group=gSwp)
swp1On  = input.bool(false, "1H",  inline="sw2", group=gSwp)
swp2On  = input.bool(false, "2H",  inline="sw2", group=gSwp)
swp4On  = input.bool(true,  "4H",  inline="sw2", group=gSwp)
swp8On  = input.bool(false, "8H",  inline="sw3", group=gSwp)
swpDOn  = input.bool(false, "D",   inline="sw3", group=gSwp)
swpWOn  = input.bool(false, "W",   inline="sw3", group=gSwp)
swKeep  = input.int(12, "Keep last N sweep markers (all TFs)", minval=1, maxval=100, group=gSwp)

// ===================== BREAKS (optional, per timeframe) ======================
// Same two candles as a sweep, opposite outcome. A CLOSED candle takes out the
// PRIOR candle's high/low and finishes BEYOND it — the level was broken, not
// rejected. So wherever a sweep was "supposed" to happen but the candle never
// came back inside, you get a "Break" tag instead. Mirrors the sweep layer
// exactly: master switch, per-timeframe switches, own design, size and colours.
//
// EACH LEVEL IS JUDGED ON ITS OWN. A marker marks a LEVEL, not a candle: a
// candle that wicks below the prior low and expands through the prior high is
// TWO events — a sweep of the low and a break of the high — and gets both tags,
// exactly like a double sweep gets one tag on each side. Classification runs
// before display, so which layers you have switched on never changes what a
// candle IS.
gBrk = "Breaks  (optional)"
showBreak   = input.bool(false, "Show breaks (closed BEYOND the level)", group=gBrk, tooltip="Master switch for the whole break layer. A break = the candle took the prior high/low and finished past it instead of reclaiming.")
brkStrict   = input.bool(false, "Break needs the FULL body outside", group=gBrk, tooltip="OFF (measured default): the close finishing beyond the level is enough. ON: the whole body — open AND close — must sit clear of the level; a body still straddling it gets no tag at all. Measured on 16 years of gold 4H, strict mode left about 38% of level-taking candles with no tag, which is why loose is the default.")
breakDesign = input.string("Label", "Break marker design", options=["Label","Triangle B","Circle B"], group=gBrk, tooltip="Label = pointer tag ('Break'). Triangle B / Circle B = minimal shape with a 'B' on the breaking candle.")
breakLbl    = input.bool(true,  "Show 'Break' text (Label design only)", group=gBrk)
breakTf     = input.bool(true,  "Title each break with its timeframe", group=gBrk, tooltip="On = '4H Break', '1H Break' etc.")
breakAnchor = input.string("Candle close", "Break marker position", options=["Candle close","Candle open"], group=gBrk, tooltip="Where on the source candle the marker sits when you are on a lower chart TF. Candle close = the moment the break was confirmed. Candle open = the far left edge of that candle.")
breakSz     = input.string("Tiny", "Break marker size", options=["Tiny","Small","Normal"], group=gBrk)
breakUpC    = input.color(color.new(color.aqua, 0),   "Bullish break (closed above the high)", group=gBrk)
breakDnC    = input.color(color.new(color.orange, 0), "Bearish break (closed below the low)", group=gBrk)
brk5On  = input.bool(false, "5m",  inline="br1", group=gBrk)
brk15On = input.bool(false, "15m", inline="br1", group=gBrk)
brk30On = input.bool(false, "30m", inline="br1", group=gBrk)
brk1On  = input.bool(false, "1H",  inline="br2", group=gBrk)
brk2On  = input.bool(false, "2H",  inline="br2", group=gBrk)
brk4On  = input.bool(true,  "4H",  inline="br2", group=gBrk)
brk8On  = input.bool(false, "8H",  inline="br3", group=gBrk)
brkDOn  = input.bool(false, "D",   inline="br3", group=gBrk)
brkWOn  = input.bool(false, "W",   inline="br3", group=gBrk)
brKeep  = input.int(12, "Keep last N break markers (all TFs)", minval=1, maxval=100, group=gBrk)

// ===================== CRT SETUPS (optional) =================================
// LIVE CRT entry: when the range candle closes, we watch chart-TF price sweep the
// range and reclaim back inside, then enter on that reclaim bar (not at the HTF
// close). SL beyond the sweep, TP the opposite range extreme. Best on a chart TF
// below the range TF. Marks the setup only — NOT financial advice; validate it.
gSet = "CRT setups  (optional)"
showSetup  = input.bool(false, "Show CRT setups (entry / SL / TP / RR)", group=gSet)
setup2c    = input.bool(true,  "2-candle setups (range → sweep → reclaim)", group=gSet, tooltip="LIVE entry: once the range candle closes, the next candle's price sweeps the range high/low and impulsively reclaims back inside → enter on the reclaim BAR (not at the HTF close). Use a chart TF below the range TF (e.g. 5m chart, 4H range) for precision. Target the opposite extreme; SL beyond the sweep.")
setup3c    = input.bool(false, "3-candle setups (allow reclaim one candle later)", group=gSet, tooltip="Same live logic but the sweep+reclaim may complete up to two candles after the range instead of one.")
setupConf  = input.string("Chart bar close (original)", "Setup confirms on", options=["Chart bar close (original)","Range candle close (research)"], group=gSet, tooltip="What counts as the full bar closing back inside the range. Chart bar close = the first CHART-timeframe bar that closes back inside fires the setup — the original behaviour, earliest in, tightest stop. Range candle close = the RANGE-timeframe candle itself must close back inside; it fires later but measured about +0.07 R per trade better across seven instruments, because the earlier entry's tighter stop makes a fixed spread a much bigger share of the risk.")
setupMinRng= input.float(0.0, "Skip ranges smaller than (× ATR of range TF)", minval=0, step=0.1, group=gSet, tooltip="0 = take every range (default). Bigger ranges tested better than smaller ones on every instrument, monotonically — the smallest ranges were the worst bucket everywhere. Try 1.0 to drop them. The range still draws exactly as always; it just arms no setup.")
setupMinRR = input.float(0.0, "Only show setups with RR ≥", minval=0, step=0.1, group=gSet, tooltip="0 = off (measured default). Filtering for RR ≥ 1.5 tested WORSE on all seven instruments — it keeps the setups whose sweeps barely ran and throws away the survivable stops; on gold it roughly doubled the loss per trade. Raise it only if you have your own reason to.")
setupLongC = input.color(color.new(color.teal, 0),   "Long setup", group=gSet)
setupShortC= input.color(color.new(color.maroon, 0), "Short setup", group=gSet)
setupTpC   = input.color(color.new(color.green, 0),  "Take-profit line", group=gSet)
setupSlC   = input.color(color.new(color.red, 0),    "Stop-loss line", group=gSet)
setupLineW = input.int(2, "TP / SL line width", minval=1, maxval=4, group=gSet, tooltip="Raise for bolder, more visible TP / SL dotted lines.")
setKeep    = input.int(6, "Keep last N setups", minval=1, maxval=50, group=gSet)

// ---- SETUP QUALITY (noise filter) -------------------------------------------
// From the noise study (NOISE_STUDY.md): the worst setups are hesitant reclaims
// that barely close back inside the level, and setups from shrunken ranges.
// Filtering both — plus the session cut the slot picker already provides — kept
// 15% of setups and moved the survivors from -0.067 R to +0.036 R net across
// seven instruments (positive on six of seven).
gQual = "Setup quality  (noise filter)"
qualRec   = input.bool(true, "Confirming close must land inside the reclaim band", group=gQual, tooltip="The single biggest noise cut, and it improved ALL seven instruments tested. Measures where the confirming close lands, as a share of the range back in from the swept level. Closes that barely scrape back inside (under ~25%) are hesitant, no-displacement reclaims — the worst bucket in the data at -0.145 R per trade — and closes past ~75% are chasing a move that has already happened. A bar closing outside the band does NOT kill the setup: a later bar closing inside the band can still fire it.")
qualRecLo = input.float(25, "Reclaim band from (% back inside)", minval=0, maxval=100, step=5, group=gQual)
qualRecHi = input.float(75, "Reclaim band to (% back inside)", minval=0, maxval=100, step=5, group=gQual)
qualSize  = input.bool(true, "Skip ranges smaller than the median of the last 20", group=gQual, tooltip="The smallest ranges were the worst-testing quintile on every instrument. The floor is RELATIVE — the median height of the previous 20 ranges — so it self-calibrates to the instrument and the volatility regime instead of guessing a fixed number. Improved six of seven instruments. The range itself still draws; it just arms no setup.")

// ---- STOP LOSS --------------------------------------------------------------
// How the stop is built, in three independent stages:
//
//   1. ANCHOR   — the price the stop sits beyond. "Swept extreme" is the furthest
//                 price traded past the range since the range candle closed (the
//                 actual sweep wick). "Range boundary" is the CRT high/low itself,
//                 which is TIGHTER — it ignores how far the wick ran.
//   2. PAD      — how far past the anchor, in units you choose. The original
//                 behaviour was 0.1 x ATR of the range TF, which on a 4H gold
//                 range is only a point or two — thin enough that an ordinary
//                 retest of the swept level takes the stop out.
//   3. MINIMUM  — an absolute floor measured from ENTRY, as a share of the range
//                 height. This is the one that fixes "stopped out then it ran":
//                 when the reclaim closes right next to the swept wick the
//                 entry-to-stop distance collapses to almost nothing, and no pad
//                 measured from the wick can rescue it. The floor is measured
//                 from where you actually got in.
//
// WIDER STOPS COST RR. The target is fixed at the opposite range extreme, so
// every point added to the stop lowers the natural R:R and some setups will stop
// passing "Only show setups with RR >=". That is a real trade-off, not a bug.
gSL = "Stop loss"
slRef     = input.string("Half the range past the level (research)", "Stop anchored to", options=["Half the range past the level (research)","Swept extreme","Range boundary"], group=gSL, tooltip="Half the range past the level (default) = the stop sits 50% of the range height beyond the swept high/low, and never tighter than the actual sweep wick. The widest of the three — and the only one that tested best on ALL seven instruments: wick-anchored stops lost roughly twice as much per trade, because a tight stop turns a fixed spread into a huge fraction of R. Swept extreme = just beyond the sweep wick (classic CRT). Range boundary = just beyond the CRT high/low itself — the tightest, and the first to be wicked out.")
slPadMode = input.string("ATR of range TF", "Stop pad units", options=["ATR of range TF","ATR of chart TF","% of range height","% of price","Points"], group=gSL, tooltip="What the pad amount below is measured in. '% of range height' scales itself to every instrument and timeframe automatically, which is usually the easiest to reason about.")
slPadVal  = input.float(0.1, "Stop pad amount", minval=0, step=0.05, group=gSL, tooltip="0.1 with 'ATR of range TF' reproduces the original behaviour. With '% of range height' try 10-15. With 'Points' this is in the 'Price per point' unit set in the Equilibrium group.")
slMinOn   = input.bool(false, "Enforce a minimum stop distance", group=gSL, tooltip="Turn this on first if you are being stopped out by noise. It guarantees a floor on entry-to-stop distance regardless of how close the reclaim closed to the swept wick.")
slMinPct  = input.float(20, "Minimum stop (% of range height)", minval=0, maxval=200, step=1, group=gSL, tooltip="Measured from ENTRY, not from the wick. 20 means the stop is never closer than a fifth of the CRT range height. Raise it until the noise stops taking you out; watch the setup count fall as RR drops.")
slBuffTk  = input.float(0, "Extra buffer (ticks)", minval=0, step=1, group=gSL, tooltip="Flat spread allowance added on top of everything else. Useful on wide-spread instruments where the stop sits exactly on a level everyone can see.")

// ---- TIME-OF-DAY FILTER -----------------------------------------------------
// Two independent windows, both entered in whatever timezone you pick (default
// South African time, SAST = UTC+2), both individually switchable:
//   BLOCK  — setups whose reclaim bar falls inside this window are suppressed.
//   ALLOW  — when on, ONLY setups inside this window are shown.
// Leaving both off = every setup shows, exactly as before. Turning both on is
// legal: the block window wins on any overlap.
// The watch itself is NOT consumed, so a range that sweeps inside a blocked
// window can still fire later when price reclaims inside an allowed one.
gTime = "Setup time filter"
tfltOn  = input.bool(false, "Enable setup time filter", group=gTime, tooltip="Master switch. Off = setups show at all hours (original behaviour).")
tfltRef = input.string("Range formation (research)", "Windows apply to", options=["Range formation (research)","Entry bar"], group=gTime, tooltip="Range formation = the windows test WHEN THE RANGE CANDLE OPENED. The session that built the range is what carried the measurable edge, and the same session ranking reproduced across two independent studies. Entry bar = the windows test the bar the setup fires on (the original behaviour).")
tfltTz  = input.string("Africa/Johannesburg", "Timezone for the windows below", options=["Africa/Johannesburg","America/New_York","Europe/London","Asia/Tokyo","UTC","Exchange"], group=gTime, tooltip="Times are read in this zone. Africa/Johannesburg = SAST (UTC+2), so you type the hours exactly as you see them locally.")
blkOn   = input.bool(true,  "Block setups in this window", group=gTime, tooltip="Suppresses setups from this window. Measured worst 4H sessions across seven instruments, in order: NY afternoon (19:00 SAST) and Asia (03:00 SAST) — both negative on 7 of 7.")
blkSess = input.session("1900-0000", "Blocked window", group=gTime, tooltip="Default 1900-0000 = 7pm to midnight SAST, the NY-afternoon dead zone — the worst measured bucket.")
alwOn   = input.bool(false, "Only show setups in this window", group=gTime, tooltip="When on, everything OUTSIDE this window is hidden.")
alwSess = input.session("1100-1700", "Allowed window", group=gTime, tooltip="Default 1100-1700 SAST = London PM into the NY open — the two sessions that measured best across all seven instruments, and the most reproducible ranking found in the whole study. (The old default, 0300-0700 Asia, measured among the worst.)")
tfltDays= input.string("1234567", "Days the windows apply to", group=gTime, tooltip="1=Sunday … 7=Saturday. Leave as 1234567 for every day.")
tfltShade = input.bool(false, "Shade the blocked hours on the chart", group=gTime)
tfltShadeC= input.color(color.new(color.red, 92), "Blocked-hours shade", group=gTime)

// ---- BREAK-EVEN -------------------------------------------------------------
// The range EQ (50% of the CRT range) is the trigger. When price reaches it the
// stop is moved to just past entry, locking in a small profit instead of a true
// scratch. Marked with the same short dotted line + tiny label as TP / SL.
gBE = "Break-even"
beOn   = input.bool(true, "Break-even at range EQ", group=gBE, tooltip="Draws a line at the range equilibrium. When price reaches it, the stop moves to just past entry and a second stop line appears; the original SL fades out. Trade it as TP1: banking HALF there and running the rest tested better than holding full size on all seven instruments, and it is what turns most setups green — about 63% of setups ended positive under that management in testing.")
beTxt  = input.string("TP1", "EQ line label", options=["TP1","BE","Break-even"], group=gBE, tooltip="TP1 = treat the EQ as the first target: bank half, stop to just past entry, rest runs to the far extreme.")
bePct  = input.float(10, "BE stop offset (% of original risk)", minval=0, maxval=90, step=1, group=gBE, tooltip="How far past ENTRY the moved stop sits, as a share of the original entry-to-SL distance. Longs go above entry, shorts below. 10% locks in a small win rather than a pure scratch, and scales automatically across instruments.")
beCol  = input.color(color.new(#FF9800, 0), "Break-even colour", group=gBE)
beFade = input.int(70, "Faded original SL transparency", minval=0, maxval=95, group=gBE, tooltip="Once BE arms, the original stop line dims to this transparency so you can still see where it started.")

// ===================== EQUILIBRIUM (all ranges) ==============================
gEQ = "Equilibrium (all ranges)"
showEqLn  = input.bool(true, "Show equilibrium line", group=gEQ)
eqLnCol   = input.color(color.new(#FF6D00, 0), "EQ line colour", group=gEQ)
eqLnWidth = input.int(2, "EQ line width", minval=1, maxval=4, group=gEQ)
eqLnStyle = input.string("Dotted", "EQ line style", options=["Dotted","Dashed","Solid"], group=gEQ)
showFvgEq = input.bool(true, "Add 50% EQ line to FVG / OB boxes", group=gEQ)
showEqLab = input.bool(true, "Show EQ label", group=gEQ)
eqLabSz   = input.string("Tiny", "EQ label size", options=["Tiny","Small","Normal"], group=gEQ)
eqLabCol  = input.color(color.new(color.black, 0), "EQ label colour", group=gEQ)
showEqPx  = input.bool(false, "Include EQ price in label", group=gEQ)
showSize  = input.bool(true,  "Show range size (PTS) in label", group=gEQ)
pointSize = input.float(0.0, "Price per point (0 = auto min-tick)", minval=0, step=0.001, group=gEQ)
brUnit    = input.string("Pips", "Bracket unit", options=["Pips","Ticks","Price","None"], group=gEQ)
pipSize   = input.float(0.0, "Price per pip (0 = auto)", minval=0, step=0.0001, group=gEQ)

// ===================== DAILY / WEEKLY CRT (optional) =========================
gDW = "HTF Bias — Daily / Weekly CRT  (optional)"
showDR   = input.bool(false, "Show Daily CRT range", group=gDW)
showWR   = input.bool(false, "Show Weekly CRT range", group=gDW)
nyAnchor = input.bool(false, "Anchor D/W to New York 17:00", group=gDW, tooltip="OFF = broker native daily/weekly. ON = 17:00 NY session, feed-independent.")
showPD   = input.bool(true,  "Premium / discount shading", group=gDW)
htfProj  = input.int(1, "Project ranges N periods right", minval=1, maxval=5, group=gDW)
showHtfLbl = input.bool(true, "Label D / W ranges", group=gDW)
showHtfPx  = input.bool(false, "Include price in D / W labels", group=gDW, tooltip="Off = just 'D High' / 'W Low'. On = adds the price.")
dwLabSz  = input.string("Small", "D / W label size", options=["Tiny","Small","Normal"], group=gDW)
dCol     = input.color(color.new(#787B86, 0), "Daily line", group=gDW)
wCol     = input.color(color.new(#5D606B, 0), "Weekly line", group=gDW)
premC    = input.color(color.new(color.red, 0), "Premium tint", group=gDW)
discC    = input.color(color.new(color.green, 0), "Discount tint", group=gDW)

